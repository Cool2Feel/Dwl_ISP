<Window x:Class="SensorAdjust.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SensorAdjust"
        Title="SensorAdjust - USB Device Register Tool"
        Width="580"
        Height="640"
        MinWidth="520"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- ===== Colors ===== -->
        <SolidColorBrush x:Key="StatusGray" Color="#9E9E9E"/>
        <SolidColorBrush x:Key="StatusGreen" Color="#2E7D32"/>
        <SolidColorBrush x:Key="StatusRed" Color="#C62828"/>
        <SolidColorBrush x:Key="StatusAmber" Color="#F57F17"/>
        <SolidColorBrush x:Key="StatusWarning" Color="#E65100"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#1565C0"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#E3F2FD"/>
        <SolidColorBrush x:Key="ErrorColor" Color="#EF5350"/>
        <SolidColorBrush x:Key="SuccessColor" Color="#66BB6A"/>
        <SolidColorBrush x:Key="BorderColor" Color="#BDBDBD"/>
        <SolidColorBrush x:Key="BgLight" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#212121"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#757575"/>

        <!-- ===== Styles ===== -->

        <Style x:Key="GroupBoxStyle" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="{StaticResource BgLight}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="HexTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="CharacterCasing" Value="Upper"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryColor}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                Height="{TemplateBinding Height}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryLight}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#BBDEFB"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1976D2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimaryLight}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryColor}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsFocused" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="#E8EAF6"/>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Context menu style -->
        <Style x:Key="ContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <!-- Read: Enter key -->
        <KeyBinding Key="Return" Command="{x:Static local:MainWindow.ReadCommand}"/>
        <!-- Write: Ctrl+Enter -->
        <KeyBinding Key="Return" Modifiers="Control" Command="{x:Static local:MainWindow.WriteCommand}"/>
        <!-- Add: Ctrl+N -->
        <KeyBinding Key="N" Modifiers="Control" Command="{x:Static local:MainWindow.AddCommand}"/>
        <!-- Save: Ctrl+S -->
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static local:MainWindow.SaveCommand}"/>
        <!-- Delete: Delete -->
        <KeyBinding Key="Delete" Command="{x:Static local:MainWindow.DeleteCommand}"/>
        <!-- Update: Ctrl+U -->
        <KeyBinding Key="U" Modifiers="Control" Command="{x:Static local:MainWindow.UpdateCommand}"/>
        <!-- Connect: F5 -->
        <KeyBinding Key="F5" Command="{x:Static local:MainWindow.ConnectCommand}"/>
    </Window.InputBindings>

    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- 1. Connection Section -->
        <!-- ============================================================ -->
        <GroupBox Grid.Row="0" Header="DEVICE CONNECTION" Style="{StaticResource GroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Animated status dot -->
                    <Ellipse x:Name="StatusDot" Width="14" Height="14"
                             Fill="{StaticResource StatusGray}"
                             VerticalAlignment="Center" Margin="0,0,10,0"
                             ToolTip="Device connection status indicator"/>
                    <TextBlock x:Name="StatusDisplay" Text="No device connected"
                               FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="ConnectButton"
                        Style="{StaticResource PrimaryButton}"
                        Click="ConnectButton_Click"
                        ToolTip="Scan for Buildwin/AX3231MP USB device (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x1F50C; " FontSize="13" Margin="0,0,4,0"/>
                        <TextBlock Text="Connect"/>
                    </StackPanel>
                </Button>
            </Grid>
        </GroupBox>

        <!-- ============================================================ -->
        <!-- 2. Scan Progress & Device Info -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Scan Progress Bar (hidden by default) -->
            <ProgressBar Grid.Row="0" x:Name="ScanProgressBar"
                         Height="4" Minimum="0" Maximum="100"
                         Foreground="{StaticResource PrimaryColor}"
                         Background="{StaticResource BorderColor}"
                         BorderThickness="0"
                         IsIndeterminate="False"
                         Visibility="Collapsed"/>

            <!-- Device Info Panel (hidden by default) -->
            <Border Grid.Row="1" x:Name="DeviceInfoPanel"
                    Background="{StaticResource PrimaryLight}"
                    BorderBrush="{StaticResource PrimaryColor}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8,4"
                    Margin="0,4,0,0"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="DeviceInfoText"
                               FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource PrimaryColor}"
                               VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="HealthIndicator"
                               Visibility="Collapsed" FontSize="11"
                               VerticalAlignment="Center">
                        <Run Foreground="{StaticResource TextSecondary}">Status: </Run>
                        <Ellipse x:Name="HealthIndicatorColor" Width="8" Height="8"
                                 Fill="{StaticResource StatusGreen}"
                                 VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <Run x:Name="HealthIndicatorText" Text="OK"
                             Foreground="{StaticResource TextSecondary}"/>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- 3. Register Address/Value Section -->
        <!-- ============================================================ -->
        <GroupBox Grid.Row="2" Header="REGISTER ADDRESS / VALUE" Style="{StaticResource GroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Input fields -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Address -->
                    <Border Grid.Column="0" x:Name="AddrBorder"
                            BorderThickness="0" CornerRadius="4" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="addr: 0x"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <TextBox Grid.Column="1" x:Name="AddrTextBox"
                                     Style="{StaticResource HexTextBox}"
                                     MaxLength="4"
                                     TextChanged="AddrTextBox_TextChanged"
                                     ToolTip="Enter register address in hex (e.g. 00 or 00FF)"/>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Column="2" Text="   "
                               VerticalAlignment="Center"/>

                    <!-- Value -->
                    <Border Grid.Column="3" x:Name="ValueBorder"
                            BorderThickness="0" CornerRadius="4" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="value: 0x"
                                       FontSize="15" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" Margin="0,0,2,0"/>
                            <TextBox Grid.Column="1" x:Name="ValueTextBox"
                                     Style="{StaticResource HexTextBox}"
                                     MaxLength="4"
                                     TextChanged="ValueTextBox_TextChanged"
                                     ToolTip="Enter register value in hex (e.g. 00 or 00FF)"/>
                        </Grid>
                    </Border>

                    <!-- Clear button -->
                    <Button Grid.Column="6" x:Name="ClearInputButton"
                            Style="{StaticResource ActionButton}"
                            Click="ClearInputButton_Click"
                            Width="70" Height="26" FontSize="11"
                            ToolTip="Clear address and value fields">
                        <TextBlock Text="Clear" Foreground="{StaticResource TextSecondary}"/>
                    </Button>
                </Grid>

                <!-- Row 1: Bit-width options -->
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" x:Name="Addr16BitCheckBox"
                              Content="16-bit Address"
                              FontSize="12" Foreground="{StaticResource TextSecondary}"
                              Margin="0,0,24,0"
                              Checked="Addr16BitCheckBox_Changed"
                              Unchecked="Addr16BitCheckBox_Changed"
                              ToolTip="Toggle address width between 8-bit (00-FF) and 16-bit (0000-FFFF)"/>
                    <CheckBox Grid.Column="1" x:Name="Value16BitCheckBox"
                              Content="16-bit Value"
                              FontSize="12" Foreground="{StaticResource TextSecondary}"
                              Checked="Value16BitCheckBox_Changed"
                              Unchecked="Value16BitCheckBox_Changed"
                              ToolTip="Toggle value width between 8-bit (00-FF) and 16-bit (0000-FFFF)"/>

                    <TextBlock Grid.Column="2" Text="(Enter to Read, Ctrl+Enter to Write, Ctrl+U to Update)"
                               FontSize="11" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Margin="0,0,4,0"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- ============================================================ -->
        <!-- 4. Read / Write Action Buttons -->
        <!-- ============================================================ -->
        <GroupBox Grid.Row="3" Header="OPERATIONS" Style="{StaticResource GroupBoxStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" x:Name="ReadButton"
                        Style="{StaticResource PrimaryButton}"
                        Click="ReadButton_Click" Width="100"
                        ToolTip="Read register value from selected address (Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25C0; " FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="Read"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" x:Name="WriteButton"
                        Style="{StaticResource ActionButton}"
                        Click="WriteButton_Click" Width="100" Margin="8,0,0,0"
                        ToolTip="Write value to selected register (Ctrl+Enter)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x25B6; " FontSize="13" Margin="0,0,6,0"/>
                        <TextBlock Text="Write"/>
                    </StackPanel>
                </Button>
            </Grid>
        </GroupBox>

        <!-- ============================================================ -->
        <!-- 5. Register List -->
        <!-- ============================================================ -->
        <GroupBox Grid.Row="4" Header="REGISTER LIST" Style="{StaticResource GroupBoxStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Name="ItemCountText"
                               Text="0 items"
                               FontSize="11" Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="AddButton"
                                Style="{StaticResource ActionButton}"
                                Click="AddButton_Click"
                                Height="24" FontSize="11" Padding="10,0"
                                ToolTip="Add current address/value to list (Ctrl+N)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="+ " FontSize="13" FontWeight="Bold"/>
                                <TextBlock Text="Add" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="UpdateButton"
                                Style="{StaticResource ActionButton}"
                                Click="UpdateButton_Click"
                                Height="24" FontSize="11" Padding="10,0"
                                Margin="4,0,0,0"
                                ToolTip="Update selected item with current address/value (Ctrl+U)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x21BB; " FontSize="11"/>
                                <TextBlock Text="Update" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteSelectedButton"
                                Style="{StaticResource ActionButton}"
                                Click="DeleteSelectedButton_Click"
                                Height="24" FontSize="11" Padding="10,0"
                                Margin="4,0,0,0"
                                ToolTip="Delete selected items from list (Delete)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2716; " FontSize="11"/>
                                <TextBlock Text="Delete" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearAllButton"
                                Style="{StaticResource ActionButton}"
                                Click="ClearAllButton_Click"
                                Height="24" FontSize="11" Padding="10,0"
                                Margin="4,0,0,0"
                                ToolTip="Clear all items from list">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x2718; " FontSize="11"/>
                                <TextBlock Text="Clear All" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ListBox with context menu -->
                <ListBox  Grid.Row="1" x:Name="RegisterListBox"
                         ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                         SelectionMode="Extended"
                         SelectionChanged="RegisterListBox_SelectionChanged"
                         MouseDoubleClick="RegisterListBox_MouseDoubleClick"
                         BorderBrush="{StaticResource BorderColor}"
                         BorderThickness="1"
                         Background="White"
                         MaxHeight="238"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" Margin="4,2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ContextMenu>
                        <ContextMenu Style="{StaticResource ContextMenuStyle}">
                            <MenuItem Header="Read Selected" Click="ContextMenu_ReadSelected">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#x25C0;" FontSize="11" Margin="4,0,6,0"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Write Selected" Click="ContextMenu_WriteSelected">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#x25B6;" FontSize="11" Margin="4,0,6,0"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Update Selected" Click="ContextMenu_UpdateSelected">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#x21BB;" FontSize="11" Margin="4,0,6,0"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Delete Selected" Click="ContextMenu_DeleteSelected">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#x2716;" FontSize="11" Margin="4,0,6,0"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Clear All" Click="ContextMenu_ClearAll">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#x2718;" FontSize="11" Margin="4,0,6,0"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Save to File..." Click="ContextMenu_Save">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#x1F4BE;" FontSize="11" Margin="4,0,6,0"/>
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Load from File..." Click="ContextMenu_Load">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#x1F4C2;" FontSize="11" Margin="4,0,6,0"/>
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </Grid>
        </GroupBox>

        <!-- ============================================================ -->
        <!-- 6. Status Bar -->
        <!-- ============================================================ -->
        <Border Grid.Row="6" BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,1,0,0" Background="#F0F0F0"
                Padding="8,4" Margin="0,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="StatusBarText"
                           Text="Ready" Width="320" TextWrapping="Wrap"
                           FontSize="11" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,5,0">
                    <Button x:Name="SaveButton"
                            Style="{StaticResource ActionButton}"
                            Click="SaveButton_Click"
                            Height="22" FontSize="11" Padding="8,0"
                            ToolTip="Save list to file (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4BE; " FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="Save"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="LoadButton"
                            Style="{StaticResource ActionButton}"
                            Click="LoadButton_Click"
                            Height="22" FontSize="11" Padding="8,0" Margin="4,0,0,0"
                            ToolTip="Load list from file">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4C2; " FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="Load"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Column="3" x:Name="AboutButton"
                        Style="{StaticResource ActionButton}"
                        Click="AboutButton_Click"
                        Height="22" FontSize="11" Padding="8,0"
                        ToolTip="About SensorAdjust">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x24D8; " FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock Text="About"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>