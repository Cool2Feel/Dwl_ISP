<Window x:Class="SensorAdjust.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About SensorAdjust"
        Width="300"
        Height="180"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="AboutText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#424242"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#B0B0B0" BorderThickness="1" Margin="8" CornerRadius="4" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="SensorAdjust" FontSize="18" FontWeight="Bold"
                       Foreground="#212121" HorizontalAlignment="Center" Margin="0,4,0,8"/>

            <TextBlock Grid.Row="1" Style="{StaticResource AboutText}"
                       Text="Version 1.0.0.0"/>

            <TextBlock Grid.Row="2" Style="{StaticResource AboutText}"
                       Text="USB Device Register Read/Write Tool"
                       Margin="0,4,0,0"/>

            <TextBlock Grid.Row="3" Style="{StaticResource AboutText}"
                       Text="Copyright (C) 2026"
                       Margin="0,4,0,0"/>

            <Button Grid.Row="5" x:Name="CloseButton"
                    Content="Close"
                    Width="70" Height="24"
                    HorizontalAlignment="Center"
                    IsDefault="True"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>