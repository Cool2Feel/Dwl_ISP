<Window x:Class="TimeUpdater.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Time Updater"
        Width="300"
        Height="180"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="Resources/timeUpdater.ico">
    <Window.Resources>
        <Style x:Key="AboutText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#424242"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#B0B0B0" BorderThickness="1" Margin="8" CornerRadius="4" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- App Icon and Name -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" 
                        HorizontalAlignment="Center" Margin="0,4,0,8">
                <Image Source="Resources/timeUpdater.ico" Width="32" Height="32" Margin="0,0,8,0"/>
                <TextBlock Text="Time Updater" FontSize="18" FontWeight="Bold" 
                           Foreground="#212121" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Version -->
            <TextBlock Grid.Row="1" Style="{StaticResource AboutText}" 
                       Text="Version 1.0.0.1"/>

            <!-- Description -->
            <TextBlock Grid.Row="2" Style="{StaticResource AboutText}" 
                       Text="USB Device Time Synchronization Tool" 
                       Margin="0,4,0,0"/>

            <!-- Copyright -->
            <TextBlock Grid.Row="3" Style="{StaticResource AboutText}" 
                       Text="Copyright (C) 2012-2025" 
                       Margin="0,4,0,0"/>

            <!-- Close Button -->
            <Button Grid.Row="5" x:Name="CloseButton" 
                    Content="Close" 
                    Width="70" Height="24"
                    HorizontalAlignment="Center"
                    IsDefault="True"
                    Click="CloseButton_Click"/>
        </Grid>
    </Border>
</Window>