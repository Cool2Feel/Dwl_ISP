<Window x:Class="TimeUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time Updater"
        Width="380"
        Height="270"
        MinWidth="380"
        MinHeight="270"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Icon="Resources/timeUpdater.ico">
    <Window.Resources>
        <!-- Status color brushes -->
        <SolidColorBrush x:Key="StatusGray" Color="#808080"/>
        <SolidColorBrush x:Key="StatusGreen" Color="#2E7D32"/>
        <SolidColorBrush x:Key="StatusRed" Color="#C62828"/>
        <SolidColorBrush x:Key="StatusAmber" Color="#F57F17"/>

        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#B0B0B0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#303030" BorderThickness="1" Margin="6">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <!-- Time display -->
                <RowDefinition Height="Auto"/>
                <!-- Spacer -->
                <RowDefinition Height="6"/>
                <!-- Status display -->
                <RowDefinition Height="Auto"/>
                <!-- Progress bar -->
                <RowDefinition Height="Auto"/>
                <!-- Spacer -->
                <RowDefinition Height="8"/>
                <!-- Button row -->
                <RowDefinition Height="Auto"/>
                <!-- Spacer -->
                <RowDefinition Height="6"/>
                <!-- Last scan time -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Time Display ===== -->
            <Border Grid.Row="0" Style="{StaticResource SectionBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="SYSTEM TIME" 
                               FontSize="9" FontWeight="Bold" 
                               Foreground="#707070"
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Row="1" x:Name="TimeDisplay"
                               Text="0000-00-00 00:00:00"
                               FontFamily="Consolas"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#212121"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               ToolTip="Current system local time"/>
                </Grid>
            </Border>

            <!-- ===== Status Display ===== -->
            <Border Grid.Row="2" Style="{StaticResource SectionBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status indicator dot -->
                    <Ellipse Grid.Column="0" x:Name="StatusDot"
                             Width="12" Height="12"
                             Fill="{StaticResource StatusGray}"
                             VerticalAlignment="Center"
                             Margin="0,0,8,0"
                             ToolTip="Device status indicator"/>

                    <!-- Status text -->
                    <TextBlock Grid.Column="1" x:Name="StatusDisplay"
                               Text="No device online..."
                               FontFamily="Consolas"
                               FontSize="14"
                               Foreground="#424242"
                               VerticalAlignment="Center"
                               ToolTip="Current device connection status"/>
                </Grid>
            </Border>

            <!-- ===== Progress Bar ===== -->
            <ProgressBar Grid.Row="3" x:Name="ScanProgressBar"
                         Height="4"
                         Margin="0,6,0,0"
                         IsIndeterminate="True"
                         Visibility="Collapsed"
                         Foreground="#1976D2"
                         ToolTip="Scanning for devices..."/>

            <!-- ===== Button Row ===== -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" 
                        HorizontalAlignment="Center">
                <Button x:Name="ScanButton" Style="{StaticResource ActionButton}"
                        Click="ScanButton_Click"
                        ToolTip="Manually scan for devices and update time">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x21BB; " FontSize="14"/>
                        <TextBlock Text="Scan Now"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AboutButton" Style="{StaticResource ActionButton}"
                        Click="AboutButton_Click"
                        ToolTip="About Time Updater">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x24D8; " FontSize="14"/>
                        <TextBlock Text="About"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ExitButton" Style="{StaticResource ActionButton}"
                        Click="ExitButton_Click"
                        ToolTip="Exit the application">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x2716; " FontSize="14"/>
                        <TextBlock Text="Exit"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- ===== Last Scan Time ===== -->
            <TextBlock Grid.Row="7" x:Name="LastScanDisplay"
                       Text="Last scan: --:--:--"
                       FontSize="11"
                       Foreground="#9E9E9E"
                       HorizontalAlignment="Center"
                       ToolTip="Timestamp of the last device scan"/>
        </Grid>
    </Border>
</Window>