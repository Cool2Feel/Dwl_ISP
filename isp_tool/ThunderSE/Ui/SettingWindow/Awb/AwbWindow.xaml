<Window x:Class="ThunderSE.Ui.SettingWindow.Awb.AwbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chartingToolkit="clr-namespace:System.Windows.Controls.DataVisualization.Charting;assembly=System.Windows.Controls.DataVisualization.Toolkit"
        xmlns:datavis="clr-namespace:System.Windows.Controls.DataVisualization;assembly=System.Windows.Controls.DataVisualization.Toolkit"
        xmlns:Awb="clr-namespace:ThunderSE.Ui.SettingWindow.Awb"
        xmlns:cc="clr-namespace:ThunderSE.Ui.SettingWindow.Awb.CustomControls"
        Title="AWB白平衡调试工具" Width="1100" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F5F5" ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Awb:GainDataBindingConverter x:Key="gainDataBindingConverter"></Awb:GainDataBindingConverter>
    </Window.Resources>
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <!-- 第1行：顶部 - 图表预览区域 + 参数控制面板 -->
            <RowDefinition Height="2*"/>
            <!-- 第2行：中部 - 操作工具栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 第3行：下部 - 数据表格/状态信息 -->
            <RowDefinition Height="Auto"/>
            <!-- 第4行：底部 - 状态栏 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 第0行：模式切换栏 (新增 - 独立封装) ==================== -->
        <Border Grid.Row="0" BorderBrush="#FF0078D7" BorderThickness="1,0,0,0" 
                Background="#FFF8F9FA" Padding="8,6" Margin="0,0,0,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：模式切换控件 -->
                <!--<Awb:ModeSwitchControl x:Name="ModeSwitcher"
                                       Grid.Column="0"
                                       ModeChanged="ModeSwitcher_ModeChanged"/>-->

                <!-- 右侧：当前模式状态指示器 -->
                <Border Grid.Column="2" Background="{Binding CurrentModeBackgroundColor}" 
                        CornerRadius="4" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TxtCurrentModeIcon" Text="📊" FontSize="12"/>
                        <TextBlock x:Name="TxtCurrentModeName" 
                                   Text="传统编辑模式" 
                                   FontWeight="SemiBold" FontSize="11"
                                   VerticalAlignment="Center" Margin="6,0,0,0"
                                   Foreground="{Binding CurrentModeTextColor}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== 第1行：顶部区域 ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：AWB增益曲线图表区 (保持不变) -->
            <Border Grid.Column="0" BorderBrush="#FF0078D7" BorderThickness="1" Background="#FFF9F9F9">
                <Grid x:Name="MainGrid">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 图表标题栏 -->
                    <Border Grid.Row="0" Background="#FF0078D7" Padding="5">
                        <TextBlock Text="📈 AWB增益曲线 (RGain vs BGain)" 
                                   Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <Label Content="B/G"  Grid.Row="1" Width="36" Height="24" Margin="5,40,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                            FontWeight="SemiBold" Foreground="#333333"/>
                    
                    <Label Content="R/G"  Grid.Row="1" Width="36" Height="24" Margin="0,0,5,40" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                            FontWeight="SemiBold" Foreground="#333333"/>

                    <!-- 图表主体 + 参数输入 (保持不变) -->
                    <DockPanel Grid.Row="1">
                        <!-- 底部参数输入栏 -->
                        <StackPanel DockPanel.Dock="Bottom" Height="32" Orientation="Horizontal" HorizontalAlignment="Center"
                                    Background="Transparent" Margin="0,0,0,0">
                            <Label Content="rgain__min:" VerticalAlignment="Center" Margin="0,0,15,0" 
                                   FontWeight="SemiBold" Foreground="#333333"/>
                            <TextBox Width="80" Text="{Binding RGainMin, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalAlignment="Center" Style="{StaticResource ParamTextBoxStyle}"
                                     ToolTip="RGain最小值范围限制"/>
                            <Label Content="rgain__max:" VerticalAlignment="Center" Margin="15,0,15,0"
                                   FontWeight="SemiBold" Foreground="#333333"/>
                            <TextBox Width="80" Text="{Binding RGainMax, UpdateSourceTrigger=PropertyChanged}" 
                                     VerticalAlignment="Center" Style="{StaticResource ParamTextBoxStyle}"
                                     ToolTip="RGain最大值范围限制"/>
                        </StackPanel>

                        <!-- 图表控件 (AWB专用样式 - 启用4条曲线专业标注) -->
                        <chartingToolkit:Chart Name="DataChart"  BorderThickness="0" 
                                              Style="{DynamicResource ChartStyle1}"
                                              Title="AWB增益边界曲线">
                            <chartingToolkit:Chart.Axes>
                                <chartingToolkit:LinearAxis  Name="ChartXMax" Orientation="X" Minimum="0" Maximum="1024" />
                                <chartingToolkit:LinearAxis  Name="ChartYMax" Orientation="Y" Minimum="0" Maximum="256" />
                            </chartingToolkit:Chart.Axes>
                            <chartingToolkit:Chart.LegendStyle>
                                <Style TargetType="datavis:Legend">
                                    <Setter Property="Width" Value="0" />
                                </Style>
                            </chartingToolkit:Chart.LegendStyle>
                            <!--<chartingToolkit:ScatterSeries 
                                Name="GainDataSeries"
                                ItemsSource="{Binding GainData, Converter={StaticResource gainDataBindingConverter}}" 
                                DependentValuePath="Value" IndependentValuePath="Key" 
                                IsSelectionEnabled="True" DataPointStyle="{DynamicResource ScatterDataPointStyle1}"/>-->
                            
                        </chartingToolkit:Chart>
                    </DockPanel>

                    <!-- 图表状态提示栏 - 根据模式动态更新提示文本 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Background="#FFE0E0E0">
                        <TextBlock Text="💡 提示: " VerticalAlignment="Center"/>
                        <TextBlock Text="右键拖拽平移Y轴 | 滚轮缩放 | 点击'画线'按钮绘制贝塞尔曲线" 
                                   FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧：操作控制面板 - 根据模式动态切换显示内容 -->
            <Border Grid.Column="2" BorderBrush="#FF0078D7" BorderThickness="1" Background="#FFFAFAFA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 面板标题 - 根据模式切换颜色和文字 -->
                    <Border Grid.Row="0" x:Name="ControlPanelTitleBar" Background="#FF0078D7" Padding="5">
                        <TextBlock x:Name="TxtControlPanelTitle" 
                                   Text="🎛️ 操作控制面板" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>

                    <!-- 传统模式面板 (原有UI - 保持100%不变) -->
                    <TabControl x:Name="TraditionalModeTabs" Grid.Row="1" 
                                Style="{DynamicResource TabControlStyle1}" 
                                SelectedIndex="0" Background="Transparent" 
                                BorderThickness="0" Margin="5"
                                Visibility="Visible">

                        <!-- Tab 1: 主要操作 (完全保留) -->
                        <TabItem Header="主要操作">
                            <StackPanel Background="Transparent">
                                <Button Content="📂 输入作图数据" Command="{Binding LoadChartDataFileCommand}" 
                                        HorizontalAlignment="Stretch" Margin="0,10,0,0" Padding="8,6"
                                        ToolTip="加载外部增益数据文件 (Ctrl+I)"/>
                                <Button Content="💾 输出作图数据" Command="{Binding SaveChartDataFileCommand}" 
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0" Padding="8,6"
                                        ToolTip="保存当前增益曲线到文件 (Ctrl+S)"/>
                                <Button Content="🖼️ 加载Raw" Command="{Binding LoadRawFileCommand}" 
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0" Padding="8,6"
                                        ToolTip="加载RAW图像文件用于校准 (Ctrl+O)"/>
                                <Separator Margin="0,10,0,10"/>
                                <Button Content="✏️ 画线" Click="OnBeginDrawBezierLine" 
                                        HorizontalAlignment="Stretch" Margin="0,0,0,0" Padding="8,6"
                                        FontWeight="Bold"
                                        ToolTip="在图表上绘制贝塞尔曲线来定义增益映射关系"/>
                                <Button Content="🔍 查看IQ" Command="{Binding ViewIQCommand}" 
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0" Padding="8,6"
                                        ToolTip="查看IQ调试窗口和详细参数"/>
                                <Separator Margin="0,10,0,10"/>
                                <Button Content="🔄 更新StatTab" Command="{Binding UpdateStatTabCommand}" 
                                        HorizontalAlignment="Stretch" Margin="0,0,0,0" Padding="8,6"
                                        ToolTip="刷新统计标签页数据"/>
                            </StackPanel>
                        </TabItem>

                        <!-- Tab 2: 曲线编辑 (完全保留) -->
                        <TabItem Header="曲线编辑">
                            <StackPanel Background="Transparent">
                                <!--<TextBlock Text="自动拟合 (推荐)" FontWeight="SemiBold" Margin="0,10,0,8" Foreground="#0078D7" FontSize="11"/>
                                <Button Content="🌟 一键生成曲线" Click="OnAutoGenerateBezierLines" 
                                        HorizontalAlignment="Stretch" Margin="0,0,0,0" Padding="8,6" 
                                        FontWeight="Bold" Background="#FFEBF5FB" 
                                        ToolTip="基于当前散点数据自动计算并生成最优贝塞尔拟合曲线"/>
                                <Separator Margin="0,12,0,12"/>
                                <TextBlock Text="手动编辑 (高级)" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="#333333" FontSize="11"/>-->
                                <TextBlock Text="贝塞尔曲线管理" FontWeight="SemiBold" 
                                           Margin="0,10,0,8" Foreground="#333333" FontSize="11"/>
                                <Button Content="➕ 添加曲线" Click="OnAddBezierLine" 
                                        HorizontalAlignment="Stretch" Margin="0,0,0,0" Padding="8,6"
                                        IsEnabled="{Binding CanAddBezierLine, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                        ToolTip="添加新的贝塞尔曲线（最多4条）"/>
                                <Button Content="➖ 删除曲线" Click="OnRemoveBezierLine" 
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0" Padding="8,6"
                                        IsEnabled="{Binding HasSelectedBezierLine, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                                        ToolTip="删除当前选中的贝塞尔曲线"/>
                                <Separator Margin="0,12,0,12"/>
                                <TextBlock Text="确认操作" FontWeight="SemiBold" 
                                           Margin="0,0,0,8" Foreground="#333333" FontSize="11"/>
                                
                                <Button Content="8点调整" Click="OnEditBezierLineOk" Visibility="Collapsed"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,0" Padding="8,6"
                                        FontWeight="Bold"
                                        ToolTip="以8点进行绘制的曲线进行编辑"/>
                                <Button Content="编辑完成" Click="OnEditBezierLineCompleted" Visibility="Collapsed"
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0" Padding="8,6"
                                        ToolTip="完成对8点的曲线编辑操作，进行数据调整"/>


                                <Button Content="✅ 确定应用" Click="OnDrawBezierLineOk" 
                                        HorizontalAlignment="Stretch" Margin="0,18,0,0" Padding="8,6"
                                        FontWeight="Bold"
                                        ToolTip="确认并应用绘制的曲线到图表"/>
                                <Button Content="❌ 取消编辑" Click="OnDrawBezierLineCancel" 
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0" Padding="8,6"
                                        ToolTip="取消当前的曲线编辑操作"/>
                            </StackPanel>
                        </TabItem>
                    </TabControl>

                    <!-- 智能模式面板 (新增 - 独立封装) -->
                    <Awb:SmartModePanel x:Name="SmartModePanelInstance" Grid.Row="1"
                                       DataContext="{Binding}"
                                       Visibility="Collapsed"/>

                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 第2行：中部操作工具栏 ==================== -->
        <ToolBarPanel Grid.Row="1" Margin="0,5,0,5">
            <ToolBarTray>
                <ToolBar>
                    <Button x:Name="BtnQuickLoad" Content="⚡ 快速加载" 
                            Command="{Binding LoadChartDataFileCommand}"
                            ToolTip="快速加载最近的数据文件" Padding="4" MinWidth="110"/>
                    <Separator/>
                    <Button x:Name="BtnDrawMode" Content="✏️ 进入绘图模式" 
                            Click="OnBeginDrawBezierLine"
                            ToolTip="切换到贝塞尔曲线绘图模式 (Ctrl+D)" 
                            Padding="4" MinWidth="120" FontWeight="Bold"/>
                    <Separator/>
                    <Button x:Name="BtnApplyCurve" Content="👍 应用曲线" 
                            Click="OnDrawBezierLineOk"
                            ToolTip="将绘制的曲线应用到增益映射 (Ctrl+Enter)" 
                            Padding="4" MinWidth="110"/>
                    <Button x:Name="BtnViewIQ" Content="🔬 IQ分析" 
                            Command="{Binding ViewIQCommand}"
                            ToolTip="打开IQ详细分析窗口 (Ctrl+Q)" Padding="4" MinWidth="100"/>
                    <Separator/>

                    <!-- 状态指示器 -->
                    <TextBlock x:Name="TxtOperationStatus" Text="就绪" 
                               VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                               Foreground="#666666"/>
                </ToolBar>
            </ToolBarTray>
        </ToolBarPanel>

        <!-- ==================== 第3行：下部状态信息区 ==================== -->
        <Grid Grid.Row="2" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.6*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：导航链接区 -->
            <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="1" 
                    Background="White" Padding="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📍 导航: " VerticalAlignment="Center" 
                               Foreground="#666666" Margin="0,0,8,0"/>
                        <Label VerticalAlignment="Center">
                            <Hyperlink Command="{Binding ViewPreviousIspStepCommand}" 
                                   TextDecorations="Underline">
                                <Run Text="← 查看先行步骤"/>
                            </Hyperlink>
                        </Label>
                        <TextBlock Text=" | " VerticalAlignment="Center" 
                               Foreground="#CCCCCC" Margin="5,0"/>
                        <TextBlock Text="AWB模块 - 自动白平衡增益校准" 
                               VerticalAlignment="Center" FontSize="11" 
                               Foreground="#333333" FontStyle="Italic"/>
                    </StackPanel>
                </Border>

            <!-- 右侧：快速信息面板 -->
            <Border Grid.Column="2" BorderBrush="#FF0078D7" BorderThickness="1" 
                    Background="#FFF0F8FF" Padding="3,0,3,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📊 当前状态" FontWeight="SemiBold" FontSize="11" 
                               Foreground="#0078D7" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtCurveCount" Text="曲线数量: 0" FontSize="10" 
                               Foreground="#333333"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 第4行：底部状态栏 ==================== -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Text="就绪 - AWB自动白平衡调试工具已就绪"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TxtWindowSize" Text=""/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="💡 提示: 使用Ctrl+快捷键加速操作"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
