<Window x:Class="ThunderSE.Ui.SettingWindow.Awb.AwbIQWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:awb="clr-namespace:ThunderSE.Ui.SettingWindow.Awb"
        xmlns:commonCtrls="clr-namespace:ThunderSE.Ui.CommonCustomControl"
        xmlns:datagridTookit="http://schemas.microsoft.com/wpf/2008/toolkit"
        Title="AWB白平衡IQ分析" Height="800" Width="1000" Background="#FFE5E5E5" ResizeMode="NoResize" Loaded="OnWindowLoaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="boolToVisibillityConverter"></BooleanToVisibilityConverter>
    </Window.Resources>
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="1.7*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：图像预览区域 + AWB参数面板 -->
        <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 图像预览区（左侧） -->
            <Border Grid.Column="0" BorderBrush="#FF0078D7" BorderThickness="1" Background="#FFF5F5F5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 预览区标题栏 -->
                    <Border Grid.Row="0" Background="#FF0078D7" Padding="5">
                        <TextBlock Text="📷 RAW图像预览 (支持6灰度/白点选区)" 
                                   Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>

                    <!-- 图像显示和RubberBandControl -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <commonCtrls:ImageWithRubberBandControl x:Name="RawImg"
                                                          Visibility="{Binding IsLoadImage, Converter={StaticResource boolToVisibillityConverter}}"/>
                    </ScrollViewer>

                    <!-- 选区状态栏 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Background="#FFE0E0E0" Margin="3">
                        <TextBlock Text="已选区域: " VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock x:Name="TxtPatchCount" Text="0/6" FontWeight="Bold" 
                                   Foreground="#FF0078D7" VerticalAlignment="Center" Margin="0,0,15,0"/>
                        <Border Background="{Binding PatchCountValid, Converter={StaticResource boolToVisibillityConverter}}" 
                                CornerRadius="3" Padding="8,2">
                            <TextBlock x:Name="TxtPatchStatus" Text="⏳ 请选择6个白平衡校准区域" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- AWB增益参数面板（右侧） -->
            <Border Grid.Column="2" BorderBrush="#FF0078D7" BorderThickness="1" Background="#FFF9F9F9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 参数标题 -->
                    <Border Grid.Row="0" Background="#FF0078D7" Padding="5">
                        <TextBlock Text="⚖️ 白平衡增益参数 (Gain)" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>

                    <!-- 增益值显示区 -->
                    <StackPanel Grid.Row="1" Margin="15,10">
                        <!-- R Gain -->
                        <Border Background="#FFFFF0F0" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="R通道增益 (Red Gain)" FontSize="12" FontWeight="Bold" 
                                           Foreground="#FFCC0000" Margin="0,0,0,5"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Text="值: " FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtRGain" IsReadOnly="True" Width="80" 
                                             TextAlignment="Center" FontSize="16" FontWeight="Bold"
                                             Foreground="#FFCC0000" Background="White" Margin="5,0"/>
                                    <TextBlock Text="" FontSize="14" VerticalAlignment="Center"/>
                                    <Border x:Name="BorderRStatus" Background="#FF4CAF50" CornerRadius="3" Padding="8,2">
                                        <TextBlock x:Name="TxtRStatus" Text="✓ 正常" Foreground="White" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- B Gain -->
                        <Border Background="#FFF0F0FF" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="B通道增益 (Blue Gain)" FontSize="12" FontWeight="Bold" 
                                           Foreground="#FF0000CC" Margin="0,0,0,5"/>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Text="值: " FontSize="11" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TxtBGain" IsReadOnly="True" Width="80" 
                                             TextAlignment="Center" FontSize="16" FontWeight="Bold"
                                             Foreground="#FF0000CC" Background="White" Margin="5,0"/>
                                    <TextBlock Text="" FontSize="14" VerticalAlignment="Center"/>
                                    <Border x:Name="BorderBStatus" Background="#FF4CAF50" CornerRadius="3" Padding="8,2">
                                        <TextBlock x:Name="TxtBStatus" Text="✓ 正常" Foreground="White" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 色温指示器 -->
                        <GroupBox Header="色温估算" Margin="0,10,0,0" FontSize="11">
                            <StackPanel>
                                <TextBlock Text="当前色温:" FontSize="11" Margin="0,2,0,2"/>
                                <TextBlock x:Name="TxtColorTemp" Text="-- K" FontSize="20" FontWeight="Bold" 
                                           Foreground="#FF333333"/>
                                <TextBlock x:Name="TxtLightSource" Text="" FontSize="10" 
                                           Foreground="#FF666666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <!-- 合规性说明 -->
                    <Border Grid.Row="2" Background="#FFFFFDD0" Padding="8" Margin="5" CornerRadius="3">
                        <TextBlock Text="📐 标准范围: R/B Gain ∈ [0.92, 1.08]" 
                                   FontSize="10" Foreground="#FF666666"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 中部：操作按钮栏 -->
        <ToolBarPanel Grid.Row="1" Margin="0,5,0,5">
            <ToolBarTray>
                <ToolBar>
                    <Button x:Name="BtnLoadRaw" Content="📂 加载RAW" Click="OnLoadRaw_Click" 
                            ToolTip="加载RAW图像文件 (Ctrl+O)" Padding="10,4" MinWidth="120"/>
                    <Separator/>
                    <Button x:Name="BtnUndoPatch" Content="↩️ 撤销选区" Click="OnUndoPatch_Click" 
                            IsEnabled="False" ToolTip="撤销最后一个选区 (Ctrl+Z)" Padding="10,4" MinWidth="100"/>
                    <Separator/>
                    <Button x:Name="BtnCalculate" Content="⚖️ 计算增益" Click="OnCalculate_Click" 
                            IsEnabled="False" ToolTip="计算白平衡增益参数 (Ctrl+Enter)" 
                            Padding="10,4" MinWidth="120" FontWeight="Bold"/>
                    <Separator/>
                    <Button x:Name="BtnApply" Content="👁️ 应用预览" Click="OnApply_Click" 
                            IsEnabled="False" ToolTip="应用白平衡到预览图 (Ctrl+P)" Padding="10,4" MinWidth="110"/>
                    <Separator/>
                    <Button x:Name="BtnEvaluate" Content="📊 评估质量" Click="OnEvaluate_Click" 
                            IsEnabled="False" ToolTip="评估白平衡准确性 (Ctrl+E)" Padding="10,4" MinWidth="110"/>
                    <Separator/>
                    <Button x:Name="BtnExport" Content="💾 导出报告" Click="OnExport_Click" 
                            IsEnabled="False" ToolTip="导出CSV报告 (Ctrl+S)" Padding="10,4" MinWidth="110"/>

                    <!-- 进度指示器 -->
                    <ProgressBar x:Name="ProgressCalc" Width="150" Height="16" 
                                 Visibility="Collapsed" Minimum="0" Maximum="100" Value="0"/>
                    <TextBlock x:Name="TxtProgress" Text="" VerticalAlignment="Center" Margin="5,0,0,0" FontSize="11"/>
                </ToolBar>
            </ToolBarTray>
        </ToolBarPanel>

        <!-- 下部：数据表格 + 评估结果 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.5*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- IQ数据表格（左） -->
            <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FF666666" Padding="5">
                        <TextBlock Text="📋 白平衡质量指标 (IQ Data)" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <DataGrid Grid.Row="1" x:Name="IqDataGrid" 
                              AutoGenerateColumns="False" CanUserAddRows="False" 
                              CanUserDeleteRows="False" IsReadOnly="True"
                              GridLinesVisibility="All" HeadersVisibility="Column"
                              RowBackground="White" AlternatingRowBackground="#FFF8F8F8"
                              FontSize="11" Margin="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="参数名" Width="80" Binding="{Binding Name}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="当前值" Width="70" Binding="{Binding Value, StringFormat=F4}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#FF0078D7"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="标准范围" Width="90" Binding="{Binding ValueRange}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="合规性" Width="70" Binding="{Binding IsGoodValue}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGoodValue}" Value="True">
                                                <Setter Property="Foreground" Value="#FF4CAF50"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsGoodValue}" Value="False">
                                                <Setter Property="Foreground" Value="#FFF44336"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 白平衡效果评估（右） -->
            <Border Grid.Column="2" BorderBrush="#FF0078D7" BorderThickness="1" Background="#FFFAFAFA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FF0078D7" Padding="5">
                        <TextBlock Text="🎯 白平衡效果评估" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <StackPanel Grid.Row="1" Margin="0">
                        <!-- 整体评分 -->
                        <TextBlock Text="整体评级:" FontSize="11" Margin="0,0,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtRatingStars" Text="--" FontSize="24" 
                                       VerticalAlignment="Bottom" Foreground="#FF333333"/>
                            <TextBlock x:Name="TxtRatingText" Text="" FontSize="14" 
                                       VerticalAlignment="Bottom" Margin="10,0,0,0" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- 增益偏差可视化 -->
                        <TextBlock Text="增益偏差 (Deviation):" FontSize="11" Margin="0,3,0,2"/>
                        <Grid Margin="0,2,0,2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- R Gain偏差条 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="R:" Width="20" FontSize="10" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="ProgressRDeviation" Height="18" Width="180" 
                                             Minimum="0" Maximum="20" Value="10"
                                             Background="#FFE0E0E0"/>
                                <TextBlock x:Name="TxtRDeviation" Text="0%" Width="40" FontSize="10" 
                                           TextAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>

                            <!-- B Gain偏差条 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2">
                                <TextBlock Text="B:" Width="20" FontSize="10" VerticalAlignment="Center"/>
                                <ProgressBar x:Name="ProgressBDeviation" Height="18" Width="180" 
                                             Minimum="0" Maximum="20" Value="10"
                                             Background="#FFE0E0E0"/>
                                <TextBlock x:Name="TxtBDeviation" Text="0%" Width="40" FontSize="10" 
                                           TextAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 白平衡建议 -->
                        <TextBlock Text="💡 校准建议:" FontSize="11" Margin="0,3,0,2"/>
                        <Border Background="#FFF5F5DC" CornerRadius="3" Padding="8" Margin="0,2,0,0">
                            <TextBlock x:Name="TxtSuggestion" Text="请先加载图像并选择校准区域" 
                                       FontSize="10" Foreground="#FF666666" TextWrapping="Wrap"/>
                        </Border>

                        <!-- 详细信息按钮 -->
                        <Button x:Name="BtnShowDetail" Content="查看详细数据 →" 
                                Click="OnShowDetail_Click" Margin="0,3,0,0" Padding="4"
                                HorizontalAlignment="Stretch" IsEnabled="False"
                                ToolTip="展开完整的IQ评估详情"/>

                        <!-- 状态消息 -->
                        <TextBlock x:Name="TxtStatusMessage" Text="" FontSize="10" 
                                   Foreground="#FF666666" TextWrapping="Wrap" Margin="0,1,0,0"
                                   VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部：状态栏 -->
        <StatusBar Grid.Row="3" Margin="0,5,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Text="就绪 - 请加载RAW图像开始白平衡校准流程"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TxtElapsedTime" Text=""/>
            </StatusBarItem>
        </StatusBar>
    </Grid>

