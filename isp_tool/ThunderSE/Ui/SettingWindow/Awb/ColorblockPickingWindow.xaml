<Window x:Class="ThunderSE.Ui.SettingWindow.Awb.ColorblockPickingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AWB色块选择工具" Width="1000" Height="700"
        MinWidth="800" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="#FFF5F5F5"
        xmlns:awb="clr-namespace:ThunderSE.Ui.SettingWindow.Awb" Loaded="Window_Loaded">
    <!--<Window.DataContext>
        <awb:ColorblockPickingWindowViewModel/>
    </Window.DataContext>-->
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <!-- 第1行：顶部 - 图像预览区域 -->
            <RowDefinition Height="*"/>
            <!-- 第2行：中部 - 操作工具栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 第3行：下部 - 状态信息区 -->
            <RowDefinition Height="Auto"/>
            <!-- 第4行：底部 - 状态栏 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 第1行：顶部 - 图像预览区域 ==================== -->
        <Border Grid.Row="0" BorderBrush="#FF0078D7" BorderThickness="1" Background="#FFF9F9F9" Margin="0,0,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0" Background="#FF0078D7">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖼️ RAW图像色块选择 (支持6个色块选区)" 
                                   Foreground="White" FontWeight="Bold" FontSize="13" 
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtImageCount" Text="" 
                                   Foreground="#FFB0E0FF" FontSize="11" 
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TabControl图像列表（左侧标签页） -->
                <TabControl Name="RawImgsTab" Grid.Row="1" 
                            TabStripPlacement="Left" 
                            BorderThickness="0">
                    <TabControl.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="💾 保存选区数据" Click="SaveSelections_MenuItem_Click">
                               
                            </MenuItem>
                            <MenuItem Header="📂 导入选区数据" Click="ImportSelections_MenuItem_Click">
                                
                            </MenuItem>
                            <MenuItem Header="📦 导入到所有图像" Click="BatchImportSelectionsButton_Click">
                               
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="🧹 清空所有选区" Click="ClearAll_MenuItem_Click">
                               
                            </MenuItem>
                        </ContextMenu>
                    </TabControl.ContextMenu>
                </TabControl>

                <!-- 底部提示信息栏 -->
                <!--<StackPanel Grid.Row="2" Orientation="Horizontal" 
                            Background="#FFE8F4FD" Margin="8,5">
                    <TextBlock Text="💡 操作提示: " VerticalAlignment="Center" 
                               FontWeight="SemiBold" Foreground="#0078D7" Margin="0,0,5,0"/>
                    <TextBlock Text="在每张图片上框选最多6个色块区域 | 使用'撤销'按钮取消上一次选择" 
                               FontSize="11" Foreground="#333333" VerticalAlignment="Center"/>
                </StackPanel>-->
                <StackPanel Grid.Row="2" Orientation="Horizontal" 
                            Background="#FFE8F4FD">
                    <TextBlock Text="💡 操作提示: " VerticalAlignment="Center" 
                               FontWeight="SemiBold" Foreground="#0078D7" Margin="0,0,5,0"/>
                    <TextBlock Text="选择类别后框选色块 | 每类最多6个 | 可切换类别继续框选 | 使用'撤销'按钮取消选择" 
                               FontSize="11" Foreground="#333333" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 第2行：中部 - 操作工具栏 ==================== -->
        <ToolBarPanel Grid.Row="1">
            <ToolBarTray>
                <ToolBar>
                    <!-- 类别选择组 -->
                    <Label Content="🏷️ 色块类别:" VerticalAlignment="Center" Margin="0,0,0,0"/>
                    <ComboBox x:Name="CategoryCombo" Width="60" VerticalAlignment="Center" IsReadOnly="True"
                              SelectedIndex="0"
                              ToolTip="选择当前绘制的色块类别">
                        <ComboBoxItem Content="白点"/>
                        <ComboBoxItem Content="非白点"/>
                    </ComboBox>
                    <!-- 导航操作组 -->
                    <Button x:Name="BtnBeforePic" Content="⬅️上一张" 
                            Click="BeforePicButton_Click"
                            ToolTip="切换到上一张RAW图像 (Ctrl+Left)" 
                            MinWidth="60"/>
                    <Button x:Name="BtnNextPic" Content="➡️下一张" 
                            Click="NextPicButton_Click"
                            ToolTip="切换到下一张RAW图像 (Ctrl+Right)" 
                            MinWidth="60"/>

                    <Separator Margin="10,0,5,0"/>

                    <!-- 编辑操作组 -->
                    <Button x:Name="BtnUndo" Content="↩️撤销选区" 
                            Click="UndoButton_Click"
                            ToolTip="撤销当前图片的上一次选区操作 (Ctrl+Z)" 
                            MinWidth="60"/>
                    <Button x:Name="BtnUndoCategory" Content="🗑️撤销此类" 
                            Click="UndoCategoryButton_Click"
                            ToolTip="撤销当前类别的所有选区" 
                            MinWidth="60"/>
                    <Button x:Name="BtnClearAll" Content="🧹清空全部" 
                            Click="ClearAllButton_Click"
                            ToolTip="清空当前图片的所有选区" 
                            MinWidth="60"/>
                    <Separator Margin="10,0,5,0"/>

                    <!-- 确认操作组 -->
                    <Button x:Name="BtnOk" Content="✅确认计算AWB增益" 
                            Click="OkButton_Click"
                            ToolTip="根据选区计算AWB白平衡增益值并关闭窗口 (Ctrl+Enter)" 
                            MinWidth="120" FontWeight="Bold"/>
                    <Button x:Name="BtnCancel" Content="❌ 取消" 
                            Click="CancelButton_Click"
                            ToolTip="取消操作并关闭窗口 (Esc)" 
                            Margin="5,0,5,0" MinWidth="50"/>

                    <Separator Margin="4.5,0,5,0"/>

                    <!-- 状态指示器 -->
                    <TextBlock x:Name="TxtCurrentImage" Text="当前图像: --" 
                               VerticalAlignment="Center" Margin="5,0,0,0" 
                               FontSize="11" Foreground="#666666"/>
                    <TextBlock x:Name="TxtSelectionCount" Text="已选色块: 0/6" 
                               VerticalAlignment="Center" Margin="5,0,0,0" 
                               FontSize="11" FontWeight="SemiBold" Foreground="#0078D7"/>
                </ToolBar>
            </ToolBarTray>
        </ToolBarPanel>

        <!-- ==================== 第3行：下部 - 快速信息面板 ==================== -->
        <Grid Grid.Row="2" Height="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：操作指南 -->
            <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="1" 
                    Background="White" Padding="3,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋 工作流程: " VerticalAlignment="Center" 
                               Foreground="#666666" FontWeight="SemiBold" Margin="0,0,5,0"/>
                    <TextBlock Text="1.查看图像 → 2.框选色块(分两个类别) → 3.切换下一张 → 4.确认计算" 
                               FontSize="11" Foreground="#333333" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 右侧：统计信息面板 -->
            <Border Grid.Column="2" BorderBrush="#FF0078D7" BorderThickness="1" 
                    Background="#FFF0F8FF" Padding="10,4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📊 选择统计" FontWeight="SemiBold" FontSize="11" 
                               Foreground="#0078D7" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtTotalStats" Text="总图像数: 0 | 已处理: 0" 
                               FontSize="10" Foreground="#333333"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 第4行：底部 - 状态栏 ==================== -->
        <StatusBar Grid.Row="3" Margin="0,5,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Text="就绪 - 请等待图像加载完成..."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TxtProgressInfo" Text=""/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="💡 提示: 使用Ctrl+快捷键加速操作 | AWB自动白平衡校准工具"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>

    <!--<Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <TabControl Name="RawImgsTab" Grid.Row="0" TabStripPlacement="Left" >
        </TabControl>
        <DockPanel Grid.Row="1">
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="60" Height="25" Click="UndoButton_Click" Margin="130,0,0,0">撤销</Button>
                <Button Width="60" Height="25" Click="BeforePicButton_Click" Margin="10,0,0,0">&lt;上一张</Button>
                <Button Width="60" Height="25" Click="NextPicButton_Click" Margin="10,0,0,0">下一张&gt;</Button>
                <Button Width="60" Height="25" Click="OkButton_Click" Margin="10,0,50,0">确定</Button>
            </StackPanel>
        </DockPanel>
    </Grid>-->
</Window>
