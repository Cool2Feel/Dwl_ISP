<UserControl x:Class="ThunderSE.Ui.SettingWindow.Awb.CurveLegendPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ThunderSE.Ui.SettingWindow.Awb"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="280"
             Background="#FFFAFAFA">

    <UserControl.Resources>
        <!-- 曲线图例项样式 -->
        <Style x:Key="CurveLegendItemStyle" TargetType="Border">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#FFE0E0E0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- 标题栏 -->
        <Border Background="#FF0078D7" CornerRadius="4,4,0,0" Padding="10,8">
            <TextBlock Text="📊 增益边界曲线图例" 
                       Foreground="White" FontWeight="Bold" FontSize="12"/>
        </Border>

        <!-- 图例列表 -->
        <ItemsControl x:Name="CurveLegendList" Margin="0,5">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CurveLegendItemStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左侧：颜色标识 + 简短标签 -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- 颜色方块 -->
                                <Border Width="16" Height="16" 
                                        CornerRadius="2" 
                                        Background="{Binding Color}"
                                        BorderBrush="#FF999999" BorderThickness="1"
                                        Margin="0,0,8,0"/>
                                <!-- 图标 + 短标签 -->
                                <TextBlock Text="{Binding IconAndLabel}" 
                                           FontWeight="SemiBold" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 中间：中文名称 -->
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding ChineseName}"
                                       FontSize="10" Foreground="#555555"
                                       VerticalAlignment="Center" Margin="8,0"/>

                            <!-- 右侧：内存位置提示 -->
                                <Border Grid.Column="2" 
                                        Background="#FFF0F0F0" 
                                        CornerRadius="3" Padding="6,3">
                                    <TextBlock Text="{Binding MemoryLocation}" 
                                               FontSize="9" Foreground="#777777"
                                               FontStyle="Italic"/>
                                </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 底部说明 -->
        <Border Background="#FFFFFACD" CornerRadius="0,0,4,4" Padding="10,8" Margin="0,5,0,0">
            <StackPanel>
                <TextBlock Text="💡 层级说明:" FontWeight="SemiBold" FontSize="10" 
                           Foreground="#856404" Margin="0,0,0,4"/>
                <TextBlock Text="• 外层边界(蓝/紫): 宽松筛选区域" FontSize="9" 
                           Foreground="#666666"/>
                <TextBlock Text="• 内层边界(红/橙): 严格白点判定" FontSize="9" 
                           Foreground="#666666"/>
                <TextBlock Text="• 有效白点区域位于内层边界之间" FontSize="9" 
                           Foreground="#666666"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
