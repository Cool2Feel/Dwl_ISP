<Window x:Class="ThunderSE.Ui.SettingWindow.Awb.LabelInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThunderSE.Ui.SettingWindow.Awb"
        mc:Ignorable="d"
        Title="LabelInputDialog" Height="140" Width="300" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="15">
        <TextBlock Text="请输入光源标签：" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtLabel" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="确定" IsDefault="True" Click="OkButton_Click" Width="60" Margin="0,0,10,0"/>
            <Button Content="取消" IsCancel="True" Width="60"/>
        </StackPanel>
    </StackPanel>
</Window>
