<Window x:Class="ThunderSE.Ui.SettingWindow.Lsc.LscIQWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lsc="clr-namespace:ThunderSE.Ui.SettingWindow.Lsc"
        xmlns:datagridTookit="http://schemas.microsoft.com/wpf/2008/toolkit"
        Title="LSC IQ参数分析" Width="1000" Height="800" ResizeMode="NoResize"
        MinWidth="750" MinHeight="600" WindowStartupLocation="CenterScreen"
        >
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <!-- 第1行：顶部 - IQ数据表格区域 -->
            <RowDefinition Height="*"/>
            <!-- 第2行：中部 - 操作工具栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 第3行：下部 - 统计信息区 -->
            <RowDefinition Height="Auto"/>
            <!-- 第4行：底部 - 状态栏 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 第1行：顶部 - IQ数据表格区域 ==================== -->
        <Border Grid.Row="0" BorderBrush="#FF0078D7" BorderThickness="1" Background="#FFF9F9F9" Margin="0,0,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0" Background="#FF0078D7" Padding="8,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊 LSC IQ参数详情 (Lens Shading Image Quality)" 
                                   Foreground="White" FontWeight="Bold" FontSize="13" 
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtDataStatus" Text="" 
                                   Foreground="#FFB0E0FF" FontSize="11" 
                                   VerticalAlignment="Center" Margin="15,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- DataGrid IQ数据显示（增强版） -->
                <datagridTookit:DataGrid Grid.Row="1" 
                                          x:Name="IQDataGrid"
                                          Margin="5"
                                          ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" 
                                          AutoGenerateColumns="False"  
                                          ItemsSource="{Binding View, RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=1, AncestorType=Window}}"
                                          IsReadOnly="True"
                                          SelectionMode="Single"
                                          GridLinesVisibility="All"
                                          HorizontalGridLinesBrush="#FFE0E0E0"
                                          VerticalGridLinesBrush="#FFE0E0E0"
                                          RowBackground="White"
                                          AlternatingRowBackground="#FFFAFAFA"
                                          BorderThickness="1"
                                          BorderBrush="#FFCCCCCC"
                                          ToolTip="显示LSC镜头阴影校正的12个关键IQ参数及其是否在正常范围内">

                    <datagridTookit:DataGrid.CellStyle>
                        <Style TargetType="datagridTookit:DataGridCell">
                            <Setter Property="Block.TextAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FFE8F4FD"/>
                                    <Setter Property="Foreground" Value="#FF0078D7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </datagridTookit:DataGrid.CellStyle>

                    <datagridTookit:DataGrid.RowStyle>
                        <Style TargetType="datagridTookit:DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FFE8F4FD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </datagridTookit:DataGrid.RowStyle>

                    <datagridTookit:DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander IsExpanded="True" Background="#FFF0F8FF" BorderBrush="#FF0078D7" BorderThickness="1">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📁 " FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding Path=Name}" FontWeight="SemiBold" FontSize="12" Foreground="#0078D7"/>
                                                            <TextBlock Text=" (" Margin="5,0,0,0" Foreground="#666666" FontSize="10"/>
                                                            <TextBlock Text="{Binding Path=ItemCount}" Foreground="#666666" FontSize="10"/>
                                                            <TextBlock Text=" 项)" Foreground="#666666" FontSize="10"/>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </datagridTookit:DataGrid.GroupStyle>

                    <datagridTookit:DataGrid.Columns>
                        <datagridTookit:DataGridTextColumn Width="120" Binding="{Binding Name}" IsReadOnly="True" Header="📝 参数项">
                            <datagridTookit:DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#333333"/>
                                </Style>
                            </datagridTookit:DataGridTextColumn.ElementStyle>
                        </datagridTookit:DataGridTextColumn>

                        <datagridTookit:DataGridTextColumn Width="160" Binding="{Binding Value}" IsReadOnly="True" Header="📊 当前值">
                            <datagridTookit:DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#0078D7"/>
                                </Style>
                            </datagridTookit:DataGridTextColumn.ElementStyle>
                        </datagridTookit:DataGridTextColumn>

                        <datagridTookit:DataGridTextColumn Width="180" Binding="{Binding ValueRange}" IsReadOnly="True" Header="✅ 正常范围">
                            <datagridTookit:DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#009900"/>
                                    <Setter Property="FontStyle" Value="Italic"/>
                                </Style>
                            </datagridTookit:DataGridTextColumn.ElementStyle>
                        </datagridTookit:DataGridTextColumn>

                        <datagridTookit:DataGridCheckBoxColumn Width="100" Binding="{Binding IsGoodValue}" IsReadOnly="True" Header="⚠️ 是否合格">
                            <datagridTookit:DataGridCheckBoxColumn.ElementStyle>
                                <Style TargetType="CheckBox">
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Foreground" Value="Green"/>
                                            <Setter Property="ToolTip" Value="✓ 参数值在正常范围内"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter Property="Foreground" Value="Red"/>
                                            <Setter Property="ToolTip" Value="✗ 参数值超出正常范围！"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="{x:Null}">
                                            <Setter Property="Foreground" Value="Gray"/>
                                            <Setter Property="ToolTip" Value="- 无范围限制"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </datagridTookit:DataGridCheckBoxColumn.ElementStyle>
                        </datagridTookit:DataGridCheckBoxColumn>
                    </datagridTookit:DataGrid.Columns>
                </datagridTookit:DataGrid>

                <!-- 底部提示信息栏 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Background="#FFE8F4FD">
                    <TextBlock Text="💡 数据说明: " VerticalAlignment="Center" 
                               FontWeight="SemiBold" Foreground="#0078D7" Margin="0,0,5,0"/>
                    <TextBlock Text="ColorShadingIQ(色彩阴影) + LensShadingIQ(镜头阴影) | 共12个参数 | 绿色=合格 红色=超限" 
                               FontSize="11" Foreground="#333333" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 第2行：中部 - 操作工具栏 ==================== -->
        <ToolBarPanel Grid.Row="1" Margin="0,5,0,5">
            <ToolBarTray>
                <ToolBar>
                    <!-- 导出操作组 -->
                    <Button x:Name="BtnExportCSV" Content="📥 导出CSV" 
                            Click="ExportCSV_Click"
                            ToolTip="将IQ数据导出为CSV文件 (Ctrl+S)" 
                            Padding="10,4" MinWidth="110"/>

                    <Button x:Name="BtnCopyData" Content="📋 复制数据" 
                            Click="CopyData_Click"
                            ToolTip="复制当前选中的数据到剪贴板 (Ctrl+C)" 
                            Padding="10,4" MinWidth="110"/>

                    <Separator/>

                    <!-- 刷新操作组 -->
                    <Button x:Name="BtnRefresh" Content="🔄 刷新视图" 
                            Click="Refresh_Click"
                            ToolTip="刷新数据网格视图 (F5)" 
                            Padding="10,4" MinWidth="110"/>

                    <Separator/>

                    <!-- 状态指示器 -->
                    <TextBlock x:Name="TxtTotalParams" Text="总参数: 12" 
                               VerticalAlignment="Center" Margin="10,0,0,0" 
                               FontSize="11" Foreground="#666666"/>
                    <TextBlock x:Name="TxtPassRate" Text="通过率: --" 
                               VerticalAlignment="Center" Margin="15,0,0,0" 
                               FontSize="11" FontWeight="SemiBold" Foreground="#0078D7"/>
                </ToolBar>
            </ToolBarTray>
        </ToolBarPanel>

        <!-- ==================== 第3行：下部 - 快速统计信息面板 ==================== -->
        <Grid Grid.Row="2" Height="50">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：分组信息 -->
            <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="1" 
                    Background="White" Padding="12,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📂 数据分组: " VerticalAlignment="Center" 
                               Foreground="#666666" FontWeight="SemiBold" Margin="0,0,8,0"/>
                    <Border Background="#FFFFFDD0" CornerRadius="3" Padding="8,4">
                        <TextBlock Text="🎨 ColorShadingIQ (8项)" FontSize="11" Foreground="#996600"/>
                    </Border>
                    <Border Background="#FFDDFFDD" CornerRadius="3" Padding="8,4" Margin="8,0,0,0">
                        <TextBlock Text="🔲 LensShadingIQ (4项)" FontSize="11" Foreground="#006633"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 右侧：质量评估 -->
            <Border Grid.Column="2" BorderBrush="#FF0078D7" BorderThickness="1" 
                    Background="#FFF0F8FF" Padding="10,4">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🏆 质量评估" FontWeight="SemiBold" FontSize="11" 
                               Foreground="#0078D7" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtQualityAssessment" Text="正在计算..." 
                               FontSize="10" Foreground="#333333"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 第4行：底部 - 状态栏 ==================== -->
        <StatusBar Grid.Row="3" Margin="0,3,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Text="就绪 - LSC IQ参数分析窗口已就绪"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TxtProgressInfo" Text=""/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="💡 提示: 点击表头可排序 | 双击单元格查看详情 | LSC IQ Analysis Tool"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>

