<Window x:Class="ThunderSE.Ui.SettingWindow.Lsc.LscWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Lsc="clr-namespace:ThunderSE.Ui.SettingWindow.Lsc"
        Title="LSC镜头阴影校正工具" Width="1000" ResizeMode="NoResize"  Height="800" Background="#FFE5E5E5"
        Loaded="OnWindowLoaded" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Lsc:RawBufferToBitmapImageConverter x:Key="rawBufferToBitmapImageConverter"></Lsc:RawBufferToBitmapImageConverter>
    </Window.Resources>

    <Grid Margin="3">
        <Grid.RowDefinitions>
            <!-- 第1行：顶部 - 图像显示区域（原图+LSC效果） -->
            <RowDefinition Height="3*"/>
            <!-- 第2行：中部 - 操作工具栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 第3行：下部 - 控制面板+状态信息 -->
            <RowDefinition Height="Auto"/>
            <!-- 第4行：底部 - 状态栏 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 第1行：顶部 - 图像显示区域 ==================== -->
        <Border Grid.Row="0" BorderBrush="#FF0078D7" BorderThickness="1" Background="#FFF9F9F9" Margin="0,0,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0" Background="#FF0078D7" Padding="8,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖼️ LSC镜头阴影校正 (Lens Shading Correction)" 
                                   Foreground="White" FontWeight="Bold" FontSize="13" 
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtImageStatus" Text="" 
                                   Foreground="#FFB0E0FF" FontSize="11" 
                                   VerticalAlignment="Center" Margin="15,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- TabControl图像显示（原图 / LSC效果） -->
                <TabControl Name="ImgDisplayTab" Grid.Row="1" 
                            BorderThickness="0" Margin="5">

                    <!-- Tab 1: 原图显示 -->
                    <TabItem Name="OriginTab" Header="📷 原图 (Raw Image)">
                        <Canvas Background="White" Name="OriginImgCanvas" 
                                MouseLeftButtonDown="OnMouseLeftDown"
                                MouseMove="OnCanvasMouseMove">
                            <Image Name="RawImg" Source="{Binding OriginRawFileBuffer, Converter={StaticResource rawBufferToBitmapImageConverter}}"
                                   Height="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=1, AncestorType=Canvas}, Path=ActualHeight}"
                                   Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=1, AncestorType=Canvas}, Path=ActualWidth}"
                                   Stretch="Fill"
                                   SizeChanged="OnRawImgSizeChange">
                            </Image>

                            <!-- 描点区域边框（红色虚线） -->
                            <Border Name="DrawingDotAreaBorder" BorderThickness="1">
                                <Border.BorderBrush>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Rectangle StrokeDashArray="4 2"
                                                Stroke="Red"
                                                StrokeThickness="2"
                                                RadiusX="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=CornerRadius.TopRight}"
                                                RadiusY="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=CornerRadius.BottomLeft}"
                                                Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=ActualWidth}"
                                                Height="{Binding RelativeSource={RelativeSource AncestorType={x:Type Border}}, Path=ActualHeight}"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.BorderBrush>
                                <Grid>
                                    <Canvas Name="DrawingDotArea">
                                        <Grid Name="dot" Height="10" Width="10" Visibility="Collapsed">
                                            <Line X1="0" Y1="0" X2="{Binding ElementName='dot', Path='ActualWidth'}" Y2="{Binding ElementName='dot', Path='ActualHeight'}" Stroke="Red" StrokeThickness="4" />
                                            <Line X1="0" Y1="{Binding ElementName='dot', Path='ActualHeight'}" X2="{Binding ElementName='dot', Path='ActualWidth'}" Y2="0" Stroke="Red" StrokeThickness="4" />
                                        </Grid>
                                    </Canvas>
                                </Grid>
                            </Border>
                        </Canvas>
                    </TabItem>

                    <!-- Tab 2: LSC效果显示 -->
                    <TabItem Header="🎨 LSC效果 (Processed)">
                        <Canvas Name="ProcessedImgCanvas"
                                Background="White"
                                MouseMove="OnCanvasMouseMove">
                            <Image Name="ProcessedImg" Source="{Binding ProcessedRawFileBuffer, Converter={StaticResource rawBufferToBitmapImageConverter}, NotifyOnTargetUpdated=True}" 
                                   Height="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=1, AncestorType=Canvas}, Path=ActualHeight}"
                                   Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorLevel=1, AncestorType=Canvas}, Path=ActualWidth}"
                                   Stretch="Fill"
                                   TargetUpdated="OnProcessedImageUpdated"
                                   SizeChanged="OnProcessedImgSizeChange">
                            </Image>
                        </Canvas>
                    </TabItem>
                </TabControl>

                <!-- 底部提示信息栏 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Background="#FFE8F4FD">
                    <TextBlock Text="💡 操作提示: " VerticalAlignment="Center" 
                               FontWeight="SemiBold" Foreground="#0078D7" Margin="0,0,5,0"/>
                    <TextBlock Text="在'原图'Tab上点击描点选择校正中心 | 鼠标移动查看像素RGB值 | 描点后点击'计算LSC'生成校正权重" 
                               FontSize="11" Foreground="#333333" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 第2行：中部 - 操作工具栏 ==================== -->
        <ToolBarPanel Grid.Row="1" Margin="0,5,0,5">
            <ToolBarTray>
                <ToolBar>
                    <!-- 文件操作组 -->
                    <Button x:Name="BtnLoadRaw" Content="📂 加载RAW文件" 
                            Command="{Binding LoadRawFileCommand}"
                            ToolTip="加载RAW图像文件用于LSC校正分析 (Ctrl+O)" 
                            Padding="10,4" MinWidth="130"/>

                    <Separator/>

                    <!-- 自动描点按钮 -->
                    <Button x:Name="BtnAutoDot" Content="🎯 自动描点" 
                            Command="{Binding AutoDetectBrightestCommand}"
                            IsEnabled="{Binding HasLoadedRawFile}"
                            ToolTip="自动检测RAW图像最亮区域作为校正中心 (Ctrl+D)" 
                            Padding="10,4" MinWidth="100"/>

                    <Separator/>

                    <!-- 计算操作组 -->
                    <Button x:Name="BtnCalcLsc" Content="⚙️ 计算LSC权重" 
                            Click="ClickCalc"
                            IsEnabled="{Binding HasLoadedRawFile}"
                            ToolTip="根据描点位置计算镜头阴影校正权重 (Ctrl+Enter)" 
                            Padding="10,4" MinWidth="130" FontWeight="Bold"/>

                    <Separator/>

                    <!-- 查看操作组 -->
                    <Button x:Name="BtnViewIQ" Content="🔬 查看IQ参数" 
                            Command="{Binding ViewIQCommand}"
                            IsEnabled="{Binding HasProcessedRawFile}"
                            ToolTip="打开IQ参数详细设置窗口 (Ctrl+Q)" 
                            Padding="10,4" MinWidth="130"/>

                    <Separator/>

                    <!-- 状态指示器 -->
                    <TextBlock x:Name="TxtDotStatus" Text="未描点" 
                               VerticalAlignment="Center" Margin="10,0,0,0" 
                               FontSize="11" Foreground="#666666"/>
                    <TextBlock x:Name="TxtProcessingStatus" Text="" 
                               VerticalAlignment="Center" Margin="15,0,0,0" 
                               FontSize="11" FontWeight="SemiBold" Foreground="#0078D7"/>
                </ToolBar>
            </ToolBarTray>
        </ToolBarPanel>

        <!-- ==================== 第3行：下部 - 控制面板+状态信息区 ==================== -->
        <Grid Grid.Row="2" Height="80">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="350"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：LSC模式控制 + 导航链接 -->
            <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="1" 
                    Background="White" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- LSC模式选择 -->
                    <TextBlock Grid.Column="0" Text="⚙️ LSC模式:" VerticalAlignment="Center" 
                               FontWeight="SemiBold" Foreground="#333333" Margin="0,0,10,0"/>

                    <ComboBox Grid.Column="1" Width="100" Height="34" Margin="0,2,10,2" 
                              HorizontalAlignment="Left" VerticalContentAlignment="Center"
                              SelectedIndex="{Binding SelectedLscMode, Mode=TwoWay}"
                              ToolTip="选择LSC校正模式: Y通道或RGB模式">
                        <ComboBoxItem IsSelected="True" Content="📊 Y通道"/>
                        <ComboBoxItem Content="🌈 RGB模式"/>
                    </ComboBox>

                    <!-- 导航链接 -->
                    <Label Grid.Column="3" VerticalAlignment="Center">
                        <Hyperlink Command="{Binding ViewPreviousIspStepCommand}" 
                                   TextDecorations="Underline">
                            <Run Text="← 查看先行步骤"/>
                        </Hyperlink>
                    </Label>
                </Grid>
            </Border>

            <!-- 右侧：操作指南 + 快速信息 -->
            <Border Grid.Column="2" BorderBrush="#FF0078D7" BorderThickness="1" 
                    Background="#FFF0F8FF" Padding="12,8">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📋 工作流程" FontWeight="SemiBold" FontSize="11" 
                               Foreground="#0078D7" Margin="0,0,0,5"/>
                    <TextBlock Text="1.加载RAW → 2.在原图描点 → 3.计算LSC → 4.查看效果/IQ" 
                               FontSize="10" Foreground="#333333"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 第4行：底部 - 状态栏 ==================== -->
        <StatusBar Grid.Row="3" Margin="0,5,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Text="就绪 - LSC镜头阴影校正工具已就绪"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TxtProgressInfo" Text=""/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="💡 提示: 使用Ctrl+快捷键加速操作 | LSC Lens Shading Correction Tool"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>

