<Window x:Class="ThunderSE.Ui.SettingWindow.YGamma.YGammaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"  
        xmlns:yGamma="clr-namespace:ThunderSE.Ui.SettingWindow.YGamma"
        xmlns:ccc ="clr-namespace:ThunderSE.Ui.CommonCustomControl"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Gamma曲线调试工具" Height="800" Width="1000" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Loaded="OnWindowLoaded" Activated="Window_Activated">
    <Window.Resources>
        <Style x:Key="FullCurveLineStyle" TargetType="ccc:BezierCurveEditor">
            <Setter Property="Background" Value="#1A1A2E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ccc:BezierCurveEditor">
                        <Border Background="{TemplateBinding Background}"
                            CornerRadius="3"
                            Padding="3">
                            <Canvas x:Name="PART_Canvas"
                                ClipToBounds="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 底层曲线样式 -->
        <!--<Style x:Key="FullCurveLineStyle" TargetType="chartingToolkit:LineSeries">
            <Setter Property="DataPointStyle">
                <Setter.Value>
                    <Style TargetType="chartingToolkit:LineDataPoint">
                        <Setter Property="Width" Value="0"/>
                        <Setter Property="Height" Value="0"/>
                        <Setter Property="Opacity" Value="0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>-->

        <!-- 关键点样式 -->
        <!--<Style x:Key="KeyPointLineStyle" TargetType="chartingToolkit:LineSeries">
