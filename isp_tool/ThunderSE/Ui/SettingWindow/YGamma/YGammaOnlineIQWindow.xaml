<Window x:Class="ThunderSE.Ui.SettingWindow.YGamma.YGammaOnlineIQWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:commonCtrls="clr-namespace:ThunderSE.Ui.CommonCustomControl"
        xmlns:datagridTookit="http://schemas.microsoft.com/wpf/2008/toolkit"
        Title="Y-Gamma在线IQ分析工具" Width="800" Height="700" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Background="#FFE5E5E5"
        Loaded="Onloaded" Unloaded="OnUnloaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <!-- 第1行：顶部 - 视频预览区域 -->
            <RowDefinition Height="3*"/>
            <!-- 第2行：中部 - 操作工具栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 第3行：下部 - 数据表格+控制面板 -->
            <RowDefinition Height="1.5*"/>
            <!-- 第4行：底部 - 状态栏 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 第1行：顶部 - 视频预览区域 ==================== -->
        <Border Grid.Row="0" BorderBrush="#FF0078D7" BorderThickness="1" Background="#FFF9F9F9" Margin="0,0,0,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Border Grid.Row="0" Background="#FF0078D7" Padding="8,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎥 实时视频流 (UVC摄像头) - Y-Gamma在线IQ分析" 
                                   Foreground="White" FontWeight="Bold" FontSize="13" 
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtVideoStatus" Text="" 
                                   Foreground="#FFB0E0FF" FontSize="11" 
                                   VerticalAlignment="Center" Margin="15,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 视频显示控件 -->
                <commonCtrls:ImageWithRubberBandControl Grid.Row="1" x:Name="DisplayControl"
                        IsEnabled="{Binding IsDrawing, RelativeSource={RelativeSource Mode=FindAncestor, 
                                    AncestorLevel=1, AncestorType=Window}}"
                        SizeChanged="OnDisplayControlSizeChange"/>

                <!-- 底部提示信息栏 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Background="#FFE8F4FD">
                    <TextBlock Text="💡 操作提示: " VerticalAlignment="Center" 
                               FontWeight="SemiBold" Foreground="#0078D7" Margin="0,0,5,0"/>
                    <TextBlock Text="在视频画面上框选色块区域 | 选择6阶或13阶色卡模式 | 点击'计算IQ'开始分析" 
                               FontSize="11" Foreground="#333333" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 第2行：中部 - 操作工具栏 ==================== -->
        <ToolBarPanel Grid.Row="1" Margin="0,5,0,5">
            <ToolBarTray>
                <ToolBar>
                    <!-- IQ计算操作组 -->
                    <Button x:Name="BtnCalcIQ" Content="🧮 计算IQ" 
                            Click="OnClickCalcIQ"
                            Visibility="{Binding IsDrawing, Converter={StaticResource boolToVisibillityConverter}, 
                                         RelativeSource={RelativeSource Mode=FindAncestor,AncestorLevel=1, AncestorType=Window}}"
                            ToolTip="开始Y-Gamma在线IQ计算 (Enter)" 
                            Padding="10,4" MinWidth="110" FontWeight="Bold"/>

                    <Button x:Name="BtnStopCalc" Content="⏹️ 停止计算" 
                            Click="OnClickStopCalcIQ"
                            Visibility="{Binding IsCalculating, Converter={StaticResource boolToVisibillityConverter}, 
                                         RelativeSource={RelativeSource Mode=FindAncestor,AncestorLevel=1, AncestorType=Window}}"
                            ToolTip="停止当前的IQ计算 (Esc)" 
                            Padding="10,4" MinWidth="110"/>

                    <Separator/>

                    <!-- 编辑操作组 -->
                    <Button x:Name="BtnUndoRubber" Content="↩️ 撤销选框" 
                            Click="OnClickUndoRubberBand"
                            IsEnabled="{Binding IsDrawing, 
                                        RelativeSource={RelativeSource Mode=FindAncestor,AncestorLevel=1, AncestorType=Window}}"
                            ToolTip="撤销上一次的色块选区操作 (Ctrl+Z)" 
                            Padding="10,4" MinWidth="110"/>

                    <Separator/>

                    <!-- 显示操作组 -->
                    <Button x:Name="BtnShowChart" Content="📊 显示图表" 
                            Click="OnClickShowGammaChart"
                            ToolTip="打开Y-Gamma曲线图表窗口 (Ctrl+G)" 
                            Padding="10,4" MinWidth="120"/>

                    <Separator/>

                    <!-- 状态指示器 -->
                    <TextBlock Text="色卡:" VerticalAlignment="Center" Margin="10,0,3,0" 
                               FontWeight="SemiBold" Foreground="#333333" FontSize="11"/>

                    <ComboBox Width="60"
                              IsEnabled="{Binding IsDrawing, 
                                          RelativeSource={RelativeSource Mode=FindAncestor,AncestorLevel=1, AncestorType=Window}}"
                              SelectedIndex="{Binding SelectedCalcMode, Mode=TwoWay, UpdateSourceTrigger=LostFocus,
                                          RelativeSource={RelativeSource Mode=FindAncestor,AncestorLevel=1, AncestorType=Window}}"
                              ToolTip="选择色卡阶数: 6阶(6个色块) 或 13阶(13个色块)">
                        <ComboBoxItem Content="6阶"/>
                        <ComboBoxItem Content="13阶"/>
                    </ComboBox>

                    <TextBlock x:Name="TxtCalcStatus" Text="" 
                               VerticalAlignment="Center" Margin="15,0,0,0" 
                               FontSize="11" FontWeight="SemiBold" Foreground="#0078D7"/>
                </ToolBar>
            </ToolBarTray>
        </ToolBarPanel>

        <!-- ==================== 第3行：下部 - 数据表格+控制面板 ==================== -->
        <Border Grid.Row="2" BorderBrush="#FF0078D7" BorderThickness="1" Background="#FFFAFAFA" Margin="0,0,0,5">
            <Grid Margin="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 区域标题 -->
                <Border Grid.Row="0" Background="#FF0078D7" Padding="6,4" Margin="0,0,0,5">
                    <TextBlock Text="📋 Y-Gamma IQ计算结果" 
                               Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>

                <!-- DataGrid数据表格（增强版） -->
                <datagridTookit:DataGrid Grid.Row="1" 
                                     ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}" 
                                     AutoGenerateColumns="False"  
                                     ItemsSource="{Binding}"
                                     IsReadOnly="True"
                                     SelectionMode="Single"
                                     GridLinesVisibility="All"
                                     HorizontalGridLinesBrush="#FFE0E0E0"
                                     VerticalGridLinesBrush="#FFE0E0E0"
                                     RowBackground="White"
                                     AlternatingRowBackground="#FFFAFAFA"
                                     BorderThickness="1"
                                     BorderBrush="#FFCCCCCC"
                                     ToolTip="显示Y-Gamma在线IQ计算的详细结果参数">
                    <datagridTookit:DataGrid.CellStyle>
                        <Style TargetType="datagridTookit:DataGridCell">
                            <Setter Property="Block.TextAlignment" Value="Center"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FFE8F4FD"/>
                                    <Setter Property="Foreground" Value="#FF0078D7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </datagridTookit:DataGrid.CellStyle>

                    <datagridTookit:DataGrid.Columns>
                        <datagridTookit:DataGridTextColumn Width="200" Binding="{Binding Key}" IsReadOnly="True" Header="📝 参数项">
                            <datagridTookit:DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#333333"/>
                                </Style>
                            </datagridTookit:DataGridTextColumn.ElementStyle>
                        </datagridTookit:DataGridTextColumn>

                        <datagridTookit:DataGridTextColumn Width="*" Binding="{Binding Value}" IsReadOnly="True" Header="📊 计算值">
                            <datagridTookit:DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#0078D7"/>
                                </Style>
                            </datagridTookit:DataGridTextColumn.ElementStyle>
                        </datagridTookit:DataGridTextColumn>
                    </datagridTookit:DataGrid.Columns>
                </datagridTookit:DataGrid>
            </Grid>
        </Border>

        <!-- ==================== 第4行：底部 - 状态栏 ==================== -->
        <StatusBar Grid.Row="3" Margin="0,3,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Text="就绪 - Y-Gamma在线IQ分析工具已就绪"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TxtProgressInfo" Text=""/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="💡提示: Enter=计算 Esc=停止 Ctrl+G=图表 | Y-Gamma Online IQ Analysis Tool"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>

