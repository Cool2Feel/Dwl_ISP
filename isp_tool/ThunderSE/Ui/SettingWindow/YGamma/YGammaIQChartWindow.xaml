<Window x:Class="ThunderSE.Ui.SettingWindow.YGamma.YGammaIQChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chartingToolkit="clr-namespace:System.Windows.Controls.DataVisualization.Charting;assembly=System.Windows.Controls.DataVisualization.Toolkit" 
        xmlns:datavis="clr-namespace:System.Windows.Controls.DataVisualization;assembly=System.Windows.Controls.DataVisualization.Toolkit"    
        Title="YGamma IQ曲线分析" Width="800" Height="600"
        MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip" Loaded="OnLoaded">
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <!-- 第1行：顶部 - 图表显示区域 + 参数信息面板 -->
            <RowDefinition Height="*"/>
            <!-- 第2行：中部 - 操作工具栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 第3行：下部 - 数据统计信息区 -->
            <RowDefinition Height="Auto"/>
            <!-- 第4行：底部 - 状态栏 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 第1行：顶部区域 ==================== -->
        <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：YGamma曲线图表区 -->
            <Border Grid.Column="0" BorderBrush="#FF0078D7" BorderThickness="1" Background="#FFF9F9F9">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 图表标题栏 -->
                    <Border Grid.Row="0" Background="#FF0078D7" Padding="3">
                        <TextBlock Text="📈 YGamma IQ曲线分析 (YAvg vs Gamma)" 
                                   Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>

                    <!-- 图表主体控件 -->
                    <chartingToolkit:Chart Name="YGammaChart" Grid.Row="1" BorderThickness="0" 
                                          Style="{DynamicResource ChartStyle1}">
                        <chartingToolkit:Chart.Axes>
                            <chartingToolkit:LinearAxis Orientation="X" Minimum="0" 
                                                        Maximum="{Binding MaxItemCount, 
                                        RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Window, AncestorLevel=1}}" />
                            <chartingToolkit:LinearAxis Orientation="Y" Minimum="0" Maximum="1" />
                        </chartingToolkit:Chart.Axes>
                        <chartingToolkit:Chart.LegendStyle>
                            <Style TargetType="datavis:Legend">
                                <Setter Property="Width" Value="0" />
                            </Style>
                        </chartingToolkit:Chart.LegendStyle>
                        <chartingToolkit:LineSeries Name="YAvgLine" 
                                                   ItemsSource="{Binding yAvg}" 
                                                   DependentValuePath="Value" 
                                                   IndependentValuePath="Key" 
                                                   IsSelectionEnabled="True" 
                                                   TransitionDuration="0"
                                                   DataPointStyle="{DynamicResource LineDataPointStyle1}"/>
                        <chartingToolkit:LineSeries Name="OutGammaLine" 
                                                    ItemsSource="{Binding GammaLineData, RelativeSource={RelativeSource Mode=FindAncestor,AncestorType=Window, AncestorLevel=1}}" 
                                                    DependentValuePath="Value" 
                                                    IndependentValuePath="Key" 
                                                    IsSelectionEnabled="True" 
                                                    TransitionDuration="0"
                                                    DataPointStyle="{DynamicResource LineDataPointStyle2}"/>
                    </chartingToolkit:Chart>

                    <!-- 图表状态提示栏 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Background="#FFE0E0E0">
                        <TextBlock Text="💡 提示: " VerticalAlignment="Center" Margin="0,0,3,0"/>
                        <TextBlock Text="蓝色线: YAvg实际值 | 橙色线: OutGamma理论值 | 右键拖拽平移 | 滚轮缩放" 
                                   FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右侧：参数信息面板 -->
            <Border Grid.Column="2" BorderBrush="#FF0078D7" BorderThickness="1" Background="#FFFAFAFA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 面板标题 -->
                    <Border Grid.Row="0" Background="#FF0078D7" Padding="3">
                        <TextBlock Text="📊 参数与统计信息" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>

                    <!-- TabControl信息组 -->
                    <TabControl Name="InfoTabs" Grid.Row="1" 
                                Style="{DynamicResource TabControlStyle1}" 
                                SelectedIndex="0" Background="Transparent" 
                                BorderThickness="0" Margin="5">

                        <!-- Tab 1: 参数显示 -->
                        <TabItem Header="📐 参数信息">
                            <StackPanel Background="Transparent">
                                <TextBlock Text="YGamma参数配置" FontWeight="SemiBold" 
                                           Margin="0,10,0,8" Foreground="#333333" FontSize="11"/>

                                <Border Background="#FFFAFAFA" BorderBrush="#FFE0E0E0" 
                                        BorderThickness="1" Padding="10" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="MaxItemCount:" FontWeight="SemiBold" 
                                                   FontSize="11" Foreground="#333333" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="TxtMaxItemCount" Text="15" 
                                                   FontSize="14" Foreground="#0078D7" FontWeight="Bold"/>

                                        <Separator Margin="0,10,0,10"/>

                                        <TextBlock Text="OutGamma值:" FontWeight="SemiBold" 
                                                   FontSize="11" Foreground="#333333" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="TxtOutGamma" Text="--" 
                                                   FontSize="14" Foreground="#0078D7" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>

                                <Separator Margin="0,12,0,12"/>

                                <TextBlock Text="曲线说明" FontWeight="SemiBold" 
                                           Margin="0,0,0,8" Foreground="#333333" FontSize="11"/>

                                <Border Background="#FFF0F8FF" BorderBrush="#FF0078D7" 
                                        BorderThickness="1" Padding="8">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <Border Width="16" Height="4" Background="#FF0078D7" 
                                                    Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="YAvg 实际测量曲线" FontSize="10" 
                                                       Foreground="#333333" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="16" Height="4" Background="#FFFF6B35" 
                                                    Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="OutGamma 理论Gamma曲线" FontSize="10" 
                                                       Foreground="#333333" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- Tab 2: 数据统计 -->
                        <TabItem Header="📈 数据统计">
                            <StackPanel Background="Transparent">
                                <TextBlock Text="曲线数据点统计" FontWeight="SemiBold" 
                                           Margin="0,10,0,8" Foreground="#333333" FontSize="11"/>

                                <Border Background="#FFFAFAFA" BorderBrush="#FFE0E0E0" 
                                        BorderThickness="1" Padding="10" Margin="0,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="YAvg数据点数:" FontWeight="SemiBold" 
                                                   FontSize="11" Foreground="#333333" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="TxtYAvgCount" Text="0" 
                                                   FontSize="13" Foreground="#0078D7" FontWeight="SemiBold"/>

                                        <Separator Margin="0,8,0,8"/>

                                        <TextBlock Text="Gamma数据点数:" FontWeight="SemiBold" 
                                                   FontSize="11" Foreground="#333333" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="TxtGammaCount" Text="0" 
                                                   FontSize="13" Foreground="#0078D7" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                                <Separator Margin="0,12,0,12"/>

                                <!-- 处理状态指示器 -->
                                <Border Background="#FFF0F8FF" BorderBrush="#FF0078D7" 
                                        BorderThickness="1" Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="📊 当前状态" FontWeight="SemiBold" 
                                                   FontSize="11" Foreground="#0078D7" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="TxtProcessingStatus" Text="等待数据加载..." 
                                                   FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 第2行：中部操作工具栏 ==================== -->
        <ToolBarPanel Grid.Row="1" Margin="0,5,0,5">
            <ToolBarTray>
                <ToolBar>
                    <Button x:Name="BtnRefreshData" Content="🔄 刷新数据" 
                            Click="OnRefreshDataClick"
                            ToolTip="刷新并重新加载图表数据 (F5)" Padding="10,4" MinWidth="110"/>
                    <Separator/>
                    <Button x:Name="BtnZoomIn" Content="🔍+ 放大" 
                            Click="OnZoomInClick"
                            ToolTip="放大图表视图 (Ctrl++)" Padding="10,4" MinWidth="100"/>
                    <Button x:Name="BtnZoomOut" Content="🔍- 缩小" 
                            Click="OnZoomOutClick"
                            ToolTip="缩小图表视图 (Ctrl+-)" Padding="10,4" MinWidth="100"/>
                    <Separator/>
                    <Button x:Name="BtnResetView" Content="🎯 重置视图" 
                            Click="OnResetViewClick"
                            ToolTip="重置图表到默认视图 (Ctrl+R)" Padding="10,4" MinWidth="110"/>
                    <Button x:Name="BtnExportImage" Content="💾 导出图像" 
                            Click="OnExportImageClick"
                            ToolTip="导出当前图表为图片文件 (Ctrl+S)" Padding="10,4" MinWidth="110"/>
                    <Separator/>

                    <!-- 状态指示器 -->
                    <TextBlock x:Name="TxtOperationStatus" Text="就绪" 
                               VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"
                               Foreground="#666666"/>
                </ToolBar>
            </ToolBarTray>
        </ToolBarPanel>

        <!-- ==================== 第3行：下部状态信息区 ==================== -->
        <Grid Grid.Row="2" Height="45">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：导航链接区 -->
            <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="1" 
                    Background="White" Padding="3">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📍 导航: " VerticalAlignment="Center" 
                               Foreground="#666666" Margin="0,0,8,0"/>
                    <TextBlock Text="YGamma模块 - IQ曲线分析与验证" 
                               VerticalAlignment="Center" FontSize="11" 
                               Foreground="#333333" FontStyle="Italic"/>
                    <TextBlock Text=" | " VerticalAlignment="Center" 
                               Foreground="#CCCCCC" Margin="5,0"/>
                    <TextBlock x:Name="TxtModuleStatus" Text="图表模式" 
                               VerticalAlignment="Center" FontSize="11" 
                               Foreground="#0078D7" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- 右侧：快速信息面板 -->
            <Border Grid.Column="2" BorderBrush="#FF0078D7" BorderThickness="1" 
                    Background="#FFF0F8FF" Padding="3">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="📊 数据范围" FontWeight="SemiBold" FontSize="11" 
                               Foreground="#0078D7" Margin="0,0,0,3"/>
                    <TextBlock x:Name="TxtDataRange" Text="X轴: 0-15 | Y轴: 0-1.0" FontSize="10" 
                               Foreground="#333333"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ==================== 第4行：底部状态栏 ==================== -->
        <StatusBar Grid.Row="3" Margin="0,3,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Text="就绪 - YGamma IQ曲线分析工具已就绪"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TxtWindowSize" Text=""/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="💡 提示: F5刷新 | Ctrl+S导出 | 滚轮缩放"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>

