<Window x:Class="ThunderSE.Ui.SettingWindow.Ccm.CcmOnlineIQWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:commonCtrls="clr-namespace:ThunderSE.Ui.CommonCustomControl"
        xmlns:datagridTookit="http://schemas.microsoft.com/wpf/2008/toolkit"
        Title="CCM色彩校正调试" Height="800" Width="1000" ResizeMode="NoResize" Background="#FFE5E5E5"
        Loaded="Onloaded" Unloaded="OnUnloaded" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="boolToVisibillityConverter"></BooleanToVisibilityConverter>
    </Window.Resources>
    <!--<Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"></RowDefinition>
            <RowDefinition Height="2.3*"></RowDefinition>
            <RowDefinition Height="0.7*"></RowDefinition>
