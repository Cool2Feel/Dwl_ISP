                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnClose" ToolTip="关闭窗口 (Esc)" Width="70" Content="关闭"></Button>
