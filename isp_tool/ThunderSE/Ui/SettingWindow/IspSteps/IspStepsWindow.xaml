<Window x:Class="ThunderSE.Ui.SettingWindow.IspSteps.IspStepsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:isp="clr-namespace:ThunderSE.DeviceConfig.Isp"
        xmlns:ispSteps="clr-namespace:ThunderSE.Ui.SettingWindow.IspSteps"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        Title="ISP 步骤配置" Height="540" Width="350" 
        Background="#FFE5E5E5" Loaded="OnWindowLoaded" Closing="OnClosing">
    <Window.Resources>
        <ispSteps:OptionEnableConverter x:Key="optionEnableConverter"></ispSteps:OptionEnableConverter>
        <ispSteps:NavigateCommandParamConverter x:Key="navigateCommandParamConverter"></ispSteps:NavigateCommandParamConverter>
        <ispSteps:ModuleStatusConverter x:Key="moduleStatusConverter"></ispSteps:ModuleStatusConverter>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28"></Setter>
            <Setter Property="Padding" Value="12,0"></Setter>
            <Setter Property="Margin" Value="6,4"></Setter>
            <Setter Property="Background" Value="#FFFFFFFF"></Setter>
            <Setter Property="Foreground" Value="#FF333333"></Setter>
            <Setter Property="BorderBrush" Value="#FFDDDDDD"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="Cursor" Value="Hand"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"></ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE8F4FD"></Setter>
                                <Setter Property="BorderBrush" Value="#FF0078D7"></Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFCCE8F5"></Setter>
                                <Setter Property="BorderBrush" Value="#FF005A9E"></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModuleItemStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFFFF"></Setter>
            <Setter Property="BorderBrush" Value="#FFE0E0E0"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="CornerRadius" Value="4"></Setter>
            <Setter Property="Padding" Value="10,6"></Setter>
            <Setter Property="Margin" Value="4,2"></Setter>
        </Style>

        <Style x:Key="ModuleCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="Margin" Value="0,0,10,0"></Setter>
            <Setter Property="Cursor" Value="Hand"></Setter>
        </Style>

        <Style x:Key="ModuleLinkStyle" TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="Foreground" Value="#FF0078D7"></Setter>
            <Setter Property="FontWeight" Value="SemiBold"></Setter>
            <Setter Property="Cursor" Value="Hand"></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF0078D7" CornerRadius="6,6,0,0" Padding="3">
            <TextBlock Text="ISP 步骤配置" FontSize="14" FontWeight="Bold" Foreground="#FFFFFFFF"></TextBlock>
        </Border>

        <Border Grid.Row="1" Background="#FFFFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,1" Padding="3">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnSelectAll" ToolTip="选择所有模块 (Ctrl+A)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Margin="0,0,6,0" FontWeight="Bold" Foreground="#FF107C10"></TextBlock>
                        <TextBlock Text="全选"></TextBlock>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButtonStyle}" Click="OnUnSelectAll" ToolTip="取消所有模块 (Ctrl+D)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✗" Margin="0,0,6,0" FontWeight="Bold" Foreground="#FFD13438"></TextBlock>
                        <TextBlock Text="全不选"></TextBlock>
                    </StackPanel>
                </Button>
                <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed" Foreground="#FF666666" FontSize="11">
                    <Run Text="快捷键: "></Run>
                    <Run Text="Ctrl+A 全选 | Ctrl+D 取消" Foreground="#FF888888"></Run>
                </TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="#FFFFFFFF" CornerRadius="0,0,6,6" BorderBrush="#FFE0E0E0" BorderThickness="1,0,1,1" Padding="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl Background="#FFF5F5F5">
                    <ItemsControl.ItemContainerStyle>
                        <Style>
                            <Setter Property="FrameworkElement.Margin" Value="0,2"></Setter>
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <Border Style="{StaticResource ModuleItemStyle}">
                        <Grid IsEnabled="{Binding CurrentSettingModule, Converter={StaticResource optionEnableConverter}, ConverterParameter='Blc'}">
                            <Label Style="{StaticResource ModuleLinkStyle}" HorizontalAlignment="Left">
                                <Hyperlink IsEnabled="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Label, AncestorLevel=1}, Path=IsEnabled}"
                                          Command="{Binding NavigateToModuleCommand}" CommandParameter="{x:Static isp:IspModule.Blc}"
                                          TextDecorations="None" Foreground="#FF0078D7">
                                    <Hyperlink.Style>
                                        <Style TargetType="Hyperlink">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="#FF005A9E"></Setter>
                                                <Setter Property="TextDecorations" Value="Underline"></Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                        </Style>
                                    </Hyperlink.Style>
                                    <Run Text="Blc (黑电平校正)"></Run>
                                </Hyperlink>
                            </Label>
                            <CheckBox Style="{StaticResource ModuleCheckBoxStyle}" HorizontalAlignment="Right" 
                                     IsChecked="{Binding IsBlcSelected, Mode=TwoWay}" ToolTip="选择/取消 Blc 模块"></CheckBox>
                            <Label HorizontalAlignment="Right" Margin="0,0,30,0" VerticalAlignment="Center" Foreground="#FF888888" FontSize="10">
                                <Run Text="{Binding BlcStatus, Converter={StaticResource moduleStatusConverter},Mode=OneWay}"></Run>
                            </Label>
                        </Grid>
                    </Border>

