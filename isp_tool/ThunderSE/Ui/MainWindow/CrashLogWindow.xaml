<Window x:Class="ThunderSE.Ui.CrashLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="崩溃日志查看器" 
        Height="600" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="💥 崩溃日志查看器" 
                       FontSize="20" 
                       FontWeight="Bold"
                       Foreground="#D32F2F"
                       Margin="0,0,0,5"/>
            <TextBlock Text="以下是程序崩溃时的详细日志信息，请将此信息发送给开发人员以帮助修复问题。" 
                       FontSize="12"
                       Foreground="#666"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 日志内容显示 -->
        <Border Grid.Row="1" 
                BorderBrush="#DDD" 
                BorderThickness="1" 
                Background="White"
                CornerRadius="4">
            <TextBox x:Name="txtLogContent"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas"
                     FontSize="11"
                     Padding="10"
                     BorderThickness="0"
                     Background="White"/>
        </Border>

        <!-- 按钮栏 -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button x:Name="btnCopy" 
                    Content="📋 复制日志" 
                    Width="100"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="BtnCopy_Click"
                    Background="#2196F3"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
            <Button x:Name="btnOpenFolder" 
                    Content="📂 打开日志目录" 
                    Width="120"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="BtnOpenFolder_Click"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
            <Button x:Name="btnClose" 
                    Content="❌ 关闭" 
                    Width="100"
                    Height="30"
                    Click="BtnClose_Click"
                    Background="#9E9E9E"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
