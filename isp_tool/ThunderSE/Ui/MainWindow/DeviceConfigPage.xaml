<UserControl x:Class="ThunderSE.Ui.MainWindow.DeviceConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:MainWindow="clr-namespace:ThunderSE.Ui.MainWindow"
             xmlns:CV="clr-namespace:ThunderSE.Ui.Converter"
             xmlns:Isp="clr-namespace:ThunderSE.DeviceConfig.Isp"
             mc:Ignorable="d"
             d:DesignHeight="2600"
             d:DesignWidth="1024"
             HorizontalContentAlignment="Stretch"
             Loaded="OnLoaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="boolToVisibillityConverter"></BooleanToVisibilityConverter>
        <CV:UvcViewVisibilityConverter x:Key="uvcViewVisibilityConverter"></CV:UvcViewVisibilityConverter>
        <CV:SetModeToVisibilityConverter x:Key="setModeToVisibilityConverter"/>
        <CV:DecimalToHexConverter x:Key="decimalToHexConverter"></CV:DecimalToHexConverter>
        <CV:EnumToBooleanConverter x:Key="enumToBooleanConverter"/>
        <CV:IndexToColorConverter x:Key="IndexToColorConverter"/>
        <RoutedUICommand x:Key="SettingDetailCommand"></RoutedUICommand>
        <RoutedUICommand x:Key="SettingOutputCommand"></RoutedUICommand>
        <RoutedUICommand x:Key="OpenDevicePropertyCommand"></RoutedUICommand>
        <CV:PlayNavigateAnimationConverter x:Key="playNavigateAnimationConverter"></CV:PlayNavigateAnimationConverter>
        <CV:ModuleEnableStatusConverter x:Key="moduleEnableStatusConverter"/>
        <CV:ModuleEnableStatusColorConverter x:Key="moduleEnableStatusColorConverter"/>
        <Storyboard x:Key="FadeOutAnimationStoryBoard">
            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                        AutoReverse="True"
                        From="Transparent" To="Black" Completed="ModuleBorderLoaded"/>
        </Storyboard>
        <!-- 自定义下划线参数 -->
        <Thickness x:Key="UnderlineMargin">0,1,5,1</Thickness>
        <SolidColorBrush x:Key="UnderlineBrush" Color="Green"/>
        <CornerRadius x:Key="UnderlineCornerRadius">1</CornerRadius>
        <!-- 带下划线的参数标签样式 -->
        <Style x:Key="SimpleUnderlinedParamLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Height" Value="27"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ContentPresenter x:Name="contentPresenter"
                                Grid.Row="0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                            <!-- 下划线，宽度自动匹配内容宽度 -->
                            <Border Grid.Row="1"
                                Height="1"
                                MinWidth="{Binding ActualWidth, ElementName=contentPresenter}"
                                Margin="{StaticResource UnderlineMargin}"
                                CornerRadius="{StaticResource UnderlineCornerRadius}"
                                Background="{StaticResource UnderlineBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <UserControl.CommandBindings>
        <CommandBinding Command="{StaticResource SettingDetailCommand}" Executed="OpenSetttingWindow"></CommandBinding>
        <CommandBinding Command="{StaticResource SettingOutputCommand}" Executed="OutputCurrentDateConfig"></CommandBinding>
        <CommandBinding Command="{StaticResource OpenDevicePropertyCommand}" Executed="OpenDevicePropertyWindow"></CommandBinding>
    </UserControl.CommandBindings>
    <UserControl.InputBindings>
        <KeyBinding Command="{StaticResource OpenDevicePropertyCommand}" Key="P" Modifiers="Control+Shift"/>
    </UserControl.InputBindings>
    <Grid Background="#FFF5F5F5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>
        
        <!-- ==================== 顶部专业工具栏 ==================== -->
        <Border Grid.Row="0" BorderBrush="#FF0078D7" BorderThickness="0,0,0,1" Background="#FFFAFAFA">
            <Grid Margin="0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                
                <!-- 左侧：配置操作按钮组 -->
                <StackPanel Grid.Column="0" Background="Transparent" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Button Margin="5,0,0,0" Padding="8,4" Command="{Binding ReloadConfigCommand}" 
                            ToolTip="重新从设备读取配置 (F5)"
                            Background="#FFF9F9F9" BorderBrush="#FFCCCCCC"
                            Content="🔄 重新读取"/>
                    <Button Margin="10,0,0,0" Padding="8,4" Command="{Binding WriteConfigCommand}"
                            Visibility="{Binding IsOnline, Converter={StaticResource boolToVisibillityConverter}}" 
                            ToolTip="将配置写入设备 (Ctrl+S)"
                            Background="#FF0078D7" Foreground="White" FontWeight="SemiBold"
                            BorderBrush="#FF005A9E"
                            Content="💾 写入"/>
                    <Button Margin="10,0,0,0" Padding="8,4" Command="{Binding WriteConfigCommand}"
                            Visibility="{Binding IsOffline,Converter={StaticResource boolToVisibillityConverter}}"
                            ToolTip="保存当前离线配置 (Ctrl+S)"
                            Background="#FF0078D7" Foreground="White" FontWeight="SemiBold"
                            BorderBrush="#FF005A9E"
                            Content="💾 保存"/>
                    <Button Margin="10,0,0,0" Visibility="{Binding IsOnline, Converter={StaticResource boolToVisibillityConverter}}" 
                            Command="{Binding SaveConfigAsCommand}"
                            ToolTip="将当前配置保存到文件 (Ctrl+Shift+S)"
                            Background="#FFF9F9F9" BorderBrush="#FFCCCCCC"
                            Content="📁 保存到文件"/>
                    <Button Margin="10,0,0,0" Visibility="{Binding IsOnline, Converter={StaticResource boolToVisibillityConverter}}" 
                            Command="{Binding LoadConfigCommand}"
                            ToolTip="从文件读取数据配置 (Ctrl+Shift+L)"
                            Background="#FFF9F9F9" BorderBrush="#FFCCCCCC"
                            Content="📁 读取"/>

                    <Button Margin="10,0,0,0" Visibility="{Binding IsOnline, Converter={StaticResource boolToVisibillityConverter}}" 
                            Command="{StaticResource OpenDevicePropertyCommand}"
                            ToolTip="打开设备的属性设置页面 (Ctrl+Shift+P)"
                            Background="#FFF9F9F9" BorderBrush="#FFCCCCCC"
                            Content="🎛️ 属性设置"/>
                    <Button Margin="10,0,0,0" Visibility="{Binding IsOffline, Converter={StaticResource boolToVisibillityConverter}}" 
                            Command="{Binding LoadConfigCommand}"
                            ToolTip="从文件加载配置 (Ctrl+Shift+L)"
                            Background="#FFF9F9F9" BorderBrush="#FFCCCCCC"
                            Content="📁 读取"/>
                    <Button Margin="10,0,0,0" Visibility="{Binding IsOffline, Converter={StaticResource boolToVisibillityConverter}}" 
                            Command="{Binding SaveConfigAsCommand}"
                            ToolTip="另存为新配置文件 (Ctrl+Shift+S)"
                            Background="#FFF9F9F9" BorderBrush="#FFCCCCCC"
                            Content="📁 另存为"/>
                    <Separator Margin="10,5" VerticalAlignment="Stretch" Background="#FFCCCCCC"/>
                    <Button Margin="10,0,0,0" Click="OnClickCloseTab"
                            Visibility="{Binding IsOffline,Converter={StaticResource boolToVisibillityConverter}}" 
                            ToolTip="关闭此配置标签页"
                            Background="#FFFFEEEE" BorderBrush="#FFCC0000" Foreground="#CC0000"
                            Content="❌ 关闭"/>
                </StackPanel>
                
                <!-- 中间：模式指示器 -->
                <StackPanel Grid.Column="1" Background="Transparent" Orientation="Horizontal" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#FFF0F8FF" BorderBrush="#FF0078D7" BorderThickness="1" 
                            CornerRadius="3" Padding="8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtModeIndicator" Text="📡 " FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtModeStatus" Text="在线模式" FontWeight="SemiBold" 
                                       FontSize="11" Foreground="#0078D7" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- 右侧：UVC视图控制按钮组 -->
                <StackPanel Grid.Column="2"  Visibility="{Binding IsOnline,Converter={StaticResource boolToVisibillityConverter}}"
                            Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Button Margin="0,0,0,0" Padding="8,4" Click="OnClickShowUvcView" 
                            Visibility="{Binding ShowUvcView, 
                                                 Mode=TwoWay,
                                                 RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=1},
                                                 Converter={StaticResource uvcViewVisibilityConverter},
                                                 ConverterParameter=ShowButton}"
                            ToolTip="展开UVC视频预览面板"
                            Background="#FFF9F9F9" BorderBrush="#FFCCCCCC"
                            Content="📹 展开UVCView"/>
                    <Button Margin="0,0,0,0" Padding="8,4" Click="OnClickHideUvcView" 
                            Visibility="{Binding ShowUvcView,
                                                 Mode=TwoWay,
                                                 RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=1},
                                                 Converter={StaticResource uvcViewVisibilityConverter},
                                                 ConverterParameter=HideButton}"
                            ToolTip="收起UVC视频预览面板"
                            Background="#FFF9F9F9" BorderBrush="#FFCCCCCC"
                            Content="🔽 收起UVCView"/>
                    <Separator Margin="8,5" VerticalAlignment="Stretch" Background="#FFCCCCCC"/>
                    <Button Margin="8,0,0,0" Padding="8,4" Click="OnClickShowUvcInNewWindow" 
                            ToolTip="在独立窗口中打开UVC预览"
                            Background="#FF0078D7" Foreground="White" FontWeight="SemiBold"
                            BorderBrush="#FF005A9E"
                            Content="🚀 弹出窗口"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <ScrollViewer x:Name="ModuleScrollView" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical" Background="Transparent" Margin="2,2,2,0" MinWidth="{Binding ActualWidth, ElementName=ModuleScrollView}">
                    <!-- Common 模块 -->
                    <Border Style="{StaticResource ModuleBorderStyle}">
                        <Grid Name="General" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>

                            <Label Content="Common" Style="{StaticResource ModuleLabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="(ON)" Foreground="#4CAF50" FontSize="10" HorizontalAlignment="Center" Grid.Column="0" Margin="0,28,0,0"/>

                            <StackPanel Orientation="Vertical" Grid.Column="1">
                                <!-- 基础信息 -->
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="Name :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Width="100" Text="{Binding Name, Mode=TwoWay}"
                                         IsEnabled="{Binding IsOffline}"/>
                                    <!--<Label Content="ID :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Width="100" Text="{Binding Id, Mode=TwoWay}"
                                         IsEnabled="{Binding IsOffline}"/>-->
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="Type :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Width="100" Text="{Binding Type, Mode=TwoWay}"
                                         IsEnabled="{Binding IsOffline}"/>
                                    <Label Content="Bayer :" Style="{StaticResource ParamLabelStyle}"/>
                                    <ComboBox Width="100" Margin="0,2,8,2" HorizontalAlignment="Left"
                                          ItemsSource="{Binding BayerPatterns}"
                                          DisplayMemberPath="Key"
                                          SelectedIndex="{Binding SelectedBayerPattern, Mode=TwoWay}"
                                          IsEnabled="{Binding IsOffline}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="Resolution :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Label Content="Width :" Style="{StaticResource ParamLabelStyle}" Width="70"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Width="80" Text="{Binding ResolutionWidth, Mode=TwoWay}" IsEnabled="{Binding IsOffline}"/>
                                    <Label Content="Height :" Style="{StaticResource ParamLabelStyle}" Width="70"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Width="80" Text="{Binding ResolutionHeight, Mode=TwoWay}" IsEnabled="{Binding IsOffline}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="Enables :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Click="OnClickShowEnables">查看 enables 列表</Button>
                                </StackPanel>

                                <!-- 曝光控制 -->
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="Exp Gain:" Style="{StaticResource ParamLabelStyle}"/>
                                    <!--<TextBox Style="{StaticResource ParamTextBoxStyle}" Width="100" Text="{Binding ExpGain, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>-->

                                    <CheckBox Style="{StaticResource ParamCheckBoxStyle}" Margin="0,5,4,3" IsChecked="{Binding IsExpGainEnable, Mode=TwoWay}">启用 ExpGain</CheckBox>

                                    <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}" Visibility="{Binding IsExpGainEnable, Converter={StaticResource boolToVisibilityConverter}}">
                                        <Label Content="Turn Gain:" Style="{StaticResource ParamLabelStyle}" Width="70"/>
                                        <TextBox Style="{StaticResource ParamTextBoxStyle}" Width="80" Text="{Binding TurnGain, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                        <Label Content="Turn Exp:" Width="60" Style="{StaticResource ParamLabelStyle}" />
                                        <TextBox Style="{StaticResource ParamTextBoxStyle}" Width="80" Text="{Binding TurnExp, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>

                                        <Button Style="{StaticResource ParamButtonStyle}" Margin="5,0,0,0" Click="OnClickShowExpGainSettingWindow"
                                                Visibility="{Binding IsOnline, Converter={StaticResource boolToVisibilityConverter}}">
                                            在线调试...
                                        </Button>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 时钟配置 -->
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <CheckBox Style="{StaticResource ParamCheckBoxStyle}" Margin="100,0,10,0" IsChecked="{Binding IsPclkFirEn, Mode=TwoWay}">
                                        pclk_fir_en
                                    </CheckBox>
                                    <CheckBox Style="{StaticResource ParamCheckBoxStyle}" Margin="30,0,12,0" IsChecked="{Binding IsPclkInvEn, Mode=TwoWay}">
                                        pclk_inv_en
                                    </CheckBox>
                                    <Label Content="pclk_fir_class :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}"  Text="{Binding PclkFirClass, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="csi_tun :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding CsiTun, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                    <Label Content="hsyn :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding Hsyn, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                    <Label Content="vsyn :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding Vsyn, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="rotate :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding Rotate, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                    <Label Content="mclk :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Width="100" Text="{Binding Mclk, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="AVDD :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding AVDD, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                    <Label Content="DVDD :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding DVDD, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                    <Label Content="VDDIO :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding VDDIO, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="v_len :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding Vlen, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                    <Label Content="down_fps_mode :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding DownFpsMode, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                    <Label Content="fps :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding Fps, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="frequency :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding Frequency, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                    <Label Content="pclk :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Width="100" Text="{Binding Pclk, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                    
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}" Visibility="Collapsed">
                                    <Label Content="iicInfor :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding IICInfor, Mode=OneWay}"/>
                                    
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="mipiRxClkDiv :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding MipiRxClkDiv, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                    <Label Content="mipiDRperlane :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding MipiDRperlane, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="mipiHbpTime :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding MipiHbpTime, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                    <Label Content="mipiHsaTime :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding MipiHsaTime, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="ISP Ver :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" IsReadOnly="True" IsEnabled="False" Text="{Binding IspVer, Mode=OneWay, Converter={StaticResource decimalToHexConverter}}" KeyDown="OnTextBoxKeyDown"/>
                                    <Label Content="Current‌ Gain :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" IsReadOnly="True" IsEnabled="False" Text="{Binding CurGain, Mode=OneWay}" KeyDown="OnTextBoxKeyDown"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}"  Margin="0,3,0,3" VerticalAlignment="Center">
                                    <Label Content="Set Mode :" Style="{StaticResource ParamLabelStyle}"/>
                                    <RadioButton Content="RAW8" GroupName="SetMode" Margin="8,5,20,0" VerticalAlignment="Center" 
                                                 IsChecked="{Binding SetMode, Mode=TwoWay, Converter={StaticResource enumToBooleanConverter}, ConverterParameter=RAW8}"/>
                                    <RadioButton Content="RAW10" GroupName="SetMode" Margin="8,5,20,0" VerticalAlignment="Center" 
                                                 IsChecked="{Binding SetMode, Mode=TwoWay, Converter={StaticResource enumToBooleanConverter}, ConverterParameter=RAW10}"/>
                                    <RadioButton Content="MJPG" GroupName="SetMode" Margin="8,5,20,0" VerticalAlignment="Center" 
                                                 IsChecked="{Binding SetMode, Mode=TwoWay, Converter={StaticResource enumToBooleanConverter}, ConverterParameter=MJPG}"/>
                                    <RadioButton Content="YUV" GroupName="SetMode" Margin="8,5,10,0" VerticalAlignment="Center" Visibility="Collapsed"
                                                 IsChecked="{Binding SetMode, Mode=TwoWay, Converter={StaticResource enumToBooleanConverter}, ConverterParameter=YUV}"/>

                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Visibility="{Binding SetMode, Converter={StaticResource setModeToVisibilityConverter}}">
                                    <Label Content="RAW Scale :" Margin="0,0,0,0" Width="100" Style="{StaticResource ParamLabelStyle}"/>
                                    <Label Content="Row :" Margin="5,0,0,0" Width="40" Style="{StaticResource ParamLabelStyle}"/>
                                    <ComboBox Width="70" Height="20" Margin="5,0,20,0" HorizontalAlignment="Left"
                                                  ItemsSource="{Binding RawScaleValues}"
                                                  SelectedIndex="{Binding SelectedRawScaleValue, Mode=TwoWay}"
                                                  ToolTip="RAW 行数据降采样，改变设备RAW数据行的输出模式"/>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsIcVerValid, Converter={StaticResource boolToVisibilityConverter}}">
                                        <Label Content="Column :" Width="60" Style="{StaticResource ParamLabelStyle}"/>
                                        <ComboBox Width="70" Height="20" Margin="3,0,0,0" HorizontalAlignment="Left"
                                                ItemsSource="{Binding RawScaleValues}"
                                                SelectedIndex="{Binding SelectedColRawScaleValue, Mode=TwoWay}"
                                                ToolTip="RAW 列数据降采样，改变设备RAW数据列的输出模式"/>
                                    </StackPanel>
                                    <Button x:Name="setscale" Content="应用" Width="80" Height="20" Margin="20,0,0,0"
                                            Command="{Binding SetRawScaleCommand}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Visibility="Collapsed" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="Flip Image :" Style="{StaticResource ParamLabelStyle}"/>
                                    <RadioButton Content="不翻转" GroupName="FlipMode" Margin="8,4,20,0" VerticalAlignment="Center" 
                                    IsChecked="{Binding FlipImage, Mode=TwoWay, Converter={StaticResource enumToBooleanConverter}, ConverterParameter=None}"/>
                                    <RadioButton Content="垂直翻转" GroupName="FlipMode" Margin="6,4,20,0" VerticalAlignment="Center" 
                                    IsChecked="{Binding FlipImage, Mode=TwoWay, Converter={StaticResource enumToBooleanConverter}, ConverterParameter=Horizontal}"
                                    IsEnabled="{Binding IsFlip}"/>
                                    <RadioButton Content="水平翻转" GroupName="FlipMode" Margin="4,4,20,0" VerticalAlignment="Center" 
                                    IsChecked="{Binding FlipImage, Mode=TwoWay, Converter={StaticResource enumToBooleanConverter}, ConverterParameter=Vertical}"
                                    IsEnabled="{Binding IsFlip}"/>
                                    <RadioButton Content="水平+垂直" GroupName="FlipMode" Margin="4,4,10,0" VerticalAlignment="Center"
                                    IsChecked="{Binding FlipImage, Mode=TwoWay, Converter={StaticResource enumToBooleanConverter}, ConverterParameter=Both}"
                                    IsEnabled="{Binding IsFlip}"/>
                                </StackPanel>

                                <!--<StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="IIC配置 :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Border Background="Transparent" BorderBrush="#FF0078D7" BorderThickness="0" CornerRadius="3" Padding="3">
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                                                <TextBlock Text="寄存器地址 (addr_num)" FontSize="10" Foreground="#666666" Margin="0,0,0,2"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox x:Name="TxtIICAddrNum" Style="{StaticResource ParamTextBoxStyle}" Width="60"
                                                         Text="{Binding IICAddrNum, Mode=TwoWay}" ToolTip="4位寄存器地址 (0x00-0x0F)"
                                                         PreviewTextInput="OnIICInputPreviewTextInput"/>                            
                                                    <TextBlock Text="(0-15)" FontSize="9" Foreground="#999999" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Orientation="Vertical" Margin="0,0,15,0">
                                                <TextBlock Text="数据 (data_num)" FontSize="10" Foreground="#666666" Margin="0,0,0,2"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox x:Name="TxtIICDataNum" Style="{StaticResource ParamTextBoxStyle}" Width="60"
                                                         Text="{Binding IICDataNum, Mode=TwoWay}" ToolTip="4位数据 (0x00-0x0F)"
                                                         PreviewTextInput="OnIICInputPreviewTextInput"/>
                                                    <TextBlock Text="(0-15)" FontSize="9" Foreground="#999999" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                                </StackPanel>
                                            </StackPanel>


                                            <StackPanel Orientation="Vertical">
