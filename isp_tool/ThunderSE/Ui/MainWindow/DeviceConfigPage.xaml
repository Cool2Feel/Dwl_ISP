                                    <Label Content="gma__num :" Margin="29,3,0,0" Style="{StaticResource SimpleUnderlinedParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding YGamma_Num_Target, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
				    	                    ToolTip="Gamma曲线索引(uint8)。值越大→图像越亮(整体提亮特别是暗部)&#x0a;高增益用低索引压制噪声，低增益用高索引获得更好动态范围"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="yLowRate :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="100" Click="OnClickShowYGammaLowRate">查看yLowRate</Button>
                                    <Label Content="yLowRate :" Margin="29,3,0,0" Style="{StaticResource SimpleUnderlinedParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding YLowRate_Target, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="暗部对比度(uint8)。值越大→对比度越高但暗部容易过暗(细节丢失)&#x0a;值越小→暗部更亮(细节好但可能发灰)"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="yHighRate :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="100" Click="OnClickShowYGammaHighRate">查看YHighRate</Button>
                                    <Label Content="yHighRate :" Margin="25,3,0,0" Style="{StaticResource SimpleUnderlinedParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding YHighRate_Target, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="亮部对比度(uint8)&#x0a;值越大→对比度越高但亮处容易过曝&#x0a;值越小→亮部更柔和(高光细节保留更好)"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="Rate :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="100" Click="OnClickShowYGammaRate">查看Rate</Button>
                                    <Label Content="Rate :" Margin="59,3,0,0" Style="{StaticResource SimpleUnderlinedParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding YGamma_Rate_Target, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="色彩对比度(uint8)&#x0a;值越大→色彩对比度越高但会引起偏色(特别在高增益噪声环境)"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="yLowLimit :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding YLowLimit, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="暗部输出限制(uint8)&#x0a;Gamma校正后的最小输出值(DN)。防止过暗，确保暗部可见性"/>
                                    <Label Content="yHighLimit :" Margin="0,0,0,0" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding YHighLimit, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="亮部输出限制 (uint8)&#x0a;Gamma校正后的最大输出值(DN)。防止过曝溢出，保留高光细节"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="fogPersent :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding FogPersent, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="全局对比度/去雾参数(uint8)&#x0a;值越大→对比度越高但易引起过曝和过暗。值越小→图像更平淡类似有雾效果"/>
                                    
                                    <Label Content="" Visibility="Hidden" Margin="6,0,0,0" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Visibility="Hidden" Style="{StaticResource ParamTextBoxStyle}" Text="{Binding FogPersent, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"></TextBox>

                                    <TextBlock Margin="20,0,0,5" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=IsMouseOver, Converter={StaticResource boolToVisibillityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <Hyperlink Command="{Binding Source={StaticResource SettingOutputCommand}}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=Name}">
                                            导出YGamma数据
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=IsMouseOver, Converter={StaticResource boolToVisibillityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Hyperlink Command="{Binding Source={StaticResource SettingDetailCommand} }" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=Name}">使用图示进行设置...</Hyperlink>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <!-- EE 模块 -->
                    <Border Style="{StaticResource FadeOutBorderStyle}"
                        Tag="{Binding CurrentNavigatingModule, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=MainWindow:DeviceConfigPage},
                            Converter={StaticResource playNavigateAnimationConverter}, ConverterParameter=DeviceConfig.Isp.IspModule.Ee}">
                        <Grid Name="EEGrid" Background="Transparent" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"></ColumnDefinition>
                                <ColumnDefinition Width="3*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Content="EE" Style="{StaticResource ModuleLabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding CommonConfig, Converter={StaticResource moduleEnableStatusConverter}, ConverterParameter=Ee}"
                                       Foreground="{Binding CommonConfig, Converter={StaticResource moduleEnableStatusColorConverter}, ConverterParameter=Ee}"
                                       FontSize="10" HorizontalAlignment="Center" Grid.Column="0" Margin="0,28,0,0"/>
                            
                            <StackPanel Orientation="Vertical" Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="ee__class :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Width="130" Text="{Binding ee_class, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                        ToolTip="EE工作模式/类别选择(uint8)&#x0a;决定了ee_sharp_slope 等参数的调节逻辑方向"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="ee__dn__slope :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="130" Click="OnClickShowEEDnslope">查看ee__dn__slope</Button>
                                    <Label Content="ee__dn__slope :" Margin="17,3,0,0" Style="{StaticResource SimpleUnderlinedParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding ee_dn_slope_Target, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="降噪倾向斜率(uint8)&#x0a;值越大→越偏向降噪(图像更平滑)。设计趋势: 随增益降低而递减(高增益强降噪，低增益弱/无降噪)"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="ee__sharp__slope :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="130" Click="OnClickShowEESharpSlope">查看ee__sharp__slope</Button>
                                    <Label Content="ee__sharp__slope :" Margin="0,3,0,0" Style="{StaticResource SimpleUnderlinedParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding ee_sharp_slope_Target, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="锐化斜率(uint8)&#x0a;当ee_class=1时值越大→锐化越强；当ee_class=0时值越小→锐化越强(反向关系)。高增益用低值避免噪声放大"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="ee__th__adp :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="130" Click="OnClickShowEEThAdp">查看ee__th__adp</Button>
                                    <Label Content="ee__th__adp :" Margin="29,3,0,0" Style="{StaticResource SimpleUnderlinedParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding ee_th_adp_Target, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="自适应阈值(uint8)&#x0a;边缘检测的灵敏度门限。值越大→越偏向降噪(只有更强边缘才被锐化，其余做降噪处理)。所有增益等级通常统一设置"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="ee__dn__th :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="130" Click="OnClickShowEEDnTh">查看ee__dn__th</Button>
                                    <Label Content="ee__dn__th :" Margin="36,3,0,0" Style="{StaticResource SimpleUnderlinedParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding ee_dn_th_Target, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="降噪阈值(uint8)&#x0a;触发降噪处理的最低条件。值越大→越偏向降噪(更多区域应用降噪算法)。与ee_th_adp配合控制降噪/锐化平衡"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="sharp__class :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="130" Click="OnClickShowEESharpClass">查看 sharp__class</Button>
                                    <Label Content="sharp__class :" Margin="23,3,0,0" Style="{StaticResource SimpleUnderlinedParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding sharp_class_Target, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="锐化等级(uint8)&#x0a;值越大→锐化越强。特点: 高增益时锐化强但降噪也强(平衡)；低增益时两者都弱(保持自然)"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="dn__class :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="130" Click="OnClickShowDnClass">查看 dn__class</Button>
                                    <Label Content="dn__class :" Margin="40,3,0,0" Style="{StaticResource SimpleUnderlinedParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding dn_class_Target, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="降噪等级(uint8)&#x0a;值越大→降噪越强(图像更平滑但细节模糊)。L7设为10强力降噪可能是特殊需求"/>

                                    <TextBlock Margin="20,0,0,5" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=IsMouseOver, Converter={StaticResource boolToVisibillityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <Hyperlink Command="{Binding Source={StaticResource SettingOutputCommand}}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=Name}">
                                            导出EE数据
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- CH 模块 -->
                    <Border Style="{StaticResource FadeOutBorderStyle}"
                        Tag="{Binding CurrentNavigatingModule, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=MainWindow:DeviceConfigPage},
                            Converter={StaticResource playNavigateAnimationConverter}, ConverterParameter=DeviceConfig.Isp.IspModule.Ch}">
                        <Grid Name="ChGrid" Background="Transparent" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"></ColumnDefinition>
                                <ColumnDefinition Width="3*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Content="CH" Style="{StaticResource ModuleLabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding CommonConfig, Converter={StaticResource moduleEnableStatusConverter}, ConverterParameter=Ch}"
                                       Foreground="{Binding CommonConfig, Converter={StaticResource moduleEnableStatusColorConverter}, ConverterParameter=Ch}"
                                       FontSize="10" HorizontalAlignment="Center" Grid.Column="0" Margin="0,28,0,0"/>
                            
                            <StackPanel Orientation="Vertical" Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="stage0__en :" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding stage0_en, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="Stage0使能: [enable, R, G, B] (0/1)&#x0a;RGB域基础色调处理: R=Red红色, G=Green绿色, B=Blue蓝色"/>
                                    <Label Content="stage1__en :" Width="80" Style="{StaticResource ParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding stage1_en, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="Stage1使能: [enable, C, M, Y] (0/1)&#x0a;CMY域高级色调处理: C=Cyan青色, M=Magenta洋红, Y=Yellow黄色"/>
                                    <Label Content="enhence :" Width="80" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="100" Click="OnClickShowChEnhence">查看 enhence</Button>
                                    <!--<Label Content="th1 :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Click="OnClickShowChTh1">查看 th1</Button>-->
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <!--<Label Content="th0 :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Click="OnClickShowChTh0">查看 th0</Button>-->
                                    <Label Content="rgb__rate :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="100" Click="OnClickShowChRRate">查看 rgb__rate</Button>
                                    <!--<Label Content="g__rate :" Width="80" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="100" Click="OnClickShowChGRate">查看 g__rate</Button>
                                    <Label Content="b__rate :" Width="80" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="100" Click="OnClickShowChBRate">查看 b__rate</Button>-->
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="sat :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="100" Click="OnClickShowChSat">查看 sat</Button>
                                    <Label Content="rate :" Width="80" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="100" Click="OnClickShowChRate">查看 rate</Button>
                                    <Label Content="rate :" Margin="42,3,0,0" Style="{StaticResource SimpleUnderlinedParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding Rate_Target, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="颜色增强目标值(uint8)&#x0a;r_rate/g_rate/b_rate越大→对应颜色增强越厉害。通常设计为中间饱和度区域增强较多，两端(极淡/极浓)保持克制以避免过度处理"/>

                                    <TextBlock Margin="20,0,0,5" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=IsMouseOver, Converter={StaticResource boolToVisibillityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <Hyperlink Command="{Binding Source={StaticResource SettingOutputCommand}}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=Name}">
                                            导出CH数据
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- SAJ 模块 -->
                    <Border Style="{StaticResource FadeOutBorderStyle}"
                        Tag="{Binding CurrentNavigatingModule, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=MainWindow:DeviceConfigPage},
                            Converter={StaticResource playNavigateAnimationConverter}, ConverterParameter=DeviceConfig.Isp.IspModule.Saj}">
                        <Grid Name="SajGrid" Background="Transparent" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"></ColumnDefinition>
                                <ColumnDefinition Width="3*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Label Content="SAJ" Style="{StaticResource ModuleLabelStyle}" Grid.Column="0"/>
                            <TextBlock Text="{Binding CommonConfig, Converter={StaticResource moduleEnableStatusConverter}, ConverterParameter=Saj}"
                                       Foreground="{Binding CommonConfig, Converter={StaticResource moduleEnableStatusColorConverter}, ConverterParameter=Saj}"
                                       FontSize="10" HorizontalAlignment="Center" Grid.Column="0" Margin="0,28,0,0"/>
                            
                            <StackPanel Orientation="Vertical" Grid.Column="1">
                                <StackPanel Orientation="Horizontal" Style="{StaticResource ParamRowStyle}">
                                    <Label Content="sat :" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="100" Click="OnClickShowSAJSat">查看sat</Button>
                                    <Label Content="sat__rate :" Width="80" Style="{StaticResource ParamLabelStyle}"/>
                                    <Button Style="{StaticResource ParamButtonStyle}" Width="100" Click="OnClickShowSAJSatRate">查看sat__rate</Button>
                                    <Label Content="sat__rate :" Margin="20,3,0,0" Style="{StaticResource SimpleUnderlinedParamLabelStyle}"/>
                                    <TextBox Style="{StaticResource ParamTextBoxStyle}" Text="{Binding SAJ_Rate_Target, Mode=TwoWay}" KeyDown="OnTextBoxKeyDown"
                                             ToolTip="全局饱和度目标值(uint8)&#x0a;值越大→饱和度越高(色彩更鲜艳)。设计特点: 饱和度随增益降低而递增(高增益保守避免色彩噪声，低增益激进最大化表现力)"/>

                                    <TextBlock Margin="20,0,0,5" Visibility="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=IsMouseOver, Converter={StaticResource boolToVisibillityConverter}}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <Hyperlink Command="{Binding Source={StaticResource SettingOutputCommand}}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Grid}, Path=Name}">
                                            导出SAJ数据
                                        </Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <MainWindow:UvcViewControl x:Name="UvcView" Width="420" Height="320" HorizontalAlignment="Right" VerticalAlignment="Top"
                                       Visibility="{Binding ShowUvcView, 
                RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl, AncestorLevel=1},
                Converter={StaticResource boolToVisibillityConverter}}"/>
        </Grid>
        
        <!-- ==================== 底部状态信息栏 ==================== -->
        <Border Grid.Row="2" Background="#FFE8E8E8" BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0" Padding="10,5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="💡 提示: " FontWeight="SemiBold" FontSize="11" 
                           Foreground="#333333" VerticalAlignment="Center"/>
                <TextBlock Text="按Enter键确认参数修改 | 使用图示设置功能可快速配置模块参数 | 在线模式下支持UVC实时预览" 
                           FontSize="10" Foreground="#666666" VerticalAlignment="Center"/>
                
                <Separator Margin="15,0" VerticalAlignment="Stretch"/>
                
                <TextBlock x:Name="TxtConfigInfo" Text="" FontSize="10" Foreground="#0078D7" 
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
