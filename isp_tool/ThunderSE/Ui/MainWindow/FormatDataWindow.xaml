<Window x:Class="ThunderSE.Ui.MainWindow.FormatDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ThunderSE.Ui.MainWindow"
        mc:Ignorable="d"
        Title="数据格式化显示" Height="450" Width="700" Background="#FFF5F5F5"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Loaded="OnLoaded">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"></Setter>
            <Setter Property="Padding" Value="22,0"></Setter>
            <Setter Property="Margin" Value="10,6"></Setter>
            <Setter Property="Background" Value="#FF0078D7"></Setter>
            <Setter Property="Foreground" Value="#FFFFFFFF"></Setter>
            <Setter Property="BorderBrush" Value="#FF0078D7"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="FontSize" Value="13"></Setter>
            <Setter Property="FontWeight" Value="SemiBold"></Setter>
            <Setter Property="Cursor" Value="Hand"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF005A9E"/>
                                <Setter Property="BorderBrush" Value="#FF005A9E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF004578"/>
                                <Setter Property="BorderBrush" Value="#FF004578"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"></Setter>
            <Setter Property="Padding" Value="22,0"></Setter>
            <Setter Property="Margin" Value="10,6"></Setter>
            <Setter Property="Background" Value="#FFFFFFFF"></Setter>
            <Setter Property="Foreground" Value="#FF333333"></Setter>
            <Setter Property="BorderBrush" Value="#FFDDDDDD"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="FontSize" Value="13"></Setter>
            <Setter Property="FontWeight" Value="SemiBold"></Setter>
            <Setter Property="Cursor" Value="Hand"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF5F5F5"/>
                                <Setter Property="BorderBrush" Value="#FF0078D7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFE8F4FD"/>
                                <Setter Property="BorderBrush" Value="#FF005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"></Setter>
            <Setter Property="Height" Value="32"></Setter>
            <Setter Property="Margin" Value="3,0,0,0"></Setter>
            <Setter Property="Background" Value="Transparent"></Setter>
            <Setter Property="BorderBrush" Value="Transparent"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="FontSize" Value="14"></Setter>
            <Setter Property="Cursor" Value="Hand"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="5,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFE8F4FD"/>
                                <Setter Property="BorderBrush" Value="#FF0078D7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFD0E8F9"/>
                                <Setter Property="BorderBrush" Value="#FF005A9E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="6,3"></Setter>
            <Setter Property="FontSize" Value="13"></Setter>
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei"></Setter>
            <Setter Property="Foreground" Value="#FF333333"></Setter>
            <Setter Property="Background" Value="#FFFFFFFF"></Setter>
            <Setter Property="BorderBrush" Value="#FFE0E0E0"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="AcceptsReturn" Value="True"></Setter>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"></Setter>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"></Setter>
            <Setter Property="TextWrapping" Value="NoWrap"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF0078D7"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#FF999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="3">
        <Grid.RowDefinitions>
            <!-- 第1行：顶部标题栏 -->
            <RowDefinition Height="Auto"></RowDefinition>

            <!-- 第2行：工具栏区域 -->
            <RowDefinition Height="Auto"></RowDefinition>

            <!-- 第3行：主内容区 - 数据显示 -->
            <RowDefinition Height="*"></RowDefinition>

            <!-- 第4行：底部状态与操作栏 -->
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- ==================== 第1行：顶部标题栏 ==================== -->
        <Border Grid.Row="0" Background="#FF0078D7" CornerRadius="6,6,0,0" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <!-- 左侧：标题和描述 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="📊 ISP数据格式化显示" FontSize="17" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " Foreground="#80FFFFFF" FontSize="14" VerticalAlignment="Center" Margin="5,0"/>
                    <TextBlock Name="TxtDescription" Text="C结构体格式数据预览" FontSize="12" Foreground="#DDFFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右侧：快速操作按钮 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButtonStyle}" Click="OnClickSelectAll" ToolTip="全选文本 (Ctrl+A)">
                        <TextBlock Text="📋" FontSize="15"/>
                    </Button>
                    <Button Style="{StaticResource ToolButtonStyle}" Click="OnClickCopyQuick" ToolTip="快速复制 (Ctrl+C)">
                        <TextBlock Text="📄" FontSize="15"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 第2行：工具栏 ==================== -->
        <Border Grid.Row="1" Background="#FFF9F9F9" BorderBrush="#FF0078D7" BorderThickness="0,0,0,1" Padding="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <!-- 左侧：信息提示 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💡 " FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="提示：" FontWeight="SemiBold" FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
                    <TextBlock Name="TxtInfoTip" Text="数据已格式化为C结构体格式，可直接用于代码中" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="3,0,0,0"/>
                </StackPanel>

                <!-- 中间：数据统计信息 -->
                <Border Grid.Column="1" Background="#FFF0F8FF" BorderBrush="#FF0078D7" BorderThickness="1" 
                        CornerRadius="3" Padding="3" Margin="10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📏" FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Name="TxtDataStats" Text="字符数: 0 | 行数: 0" FontSize="11" Foreground="#0078D7" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- 右侧：视图控制 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <CheckBox Name="ChkWordWrap" Content="自动换行" FontSize="11" Checked="OnWordWrapChecked" Unchecked="OnWordWrapUnchecked"
                              ToolTip="切换文本自动换行模式" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ComboBox Name="CboFontSize" Width="90" FontSize="11" SelectedIndex="1" SelectionChanged="OnFontSizeChanged"
                              ToolTip="选择字体大小" VerticalAlignment="Center">
                        <ComboBoxItem Content="小 (11px)"/>
                        <ComboBoxItem Content="默认 (13px)"/>
                        <ComboBoxItem Content="大 (15px)"/>
                        <ComboBoxItem Content="特大 (18px)"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 第3行：主内容区 - 数据显示 ==================== -->
        <Border Grid.Row="2" Background="#FFFFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="1,0,1,1" Padding="1">
            <Grid>
                <TextBox Name="contentBox" Style="{StaticResource DataTextBoxStyle}"
                         ToolTip="将ISP的数据格式化为C结构体格式 | 快捷键: Ctrl+A 全选 | Ctrl+C 复制"
                         TextChanged="OnTextChanged"/>

                <!-- 空状态提示（可选） -->
                <TextBlock Name="TxtEmptyHint" Text="暂无数据显示" 
                           FontSize="14" Foreground="#AAAAAA" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- ==================== 第4行：底部状态与操作栏 ==================== -->
        <Border Grid.Row="3" Background="#FFF8F9FA" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" CornerRadius="0,0,6,6" Padding="6,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <!-- 左侧：状态信息 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Name="StatusIcon" Text="●" FontSize="12" Foreground="#00C800" VerticalAlignment="Center"/>
                    <TextBlock Name="StatusText" Text="就绪" Foreground="#FF666666" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>

                    <TextBlock Text="  |  " Foreground="#FFCCCCCC" FontSize="11" Margin="8,0" VerticalAlignment="Center"/>

                    <TextBlock Text="⌨️ " FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="快捷键:" FontWeight="SemiBold" FontSize="10" Foreground="#888888" VerticalAlignment="Center"/>
                    <TextBlock Text=" Enter 确定" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="3,0,0,0"/>
                    <TextBlock Text=" | " Foreground="#FFCCCCCC" FontSize="10" Margin="4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Esc 取消" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                    <TextBlock Text=" | " Foreground="#FFCCCCCC" FontSize="10" Margin="4,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Ctrl+A/C" FontSize="10" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 右侧：操作按钮组 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="❌ 取消" Click="OnClickCancel" ToolTip="取消操作并关闭窗口 (Esc)"/>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="✓ 复制并关闭" Click="OnClickConfirm" ToolTip="复制数据到剪贴板并关闭窗口 (Enter)"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
