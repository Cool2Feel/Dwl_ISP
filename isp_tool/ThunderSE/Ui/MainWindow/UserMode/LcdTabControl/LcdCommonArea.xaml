<UserControl x:Class="ThunderSE.Ui.MainWindow.UserMode.LcdTabControl.LcdCommonArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:LcdTabControl="clr-namespace:ThunderSE.Ui.MainWindow.UserMode.LcdTabControl"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1000" Background="#FFE5E5E5">
    <GroupBox Header="屏幕属性">
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Label >
                    <TextBlock>型号 :</TextBlock>
                </Label>
                <TextBox Margin="0,0,0,0" DockPanel.Dock="Bottom" Height="20" Width="70"
                         Text="{Binding name, Mode=OneWay}" IsReadOnly="True"/>
                <Label Margin="10,0,0,0" >
                    <TextBlock>宽 :</TextBlock>
                </Label>
                <TextBox Margin="0,0,0,0" DockPanel.Dock="Bottom" Height="20" Width="50"
                         Text="{Binding screen_w, Mode=OneWay}" IsReadOnly="True"/>
                <Label Margin="10,0,0,0" >
                    <TextBlock>高 :</TextBlock>
                </Label>
                <TextBox Margin="0,0,0,0" DockPanel.Dock="Bottom" Height="20" Width="50"
                         Text="{Binding screen_h, Mode=OneWay}" IsReadOnly="True"/>
            </StackPanel>
        </StackPanel>
    </GroupBox>
</UserControl>
