<UserControl x:Class="ThunderSE.Ui.MainWindow.UserMode.LcdTabControl.LcdSajArea"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:LcdTabControl="clr-namespace:ThunderSE.Ui.MainWindow.UserMode.LcdTabControl"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:input="clr-namespace:System.Windows.Input;assembly=PresentationCore"
             xmlns:customControl="clr-namespace:ThunderSE.Ui.CommonCustomControl"
             xmlns:UserMode="clr-namespace:ThunderSE.Ui.MainWindow.UserMode"
             mc:Ignorable="d" 
             d:DesignHeight="1000" d:DesignWidth="1000" Background="#FFE5E5E5"
             DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <UserMode:DataArrayToControlCollectionConverter x:Key="SajConverter" />
    </UserControl.Resources>
    <GroupBox Header="饱和度">
        <StackPanel Orientation="Vertical">
            <StackPanel  Margin="0,10,0,0" Orientation="Horizontal" >
                <Label DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,0,20">强度 :</Label>
                <GroupBox Height="150">
                    <StackPanel Orientation="Horizontal">
                        <DockPanel LastChildFill="True">
                            <TextBox Margin="0,10,0,0" DockPanel.Dock="Bottom" Height="20" Width="30"
                                     input:InputMethod.IsInputMethodEnabled="False" 
                                     customControl:NumberOnlyBehaviour.IsEnabled="True" Style="{DynamicResource TextBoxStyle1}">
                                <TextBox.Resources>
                                    <customControl:BindingProxy x:Key="proxy" Data="{Binding}"/>
                                </TextBox.Resources>
                                <TextBox.Text>
                                    <Binding Path="de_saj" 
                                             Converter="{StaticResource SajConverter}" >
                                        <Binding.ConverterParameter>
                                            <sys:Int32>0</sys:Int32>
                                        </Binding.ConverterParameter>
                                        <Binding.ValidationRules>
                                            <customControl:NumberRange ValidatesOnTargetUpdated="True" >
                                                <customControl:NumberRange.Wrapper>
                                                    <customControl:Wrapper MinValue="0"
                                                                           MaxValue="{Binding Data.MaxSajValue, Source={StaticResource proxy}}"/>
                                                </customControl:NumberRange.Wrapper>
                                            </customControl:NumberRange>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Slider HorizontalAlignment="Center" Orientation="Vertical" Maximum="{Binding MaxSajValue}" SmallChange="1" IsSnapToTickEnabled="True">
                                <Slider.Value>
                                    <Binding Path="de_saj" 
                                             Converter="{StaticResource SajConverter}" >
                                        <Binding.ConverterParameter>
                                            <sys:Int32>0</sys:Int32>
                                        </Binding.ConverterParameter>
                                    </Binding>
                                </Slider.Value>
                            </Slider>
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="20,0,0,0">
                            <TextBox Margin="0,10,0,0" DockPanel.Dock="Bottom" Height="20" Width="30"
                                     input:InputMethod.IsInputMethodEnabled="False" 
                                     customControl:NumberOnlyBehaviour.IsEnabled="True" Style="{DynamicResource TextBoxStyle1}">
                                <TextBox.Resources>
                                    <customControl:BindingProxy x:Key="proxy" Data="{Binding}"/>
                                </TextBox.Resources>
                                <TextBox.Text>
                                    <Binding Path="de_saj" 
                                             Converter="{StaticResource SajConverter}" >
                                        <Binding.ConverterParameter>
                                            <sys:Int32>1</sys:Int32>
                                        </Binding.ConverterParameter>
                                        <Binding.ValidationRules>
                                            <customControl:NumberRange ValidatesOnTargetUpdated="True" >
                                                <customControl:NumberRange.Wrapper>
                                                    <customControl:Wrapper MinValue="0"
                                                                           MaxValue="{Binding Data.MaxSajValue, Source={StaticResource proxy}}"/>
                                                </customControl:NumberRange.Wrapper>
                                            </customControl:NumberRange>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Slider HorizontalAlignment="Center" Orientation="Vertical" Maximum="{Binding MaxSajValue}" SmallChange="1" IsSnapToTickEnabled="True">
                                <Slider.Value>
                                    <Binding Path="de_saj" 
                                             Converter="{StaticResource SajConverter}" >
                                        <Binding.ConverterParameter>
                                            <sys:Int32>1</sys:Int32>
                                        </Binding.ConverterParameter>
                                    </Binding>
                                </Slider.Value>
                            </Slider>
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="20,0,0,0">
                            <TextBox Margin="0,10,0,0" DockPanel.Dock="Bottom" Height="20" Width="30"
                                     input:InputMethod.IsInputMethodEnabled="False" 
                                     customControl:NumberOnlyBehaviour.IsEnabled="True" Style="{DynamicResource TextBoxStyle1}">
                                <TextBox.Resources>
                                    <customControl:BindingProxy x:Key="proxy" Data="{Binding}"/>
                                </TextBox.Resources>
                                <TextBox.Text>
                                    <Binding Path="de_saj" 
                                             Converter="{StaticResource SajConverter}" >
                                        <Binding.ConverterParameter>
                                            <sys:Int32>2</sys:Int32>
                                        </Binding.ConverterParameter>
                                        <Binding.ValidationRules>
                                            <customControl:NumberRange ValidatesOnTargetUpdated="True" >
                                                <customControl:NumberRange.Wrapper>
                                                    <customControl:Wrapper MinValue="0"
                                                                           MaxValue="{Binding Data.MaxSajValue, Source={StaticResource proxy}}"/>
                                                </customControl:NumberRange.Wrapper>
                                            </customControl:NumberRange>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Slider HorizontalAlignment="Center" Orientation="Vertical" Maximum="{Binding MaxSajValue}" SmallChange="1" IsSnapToTickEnabled="True">
                                <Slider.Value>
                                    <Binding Path="de_saj" 
                                             Converter="{StaticResource SajConverter}" >
                                        <Binding.ConverterParameter>
                                            <sys:Int32>2</sys:Int32>
                                        </Binding.ConverterParameter>
                                    </Binding>
                                </Slider.Value>
                            </Slider>
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="20,0,0,0">
                            <TextBox Margin="0,10,0,0" DockPanel.Dock="Bottom" Height="20" Width="30"
                                     input:InputMethod.IsInputMethodEnabled="False" 
                                     customControl:NumberOnlyBehaviour.IsEnabled="True" Style="{DynamicResource TextBoxStyle1}">
                                <TextBox.Resources>
                                    <customControl:BindingProxy x:Key="proxy" Data="{Binding}"/>
                                </TextBox.Resources>
                                <TextBox.Text>
                                    <Binding Path="de_saj" 
                                             Converter="{StaticResource SajConverter}" >
                                        <Binding.ConverterParameter>
                                            <sys:Int32>3</sys:Int32>
                                        </Binding.ConverterParameter>
                                        <Binding.ValidationRules>
                                            <customControl:NumberRange ValidatesOnTargetUpdated="True" >
                                                <customControl:NumberRange.Wrapper>
                                                    <customControl:Wrapper MinValue="0"
                                                                           MaxValue="{Binding Data.MaxSajValue, Source={StaticResource proxy}}"/>
                                                </customControl:NumberRange.Wrapper>
                                            </customControl:NumberRange>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Slider HorizontalAlignment="Center" Orientation="Vertical" Maximum="{Binding MaxSajValue}" SmallChange="1" IsSnapToTickEnabled="True">
                                <Slider.Value>
                                    <Binding Path="de_saj" 
                                             Converter="{StaticResource SajConverter}" >
                                        <Binding.ConverterParameter>
                                            <sys:Int32>3</sys:Int32>
                                        </Binding.ConverterParameter>
                                    </Binding>
                                </Slider.Value>
                            </Slider>
                        </DockPanel>
                        <DockPanel LastChildFill="True" Margin="20,0,0,0">
                            <TextBox Margin="0,10,0,0" DockPanel.Dock="Bottom" Height="20" Width="30"
                                     input:InputMethod.IsInputMethodEnabled="False" 
                                     customControl:NumberOnlyBehaviour.IsEnabled="True" Style="{DynamicResource TextBoxStyle1}">
                                <TextBox.Resources>
                                    <customControl:BindingProxy x:Key="proxy" Data="{Binding}"/>
                                </TextBox.Resources>
                                <TextBox.Text>
                                    <Binding Path="de_saj" 
                                             Converter="{StaticResource SajConverter}" >
                                        <Binding.ConverterParameter>
                                            <sys:Int32>4</sys:Int32>
                                        </Binding.ConverterParameter>
                                        <Binding.ValidationRules>
                                            <customControl:NumberRange ValidatesOnTargetUpdated="True" >
                                                <customControl:NumberRange.Wrapper>
                                                    <customControl:Wrapper MinValue="0"
                                                                           MaxValue="{Binding Data.MaxSajValue, Source={StaticResource proxy}}"/>
                                                </customControl:NumberRange.Wrapper>
                                            </customControl:NumberRange>
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>
                            <Slider HorizontalAlignment="Center" Orientation="Vertical" Maximum="{Binding MaxSajValue}" SmallChange="1" IsSnapToTickEnabled="True">
                                <Slider.Value>
                                    <Binding Path="de_saj" 
                                             Converter="{StaticResource SajConverter}" >
                                        <Binding.ConverterParameter>
                                            <sys:Int32>4</sys:Int32>
                                        </Binding.ConverterParameter>
                                    </Binding>
                                </Slider.Value>
                            </Slider>
                        </DockPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Label Margin="23,0,0,0">夜晚</Label>
                <Label>———————————————➤</Label>
                <Label>白天</Label>
            </StackPanel>
        </StackPanel>
    </GroupBox>
</UserControl>
