<Window x:Class="ThunderSE.Ui.MainWindow.UserMode.MainFrameForUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:userModeControls="clr-namespace:ThunderSE.Ui.MainWindow.UserMode"
        Title="IspTool" Height="720" Width="1280" Loaded="OnLoaded" Icon="pack://application:,,,/Icon.ico">
    <Window.DataContext>
        <userModeControls:MainFrameForUserViewModel></userModeControls:MainFrameForUserViewModel>
    </Window.DataContext>
    <DockPanel>
        <!-- 菜单栏 -->
        <Menu DockPanel.Dock="Top" >
            <MenuItem Header="文件" >
                <MenuItem Header="从文件读取" Click="OnOpenDeviceConfigFile"/>
                <MenuItem Header="保存到文件" Command="{Binding SaveConfigAsCommand}"/>
                <Separator/>
                <MenuItem Header="查看崩溃日志" Click="OnViewCrashLog"/>
                <MenuItem Header="退出" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="帮助" >
                <MenuItem Header="关于" Click="OnAbout"/>
            </MenuItem>
        </Menu>
        
        <Grid Background="#FFE5E5E5">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"></ColumnDefinition>
            <ColumnDefinition Width="2*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="40"></RowDefinition>
            </Grid.RowDefinitions>
            <TabControl Background="#FFE5E5E5">
                <TabItem Header="模组属性">
                    <userModeControls:CommonTab x:Name="CommonPage" ></userModeControls:CommonTab>
                </TabItem>
                <TabItem Header="整体效果">
                    <userModeControls:EffectTab x:Name="EffectPage" ></userModeControls:EffectTab>
                </TabItem>
                <TabItem Header="屏幕效果">
                    <userModeControls:LcdTab x:Name="LcdPage"></userModeControls:LcdTab>
                </TabItem>
            </TabControl>
            <StackPanel Grid.Row="1" Margin="0,5,0,5" Background="Transparent" Orientation="Horizontal">
                <Button Margin="20,0,0,0" Command="{Binding ReloadConfigCommand}">重新读取</Button>
                <Button Margin="10,0,0,0" Command="{Binding WriteConfigCommand}">写入</Button>
                <Button Margin="10,0,0,0" Click="OnOpenDeviceConfigFile">从文件读取</Button>
                <Button Margin="10,0,0,0" Command="{Binding SaveConfigAsCommand}">保存到文件</Button>
            </StackPanel>
        </Grid>
        <GroupBox Grid.Column="1" Header="UVC" >
            <Image  HorizontalAlignment="Stretch" Margin="5" Name="UvcImage" Stretch="Uniform" VerticalAlignment="Stretch"  />
        </GroupBox>
    </Grid>
    </DockPanel>
</Window>
