<Window x:Class="ThunderSE.Ui.MainWindow.MainFrameForDevelop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:MainWindow="clr-namespace:ThunderSE.Ui.MainWindow"
        xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
        xmlns:command="http://www.galasoft.ch/mvvmlight"
        Title="JT-USBCamera-ISPTool" Height="800" Width="1050" 
        Loaded="OnWindowLoaded" WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <MainWindow:MainFrameForDevelopViewModel />
    </Window.DataContext>
    <DockPanel>
        <!-- ==================== 顶部：菜单栏 ==================== -->
        <Menu DockPanel.Dock="Top" Background="#FF0078D7" Foreground="White" Padding="3" Visibility="Collapsed">
            <MenuItem Header="📁 文件" >
                <MenuItem Header="📂 打开配置..." Click="OnOpenDeviceConfigFile" ToolTip="打开ISP配置文件"/>
                <MenuItem Header="➕ 新建配置..." Click="OnCreateDeviceConfigFile" ToolTip="创建新的设备配置"/>
                <Separator/>
                <MenuItem Header="📋 查看崩溃日志" Click="OnViewCrashLog" ToolTip="查看应用程序崩溃日志"/>
                <Separator/>
                <MenuItem Header="❌ 退出" Click="OnExit" ToolTip="退出程序 (Alt+F4)"/>
            </MenuItem>
            <!--<MenuItem Header="⚙️ 工具" >
                <MenuItem Header="🔍 扫描在线设备" Click="{Binding}" ToolTip="扫描并检测在线USB摄像头设备"/>
            </MenuItem>-->
            <MenuItem Header="❓ 帮助" >
                <MenuItem Header="ℹ️ 关于" Click="OnAbout" ToolTip="查看版本信息和版权声明"/>
            </MenuItem>

            <!-- 右侧状态信息 -->
            <Separator/>
            <TextBlock x:Name="TxtMenuStatus" Text="● 就绪" 
                       VerticalAlignment="Center" Margin="15,0,0,0" FontWeight="SemiBold"/>
        </Menu>

        <!-- ==================== 中部：主内容区 ==================== -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="220" Width="220" />
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：导航面板 -->
            <Border Grid.Column="0" BorderBrush="#FF0078D7" BorderThickness="0,0,1,0" Background="#FFFAFAFA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 导航面板标题 -->
                    <Border Grid.Row="0" Background="#FF0078D7" Padding="8">
                        <StackPanel>
                            <TextBlock Text="🎛️ 设备配置管理" Foreground="White" 
                                       FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="Device Configuration Manager" Foreground="White" 
                                       FontSize="10" Opacity="0.8" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- TreeView主体 -->
                    <TreeView Name="DevConfigListTreeView" Grid.Row="1" 
                              ItemsSource="{Binding DeviceConfigs}"
                              SelectedItemChanged="OnSelectedDeviceConfigChange"
                              Background="Transparent" BorderThickness="0"
                              Padding="3"
                              ToolTip="选择要配置的设备或配置文件">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Style.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF0078D7"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFE8F4FD"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF0078D7"/>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFE8F4FD"/>
                                </Style.Resources>
                                <Setter Property="IsExpanded" Value="True"/>
                                <Setter Property="Foreground" Value="Black"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#FF0078D7"/>
                                        <Setter Property="Foreground" Value="#FFE8F4FD"/> 
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Value}" >
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="📁 " FontSize="12"/>
                                    <TextBlock Text="{Binding Key}" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <!-- 底部操作提示 -->
                    <Border Grid.Row="2" Background="#FFE8E8E8" Padding="4,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💡提示:" FontWeight="SemiBold" FontSize="11" 
                                       Foreground="#333333" Margin="0,0,3,0"/>
                            <TextBlock Text="点击左侧树形列表切换配置页面" 
                                       FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 可拖拽分割线 -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" 
                          ShowsPreview="True" Width="3" Background="#FF0078D7"/>

            <!-- 右侧：内容区域 -->
            <Border Grid.Column="2" Background="#FFF9F9F9" BorderBrush="#FFCCCCCC" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 内容显示主体 -->
                    <ContentControl Grid.Row="0" Background="Transparent" Margin="0"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Content="{Binding RelativeSource={
                                        RelativeSource Mode=FindAncestor, AncestorType=MainWindow:MainFrameForDevelop}, 
                                        Path=CurrentDevConfigPage}"/>

                    <!-- 底部信息栏 -->
                    <Border Grid.Row="1" Background="#FFFAFAFA" BorderBrush="#FF0078D7" Visibility="Collapsed" 
                            BorderThickness="0,1,0,0" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📍 当前页面: " FontWeight="SemiBold" FontSize="11" 
                                       Foreground="#333333" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtCurrentPageInfo" Text="未选择配置" 
                                       FontSize="11" Foreground="#0078D7" VerticalAlignment="Center"/>

                        <Separator Margin="15,0" VerticalAlignment="Stretch"/>

                        <TextBlock x:Name="TxtDeviceInfo" Text="" 
                                       FontSize="10" Foreground="#666666" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== 底部：状态栏 ==================== -->
        <StatusBar DockPanel.Dock="Bottom" Background="#FFF9F9F9" BorderBrush="#FFCCCCCC" Visibility="Collapsed" Foreground="White" Padding="3">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Text="就绪 - ThunderSE ISP调试工具已启动"/>
            </StatusBarItem>
            <Separator Foreground="White" Opacity="0.3"/>
            <StatusBarItem>
                <TextBlock x:Name="TxtWindowSize" Text=""/>
            </StatusBarItem>
            <Separator Foreground="White" Opacity="0.3"/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="💡 快捷键: Ctrl+O打开 | Ctrl+N新建 | F5扫描设备"/>
            </StatusBarItem>
        </StatusBar>
    </DockPanel>


