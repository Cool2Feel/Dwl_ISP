<UserControl x:Class="ThunderSE.Ui.MainWindow.UvcViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="500" Unloaded="OnUnloaded">
    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <!-- 第1行：顶部 - 视频预览区域 -->
            <RowDefinition Height="1.4*"/>
            <!-- 第2行：中部 - 操作工具栏 -->
            <RowDefinition Height="Auto"/>
            <!-- 第3行：底部 - 状态信息区 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ==================== 第1行：视频预览区域 ==================== -->
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 视频预览标题栏 -->
            <Border Grid.Row="0" Background="#FF0078D7" Padding="5,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📹 Camera实时预览" 
                               Foreground="White" FontWeight="Bold" FontSize="11"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtVideoStatus" Text="● 未连接" 
                               Foreground="#FFFF6B35" FontWeight="SemiBold" FontSize="10"
                               Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDeviceInfo" Text="" 
                               Foreground="White" FontSize="10"
                               Margin="15,0,0,0" VerticalAlignment="Center" Opacity="0.9"/>
                </StackPanel>
            </Border>

            <!-- 视频显示主体 -->
            <Border Grid.Row="1" Background="Black" Margin="1">
                <Grid>
                    <Image x:Name="UvcImage" 
                           HorizontalAlignment="Stretch" 
                           VerticalAlignment="Stretch"
                           Stretch="Uniform"/>
                    <!-- HGRM 画线覆盖-->
                    <Canvas x:Name="HgrmCanvas" 
                            HorizontalAlignment="Stretch" 
                            VerticalAlignment="Stretch"
                            IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- 视频状态提示栏 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Background="#FFE0E0E0">
                <TextBlock Text="💡 " VerticalAlignment="Center" FontSize="10"/>
                <TextBlock Text="支持RAW/JPEG/RGB格式 | 实时预览无延迟 | 拖拽边缘可调整大小" 
                           FontSize="10" Foreground="#666666" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 左侧拖拽手柄（保持原有功能） -->
        <Thumb Grid.Row="0" Grid.Column="0" Cursor="SizeWE" DragDelta="ThumbDragDelta" Background="#FF0078D7" Width="3"/>
        <Thumb Grid.Row="1" Grid.Column="0" Cursor="SizeWE" DragDelta="ThumbDragDelta" Background="#FF0078D7" Width="3"/>
        <Thumb Grid.Row="2" Grid.Column="0" Cursor="SizeNESW" DragDelta="ThumbDragDelta" Background="#FF0078D7" Height="3" Width="3"/>
        <Thumb Grid.Row="2" Grid.Column="1"  Cursor="SizeNS" DragDelta="ThumbDragDelta" Background="#FF0078D7" Height="3"/>
     
        <!-- ==================== 第2行：操作工具栏 ==================== -->
        <ToolBarPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,3,0,3" Background="#FFFAFAFA">
            <ToolBarTray>
                <ToolBar Background="Transparent" BorderThickness="0">
                    <Button x:Name="BtnCutRaw" Content="📷 截取Raw" 
                            Click="OnCutRawClick"
                            ToolTip="截取当前帧为RAW/JPEG图像 (Ctrl+R)" 
                            Padding="3" MinWidth="80" FontWeight="SemiBold"
                            Background="#FFF9F9F9" BorderBrush="#FFCCCCCC"/>
                    <Separator/>
                    <Button x:Name="BtnCutRgb" Content="🎨 截取RGB" 
                            Click="OnCutRgbClick"
                            ToolTip="截取当前帧为RGB格式文件 (Ctrl+G)" 
                            Padding="3" MinWidth="80" FontWeight="SemiBold"
                            Background="#FFF9F9F9" BorderBrush="#FFCCCCCC"/>
                    <Separator/>
                    <CheckBox Content="🔲 连续截取" x:Name="ChkContinuousRaw" IsChecked="False" Click="ChkContinuousRaw_Click"
                              ToolTip="点击启用连续截取图像模式" Padding="3" MinWidth="80"/>

                    <TextBox Text="1000" x:Name="TxtContinuousMax" Padding="3" Width="60" VerticalContentAlignment="Center"
                             ToolTip="连续截取图像的数量">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=ChkContinuousRaw, Path=IsChecked}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <Label Content="(张)" VerticalAlignment="Center" FontSize="11" Foreground="#666666"/>
                    
                    <!--<Button x:Name="BtnOpenFolder" Content="📂 打开目录" 
                            Click="OnOpenFolderClick"
                            ToolTip="打开截图保存的文件夹 (Ctrl+O)" 
                            Padding="8,3" MinWidth="100"
                            Background="#FFF9F9F9" BorderBrush="#FFCCCCCC"/>-->
                    <!--<TextBlock Text="" FontSize="10" Width="100" Foreground="Transparent" Margin="15,0,0,0"/>-->
                    <Separator/>

                    <!-- 状态指示器 -->
                    <TextBlock x:Name="TxtOperationStatus" Text="就绪" 
                               VerticalAlignment="Center" FontSize="10"
                               Foreground="#666666"/>

                    <!-- 帧率统计 -->
                    <TextBlock x:Name="TxtFrameRate" Text="FPS: --" 
                               VerticalAlignment="Center" Margin="0,0,0,0" FontSize="10"
                               Foreground="#0078D7" FontWeight="SemiBold"/>
                </ToolBar>
            </ToolBarTray>
        </ToolBarPanel>

        <!-- ==================== 第3行：底部状态信息区 ==================== -->
        <Border Grid.Row="2" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#FFE8E8E8" 
                BorderBrush="#FFCCCCCC" BorderThickness="0,1,0,0" Padding="5,3">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📍 UVC模块 - USB摄像头实时预览与采集" 
                           FontSize="10" Foreground="#333333" FontStyle="Italic"
                           VerticalAlignment="Center"/>
                <TextBlock Text=" | " VerticalAlignment="Center" 
                           Foreground="#CCCCCC" Margin="5,0"/>
                <TextBlock x:Name="TxtModuleStatus" Text="预览模式" 
                           FontSize="10" Foreground="#0078D7" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <Separator Margin="10,0" VerticalAlignment="Stretch"/>

                <TextBlock x:Name="TxtSizeInfo" Text="尺寸: --×--" 
                           FontSize="10" Foreground="#666666"
                           VerticalAlignment="Center" Margin="110,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>

