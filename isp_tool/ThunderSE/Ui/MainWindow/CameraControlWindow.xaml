<Window x:Class="ThunderSE.Ui.MainWindow.CameraControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ThunderSE.Ui.MainWindow"
        Title="相机控制 (Camera Control)" Width="420" Height="640"
        ResizeMode="CanResize" Background="#FFF5F5F5" Loaded="OnLoaded">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:CameraControlPanel Grid.Row="0" x:Name="CameraControlPanel"/>

        <!-- 底部操作栏：保存 / 恢复 -->
        <Border Grid.Row="1" Padding="0,10,0,0" BorderThickness="0,1,0,0" BorderBrush="#FFE0E0E0"
                Background="#FFF8F8F8" Margin="-10,0,-10,5">
            <StackPanel>
                <TextBlock x:Name="TxtActionStatus" Text="" FontSize="10" Foreground="#FF666666"
                           HorizontalAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="保存数据" Width="100" Height="30" Click="OnSaveClick"
                            FontSize="12" FontWeight="SemiBold"
                            Background="#FF0078D7" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            ToolTip="将当前相机控制参数设置保存到文件"/>
                    <Button Content="恢复数据" Width="100" Height="30" Margin="20,0,0,0" Click="OnLoadClick"
                            FontSize="12" FontWeight="SemiBold"
                            Background="#FFE8E8E8" Foreground="#FF333333"
                            BorderThickness="1" BorderBrush="#FFC0C0C0" Cursor="Hand"
                            ToolTip="从文件加载已保存的相机控制参数设置并应用到当前设备"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
