<UserControl x:Class="ThunderSE.Ui.MainWindow.CameraControlPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ThunderSE.Ui.MainWindow"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="300">

    <UserControl.Resources>
        <!-- 主题色（与软件整体 #0078D7 一致） -->
        <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D7"/>
        <SolidColorBrush x:Key="AccentLightBrush" Color="#FFEAF3FC"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#FFE4E4E4"/>

        <!-- 顶部蓝色标题栏 -->
        <Style x:Key="PanelHeaderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="CornerRadius" Value="5,5,0,0"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <!-- 标题栏内按钮（半透明白色，随悬停/按下反馈） -->
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#22FFFFFF"/>
            <Setter Property="BorderBrush" Value="#66FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#77FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 状态条 -->
        <Style x:Key="StatusStripStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFF7FAFD"/>
            <Setter Property="BorderBrush" Value="#FFDFE9F3"/>
            <Setter Property="BorderThickness" Value="1,0,1,1"/>
            <Setter Property="Padding" Value="9,5"/>
        </Style>

        <!-- 参数卡片 -->
        <Style x:Key="ParamCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 参数名 -->
        <Style x:Key="ParamNameStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 数值徽章（等宽字体、高亮底色） -->
        <Style x:Key="ValueBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
            <Setter Property="BorderBrush" Value="#FFB8D8F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="MinWidth" Value="44"/>
        </Style>

        <!-- 卡片内小按钮（默认） -->
        <Style x:Key="SmallButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="#FF0078D7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FFB8D8F5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFEAF3FC"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFB8D8F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 强调色滑块：已调区域蓝色 / 未调区域浅灰 / 白色圆点拖柄 -->
        <Style x:Key="AccentSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track" Height="20">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Background="Transparent">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border x:Name="FillBar" Background="{StaticResource AccentBrush}"
                                                            CornerRadius="2" Height="4" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="FillBar" Property="Background" Value="#FFB8D8F5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Background="Transparent">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border x:Name="TrackBar" Background="#FFD6D6D6"
                                                            CornerRadius="2" Height="4" VerticalAlignment="Center"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="TrackBar" Property="Background" Value="#FFEBEBEB"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False" Width="16" Height="16" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="ThumbOuter" Fill="{StaticResource AccentBrush}" Width="16" Height="16"/>
                                                    <Ellipse x:Name="ThumbInner" Fill="White" Width="10" Height="10"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbOuter" Property="Fill" Value="#FF106EBE"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="ThumbOuter" Property="Fill" Value="#FFC9C9C9"/>
                                                        <Setter TargetName="ThumbInner" Property="Fill" Value="#FFE8E8E8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏：图标 + 标题 + 重置全部 -->
        <Border Grid.Row="0" Style="{StaticResource PanelHeaderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎥" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="相机控制" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="↺ 重置全部默认" Style="{StaticResource HeaderButtonStyle}"
                        Click="OnResetAllClick" ToolTip="将所有相机控制参数恢复为设备默认值"/>
            </Grid>
        </Border>

        <!-- 状态条：指示灯 + 状态文本 -->
        <Border Grid.Row="1" Style="{StaticResource StatusStripStyle}">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#FF9A9A9A"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                    <Setter Property="Fill" Value="#FF2EA043"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter Property="Fill" Value="#FFC9A100"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock x:Name="TxtStatus" FontSize="10.5" Foreground="#FF666666"
                           TextWrapping="Wrap" Text="等待设备连接..."/>
            </StackPanel>
        </Border>

        <!-- 参数列表 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="2">
            <ItemsControl x:Name="Items" ItemsSource="{Binding Parameters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ParamCardStyle}">
                            <StackPanel>
                                <!-- 标题行：名称 + 自动 | 数值徽章 + 默认 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ParamNameStyle}"/>
                                        <CheckBox Content="自动" Margin="8,0,0,0" FontSize="10"
                                                  Foreground="#FF0078D7" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsAuto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Visibility="{Binding SupportsAuto, Converter={x:Static local:CameraControlPanel.BoolToVisibility}}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                                        <Border Style="{StaticResource ValueBadgeStyle}">
                                            <TextBlock Text="{Binding Value, Mode=OneWay}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="#FF005FB8" FontFamily="Consolas" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Button Content="默认" Style="{StaticResource SmallButtonStyle}" Margin="5,0,0,0"
                                                ToolTip="恢复为默认值" Click="OnResetClick"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 滑块 -->
                                <Slider Margin="0,6,0,1" Style="{StaticResource AccentSliderStyle}"
                                        Minimum="{Binding Min, Mode=OneTime}" Maximum="{Binding Max, Mode=OneTime}"
                                        TickFrequency="{Binding Step, Mode=OneTime}" IsSnapToTickEnabled="True"
                                        Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        IsEnabled="{Binding IsSliderEnabled}"
                                        Thumb.DragStarted="OnSliderDragStarted"
                                        Thumb.DragCompleted="OnSliderDragCompleted"
                                        ToolTip="{Binding DisplayName}"/>

                                <!-- 范围信息 -->
                                <TextBlock FontSize="9" Foreground="#FF9A9A9A">
                                    <Run Text="范围 "/>
                                    <Run Text="{Binding Min}"/>
                                    <Run Text=" ~ "/>
                                    <Run Text="{Binding Max}"/>
                                    <Run Text="   步长 "/>
                                    <Run Text="{Binding Step}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
