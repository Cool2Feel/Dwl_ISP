<Window x:Class="ThunderSE.Ui.MainWindow.IICConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converter="clr-namespace:ThunderSE.Ui.Converter"
        Title="IIC寄存器配置工具 - 批量编辑" Width="900" Height="650" ResizeMode="CanResize"
        Background="#FFF5F5F5" WindowStartupLocation="CenterScreen"
        Loaded="OnWindowLoaded" Closing="OnWindowClosing">
    <Window.Resources>
        <converter:HexConverter x:Key="HexConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Border Grid.Row="0" Background="#FF0078D7" CornerRadius="5,5,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔧 " FontSize="16"/>
                <TextBlock Text="IIC 寄存器批量配置工具" FontSize="16" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="  |  多寄存器地址与数据列表编辑" FontSize="12" Foreground="#FFB8D4E8"
                           VerticalAlignment="Bottom" Margin="10,0,0,2"/>
            </StackPanel>
        </Border>

        <!-- 配置选项区 -->
        <Border Grid.Row="1" Background="#FFF9F9F9" BorderBrush="#FFE0E0E0" BorderThickness="1" Padding="12,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <!-- 地址宽度模式 -->
                    <!--<TextBlock Text="📏 地址模式:" FontSize="11" FontWeight="SemiBold" Foreground="#FF8C00"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbAddrWidthMode" Width="150" SelectionChanged="OnAddrWidthModeSelectionChanged"
                              ToolTip="选择寄存器地址的宽度模式" FontSize="10"
                              SelectedValue="{Binding AddrWidthMode, Mode=TwoWay}">
                        <ComboBoxItem Content="🔹 单字节 (8位)" Tag="SingleByte"/>
                        <ComboBoxItem Content="🔸 双字节 (16位)" Tag="TwoByte" IsSelected="True"/>
                    </ComboBox>-->

                    <Separator Width="1" Margin="15,3,15,3" Background="#FFCCCCCC"/>

                    <!-- 位宽配置 -->
                    <TextBlock Text="⚙️ 地址位:" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <!--<ComboBox x:Name="CmbAddrBits" Width="60" SelectionChanged="OnAddrBitsSelectionChanged"
                              ToolTip="选择地址占用的位数" FontSize="10">
                        <ComboBoxItem Tag="8" Content="8位"/>
                        <ComboBoxItem Tag="9" Content="9位"/>
                        <ComboBoxItem Tag="10" Content="10位"/>
                        <ComboBoxItem Tag="11" Content="11位"/>
                        <ComboBoxItem Tag="12" Content="12位" IsSelected="True"/>
                        <ComboBoxItem Tag="13" Content="13位"/>
                        <ComboBoxItem Tag="14" Content="14位"/>
                        <ComboBoxItem Tag="15" Content="15位"/>
                        <ComboBoxItem Tag="16" Content="16位"/>
                    </ComboBox>-->
                    <Label Content="{Binding AddrWidthMode,Mode=OneWay}" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>

                    <TextBlock Text="数据位:" FontSize="10" VerticalAlignment="Center" Margin="15,0,5,0"/>
                    <!--<ComboBox x:Name="CmbDataBits" Width="60" SelectionChanged="OnDataBitsSelectionChanged"
                              ToolTip="选择数据占用的位数" FontSize="10">
                        <ComboBoxItem Tag="4" Content="4位"/>
                        <ComboBoxItem Tag="5" Content="5位"/>
                        <ComboBoxItem Tag="6" Content="6位"/>
                        <ComboBoxItem Tag="7" Content="7位"/>
                        <ComboBoxItem Tag="8" Content="8位" IsSelected="True"/>
                        <ComboBoxItem Tag="9" Content="9位"/>
                        <ComboBoxItem Tag="10" Content="10位"/>
                        <ComboBoxItem Tag="11" Content="11位"/>
                        <ComboBoxItem Tag="12" Content="12位"/>
                    </ComboBox>-->
                    <Label Content="{Binding DataWidthMode,Mode=OneWay}" FontSize="10" VerticalAlignment="Center" Margin="0,0,5,0"/>


                    <!-- 统计信息 -->
                    <Border Background="#FFE8F4FD" BorderBrush="#FF0078D7" BorderThickness="1" CornerRadius="2"
                            Padding="8,4" Margin="20,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📊 " FontSize="11"/>
                            <TextBlock FontSize="10" Foreground="#0078D7" FontWeight="SemiBold">
                                <Run Text="共 "/><Run Text="{Binding TotalRegisterCount,Mode=OneWay}" FontWeight="Bold"/><Run Text=" 个寄存器"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 模式描述 -->
                <TextBlock FontSize="9" Foreground="#666666" Margin="30,4,0,0"
                           Text="{Binding AddrModeDescription}"/>
            </StackPanel>
        </Border>

        <!-- 寄存器列表区域 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#FF0078D7" BorderThickness="2" 
                CornerRadius="3" Margin="0,8,0,8" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 列表标题和操作按钮 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="📋 寄存器配置列表" FontSize="13" FontWeight="Bold" Foreground="#0078D7"
                               VerticalAlignment="Center"/>

                    <Separator Width="1" Margin="12,2,12,2" Background="#FFCCCCCC"/>

                    <!-- 操作按钮组 -->
                    <Button x:Name="BtnAddRow" Content="➕ 添加行" Width="70" Height="26" FontSize="10"
                            Click="OnAddRowClick" Background="#FF4CAF50" Foreground="White"
                            Cursor="Hand" Margin="0,0,6,0" ToolTip="添加新的寄存器配置行"/>

                    <Button x:Name="BtnDeleteRow" Content="➖ 删除选中" Width="75" Height="26" FontSize="10"
                            Click="OnDeleteRowClick" Background="#FFF44336" Foreground="White"
                            Cursor="Hand" Margin="0,0,6,0" ToolTip="删除选中的寄存器行"/>

                    <Button x:Name="BtnClearAll" Content="🗑️ 清空全部" Width="75" Height="26" FontSize="10"
                            Click="OnClearAllClick" Background="#FFFF9800" Foreground="White"
                            Cursor="Hand" ToolTip="清空所有寄存器配置"/>

                    <Separator Width="1" Margin="12,2,12,2" Background="#FFCCCCCC"/>

                    <!-- 预设示例按钮 -->
                    <Button x:Name="BtnLoadExample" Content="📝 加载示例" Width="80" Height="26" FontSize="10"
                            Click="OnLoadExampleClick" Background="#FF9C27B0" Foreground="White"
                            Cursor="Hand" ToolTip="加载您提供的示例配置数据"/>

                    <Separator Width="1" Margin="12,2,12,2" Background="#FFCCCCCC"/>

                    <!-- 文件操作按钮 -->
                    <Button x:Name="BtnImportConfig" Content="📥 导入配置" Width="80" Height="26" FontSize="10"
                            Click="OnImportClick" Background="#FF2196F3" Foreground="White"
                            Cursor="Hand" ToolTip="从TXT/CSV文件批量导入寄存器配置"/>
                </StackPanel>

                <!-- DataGrid 数据表格 -->
                <DataGrid Grid.Row="1" x:Name="DgRegisterList"
                          ItemsSource="{Binding IICRegisterList}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          GridLinesVisibility="All"
                          VerticalGridLinesBrush="#FFE0E0E0"
                          HorizontalGridLinesBrush="#FFE0E0E0"
                          RowBackground="White"
                  AlternatingRowBackground="#FFF9F9F9"
                  HeadersVisibility="Column"
                  BorderBrush="#FFCCCCCC"
                  BorderThickness="1"
                  FontSize="11"
                  CellEditEnding="OnDataGridCellEditEnding"
                  CurrentCellChanged="OnDataGridCurrentCellChanged"
                  SelectedCellsChanged="OnDataGridSelectedCellsChanged"
                  PreviewMouseDown="OnDataGridPreviewMouseDown"
                  LostFocus="OnDataGridLostFocus">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FFDDEEFF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFF5F5F5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    
                    <DataGrid.Columns>
                        <!-- 序号列 -->
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="40"
                                            IsReadOnly="True" CanUserSort="False">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#FF666666"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 寄存器地址列 -->
                        <DataGridTextColumn Header="寄存器地址 (Hex)" Binding="{Binding Address, Converter={StaticResource HexConverter}}" Width="150*"
                                            MinWidth="120">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📍 " FontSize="11"/>
                                                    <TextBlock Text="寄存器地址" FontWeight="SemiBold" FontSize="11"/>
                                                    <TextBlock Text=" (0x00-0xFFFF)" FontSize="9" Foreground="#999999"
                                                               VerticalAlignment="Bottom" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="#FFE8F5E9"/>
                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="BorderBrush" Value="#FFC8E6C9"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="ToolTip" Value="支持1字节(0x00-0xFF)或2字节(0x0100-0xFFFF)地址\n≤0xFF: 打包为1字节地址\n>0xFF: 自动拆分为2字节(高+低)"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5,3"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="3"/>
                                    <EventSetter Event="PreviewTextInput" Handler="OnDataGridInputPreviewTextInput"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- 数据列 -->
                        <DataGridTextColumn Header="数据值 (Hex)" Binding="{Binding Data, Converter={StaticResource HexConverter}}" Width="150*"
                                            MinWidth="120">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💾 " FontSize="11"/>
                                                    <TextBlock Text="数据值" FontWeight="SemiBold" FontSize="11"/>
                                                    <TextBlock Text=" (0x00-0xFF)" FontSize="9" Foreground="#999999"
                                                               VerticalAlignment="Bottom" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="#FFE3F2FD"/>
                                    <Setter Property="Foreground" Value="#1565C0"/>
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="BorderBrush" Value="#FFBBDEFB"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5,3"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="Padding" Value="3"/>
                                    <EventSetter Event="PreviewTextInput" Handler="OnDataGridInputPreviewTextInput"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- 打包结果列（只读） -->
                        <DataGridTextColumn Header="打包结果 (字节流)" Binding="{Binding PackedHex}" Width="200*"
                                            MinWidth="180" IsReadOnly="True">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="ContentTemplate">
                                        <Setter.Value>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="✨ " FontSize="11"/>
                                                    <TextBlock Text="打包结果" FontWeight="SemiBold" FontSize="11"/>
                                                    <TextBlock Text=" (字节流)" FontSize="9" Foreground="#999999"
                                                               VerticalAlignment="Bottom" Margin="4,0,0,0"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Background" Value="#FFF3E5F5"/>
                                    <Setter Property="Foreground" Value="#7B1FA2"/>
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="BorderBrush" Value="#FFE1BEE7"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="ToolTip" Value="按字节拆分：地址(1-2字节) + 数据(1字节)"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="5,3"/>
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#800080"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- 操作列 -->
                        <DataGridTemplateColumn Header="操作" Width="200" IsReadOnly="True">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#FFFFF3E0"/>
                                    <Setter Property="Foreground" Value="#EF6C00"/>
                                    <Setter Property="Padding" Value="8,5"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="✓ 写入" Width="50" Height="24" FontSize="9"
                                            Click="OnApplyThisItemClick" Background="#FFE8F5E9"
                                            Foreground="#2E7D32" BorderBrush="#FFC8E6C9"
                                            Cursor="Hand" Tag="{Binding}"
                                            ToolTip="应用此寄存器配置" Margin="0,0,5,0"/>
                                        <Button Content="✓ 读取" Width="50" Height="24" FontSize="9"
                                            Click="OnReadThisItemClick" Background="#FFE3F2FD"
                                            Foreground="#1565C0" BorderBrush="#FF90CAF9"
                                            Cursor="Hand" Tag="{Binding}"
                                            ToolTip="读取此寄存器配置" Margin="0,0,10,0"/>
                                        <Button Content="❌ 删除" Width="50" Height="24" FontSize="9"
                                            Click="OnDeleteThisRowClick" Background="#FFFFEBEE"
                                            Foreground="#C62828" BorderBrush="#FFEF9A9A"
                                            Cursor="Hand" Tag="{Binding}"
                                            ToolTip="删除此行"/>                
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 配置摘要区 -->
        <Border Grid.Row="3" Background="#FFFEF7E0" BorderBrush="#FFFFA500" BorderThickness="1" 
                CornerRadius="3" Padding="10,6" Margin="0,0,0,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📝 当前配置摘要:" FontSize="11" FontWeight="SemiBold" Foreground="#FF8C00"
                               VerticalAlignment="Center"/>
                    <TextBlock FontSize="10" Foreground="#666666" Margin="10,0,0,0"
                               TextWrapping="Wrap" Text="{Binding AllRegistersSummary}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 底部按钮栏 -->
        <Border Grid.Row="4" Background="#FFF5F5F5" BorderBrush="#FFE0E0E0" BorderThickness="1,0,0,0"
                CornerRadius="0,0,5,5" Padding="15,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnApply" Content="✓ 应用配置" Width="100" Height="32" Margin="0,0,10,0"
                        Click="OnApplyClick" Background="#FF4CAF50" Foreground="White" FontWeight="SemiBold"
                        FontSize="12" Cursor="Hand" ToolTip="将当前配置应用到主窗口"/>
                <Button x:Name="BtnExport" Content="📤 导出配置" Width="100" Height="32" Margin="0,0,10,0"
                        Click="OnExportClick" Background="#FF2196F3" Foreground="White" FontWeight="SemiBold"
                        FontSize="12" Cursor="Hand" ToolTip="导出当前配置为文件"/>
                <Button x:Name="BtnClose" Content="✕ 关闭" Width="80" Height="32"
                        Click="OnCloseClick" Background="#FF757575" Foreground="White" FontWeight="SemiBold"
                        FontSize="12" Cursor="Hand" ToolTip="关闭此窗口"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>