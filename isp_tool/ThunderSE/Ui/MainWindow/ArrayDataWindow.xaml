<Window x:Class="ThunderSE.Ui.MainWindow.ArrayDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:MainWindow="clr-namespace:ThunderSE.Ui.MainWindow"
        Title="数组数据显示" Height="350" Width="600"
        Background="#FFE5E5E5" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"></Setter>
            <Setter Property="Padding" Value="20,0"></Setter>
            <Setter Property="Margin" Value="8,6"></Setter>
            <Setter Property="Background" Value="#FF0078D7"></Setter>
            <Setter Property="Foreground" Value="#FFFFFFFF"></Setter>
            <Setter Property="BorderBrush" Value="#FF0078D7"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="FontSize" Value="13"></Setter>
            <Setter Property="FontWeight" Value="SemiBold"></Setter>
            <Setter Property="Cursor" Value="Hand"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"></ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FF005A9E"></Setter>
                                <Setter Property="BorderBrush" Value="#FF005A9E"></Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FF004578"></Setter>
                                <Setter Property="BorderBrush" Value="#FF004578"></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32"></Setter>
            <Setter Property="Padding" Value="20,0"></Setter>
            <Setter Property="Margin" Value="8,6"></Setter>
            <Setter Property="Background" Value="#FFFFFFFF"></Setter>
            <Setter Property="Foreground" Value="#FF333333"></Setter>
            <Setter Property="BorderBrush" Value="#FFDDDDDD"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="FontSize" Value="13"></Setter>
            <Setter Property="FontWeight" Value="SemiBold"></Setter>
            <Setter Property="Cursor" Value="Hand"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"></ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF5F5F5"></Setter>
                                <Setter Property="BorderBrush" Value="#FF0078D7"></Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFE8F4FD"></Setter>
                                <Setter Property="BorderBrush" Value="#FF005A9E"></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DataTextBoxStyle" TargetType="TextBox">
            <Setter Property="Padding" Value="3"></Setter>
            <Setter Property="FontSize" Value="13"></Setter>
            <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei"></Setter>
            <Setter Property="Foreground" Value="#FF333333"></Setter>
            <Setter Property="Background" Value="#FFFFFFFF"></Setter>
            <Setter Property="BorderBrush" Value="#FFE0E0E0"></Setter>
            <Setter Property="BorderThickness" Value="1"></Setter>
            <Setter Property="AcceptsReturn" Value="True"></Setter>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"></Setter>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"></Setter>
            <Setter Property="TextWrapping" Value="NoWrap"></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                         Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#FF0078D7"></Setter>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#FF999999"></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="Auto"></RowDefinition>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FF0078D7" CornerRadius="6,6,0,0" Padding="3">
            <TextBlock Text="📊 数组数据编辑" FontSize="16" FontWeight="Bold" Foreground="#FFFFFFFF"></TextBlock>
        </Border>

        <Border Grid.Row="1" Background="#FFFFFFFF" BorderBrush="#FFE0E0E0" BorderThickness="1,0,1,1" Padding="3">
            <TextBox Name="contentBox" Style="{StaticResource DataTextBoxStyle}"
                     ToolTip="输入或编辑数组数据，每个数值以逗号分隔"></TextBox>
        </Border>

        <Border Grid.Row="2" Background="#FFF8F9FA" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" Padding="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💡 格式说明:" Foreground="#FF666666" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"></TextBlock>
                <TextBlock Text="每个数据以逗号为间隔" Foreground="#FF888888" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"></TextBlock>
                <TextBlock Text=" | " Foreground="#FFCCCCCC" Margin="12,0" VerticalAlignment="Center"></TextBlock>
                <TextBlock Name="DataInfoText" Text="等待加载数据..." Foreground="#FF888888" FontSize="11" VerticalAlignment="Center"></TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="#FFF8F9FA" BorderBrush="#FFE0E0E0" BorderThickness="0,1,0,0" CornerRadius="0,0,6,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Name="StatusText" Text="就绪" Foreground="#FF666666" FontSize="11" VerticalAlignment="Center"></TextBlock>
                    <TextBlock Text=" | " Foreground="#FFCCCCCC" Margin="8,0" VerticalAlignment="Center"></TextBlock>
                    <TextBlock Text="快捷键: Enter 确定 | Esc 取消" Foreground="#FFAAAAAA" FontSize="10" VerticalAlignment="Center"></TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="取消" Click="OnClickCancel" ToolTip="取消修改并关闭 (Esc)"></Button>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="✓ 确定" Click="OnClickConfirm" ToolTip="保存数据并关闭 (Enter)"></Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
