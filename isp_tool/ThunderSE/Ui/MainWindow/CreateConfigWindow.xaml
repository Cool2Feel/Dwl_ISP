<Window x:Class="ThunderSE.Ui.MainWindow.CreateConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CreateConfigWindow" Height="155" Width="320" Background="#FFE5E5E5"
        WindowStartupLocation="CenterScreen">
    <Grid FocusManager.FocusedElement="{Binding ElementName=contentBox}">
        <Label Content="请输入配置名称:" HorizontalAlignment="Left" Margin="20,10,0,0" VerticalAlignment="Top" />
        <TextBox Name="contentBox" HorizontalAlignment="Left" Height="24.76" Margin="25,40.24,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="260"
                 Text="{Binding ConfigName, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Window, AncestorLevel=1}}"/>
        <Button Content="确定" HorizontalAlignment="Left" Click="OnClickConfirm" Margin="55,86,0,0" VerticalAlignment="Top" Width="75"/>
        <Button Content="取消" Margin="183,86,55,0" Click="OnClickCancel" VerticalAlignment="Top"/>
    </Grid>
</Window>
