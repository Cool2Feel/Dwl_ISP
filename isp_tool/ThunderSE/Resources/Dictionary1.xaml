    <Style x:Key="ScatterDataPointStyle1" TargetType="{x:Type chartingToolkit:ScatterDataPoint}">
        <Setter Property="Background" Value="Orange"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="BorderBrush" Value="#FF686868"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type chartingToolkit:ScatterDataPoint}">
                    <Grid x:Name="Root">
                        <Grid.ToolTip>
                            <StackPanel Margin="2,2,2,2">
                                <ContentControl Content="{TemplateBinding IndependentValue}" ContentStringFormat="RGain : {0}"/>
                                <ContentControl Content="{TemplateBinding DependentValue}" ContentStringFormat="BGain : {0}"/>
                            </StackPanel>
                        </Grid.ToolTip>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition From="{x:Null}" GeneratedDuration="0:0:0.1" Storyboard="{x:Null}" To="{x:Null}"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames BeginTime="0" Duration="0:0:0.001" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="MouseOverHighlight">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0.3"/>
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition From="{x:Null}" GeneratedDuration="0:0:0.1" Storyboard="{x:Null}" To="{x:Null}"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unselected"/>
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames BeginTime="0" Duration="0:0:0.001" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="SelectionHighlight">
                                            <SplineDoubleKeyFrame KeyTime="0" Value="0.185"/>
                                        </DoubleAnimationUsingKeyFrames>
                                        <ColorAnimationUsingKeyFrames BeginTime="0" Duration="0:0:0.001" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="SelectionHighlight">
                                            <SplineColorKeyFrame KeyTime="0" Value="#FF8A8A8A"/>
                                        </ColorAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Path Data="F1M0,50L50,0 100,50 50,100 0,50z" Fill="{TemplateBinding Background}" Stretch="Fill" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" StrokeLineJoin="Round"/>
                        <Path x:Name="MouseOverHighlight" Data="F1M0,50L50,0 100,50 50,100 0,50z" Fill="White" Opacity="0" Stretch="Fill" Stroke="{x:Null}" StrokeThickness="1" StrokeLineJoin="Round"/>
                        <Path x:Name="SelectionHighlight" Data="F1M0,50L50,0 100,50 50,100 0,50z" Fill="#FF959595" Opacity="0" Stretch="Fill" Stroke="{x:Null}" StrokeThickness="1" StrokeLineJoin="Round"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

