    <EmbeddedResource Include="Resources\AX326X.elf" />
    <EmbeddedResource Include="Resources\AX327X.elf" />
    <EmbeddedResource Include="Resources\AX327X_.elf" />
    <EmbeddedResource Include="Resources\AXIDEsdspi.elf" />
    <EmbeddedResource Include="Resources\AXIDEspi.elf" />
    <EmbeddedResource Include="Resources\DeviceLib.ini" />
    <EmbeddedResource Include="Resources\ThunderBD.elf" />
    <EmbeddedResource Include="Resources\ThunderBDPlus.elf" />
    <!-- Loader 模式 SPI 驱动（ThunderSE.elf，取自 MPTool setting，Loader/0xCD 通道使用） -->
    <EmbeddedResource Include="Resources\ThunderSE.elf" />
    <!-- FlashLib.ini 器件表（RDID 匹配 → 容量/指令集；对齐 MPTool FlashLib.ini） -->
    <EmbeddedResource Include="Resources\FlashLib.ini" />
