<Window x:Class="ResBinManager.Views.TimeSyncWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ResBinManager.Converters"
        Title="设备时间同步" Height="580" Width="680"
        MinWidth="600" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================================================
             标题区域
             ============================================================ -->
        <Border Grid.Row="0" Background="{StaticResource HeaderGradientBrush}" Padding="20,14">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE973;" FontFamily="Segoe MDL2 Assets"
                           FontSize="26" Foreground="White"
                           Margin="0,0,14,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="设备时间同步" FontSize="18" FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="通过 USB MSC 协议将 PC 时间同步到设备 RTC"
                               FontSize="11" Foreground="{StaticResource PrimarySoftBrush}"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============================================================
             主内容区域
             ============================================================ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="20,16" Background="{StaticResource BackgroundBrush}">
            <StackPanel>

                <!-- Card 1: 设备状态 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="&#xE8FC;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="{StaticResource PrimaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="设备连接" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>

                        <!-- 连接状态指示 -->
                        <Border CornerRadius="{StaticResource MediumCornerRadius}" Padding="14,10"
                                Margin="0,0,0,14">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource ErrorSoftBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ConnectionStatus}" FontWeight="SemiBold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 设备信息网格 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="设备名称"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DeviceName}"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"
                                       FontWeight="Medium"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="设备路径"
                                       Style="{StaticResource CaptionTextStyle}" Margin="0,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DevicePath}"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"
                                       TextWrapping="Wrap" FontSize="11"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="通信协议"
                                       Style="{StaticResource CaptionTextStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="USB MSC (SCSI Pass-Through)"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 2: 时间信息 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="时间信息" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- PC 时间 -->
                            <Border Grid.Column="0" Grid.ColumnSpan="3" Background="{StaticResource PrimarySoftBrush}"
                                    CornerRadius="{StaticResource MediumCornerRadius}" Padding="12,10" Margin="20,0,20,0">
                                <StackPanel>
                                    <TextBlock Text="PC 时间" Foreground="{StaticResource PrimaryBrush}"
                                               FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding PcTimeDisplay}"
                                               Foreground="{StaticResource PrimaryDarkBrush}"
                                               FontSize="15" FontWeight="SemiBold"
                                               FontFamily="{StaticResource MonoFontFamily}"/>
                                </StackPanel>
                            </Border>

                            <!-- 设备时间 -->
                            <Border Grid.Column="1" Background="{StaticResource SuccessSoftBrush}" Visibility="Collapsed"
                                    CornerRadius="{StaticResource MediumCornerRadius}" Padding="12,10" Margin="3,0">
                                <StackPanel>
                                    <TextBlock Text="设备时间" Foreground="{StaticResource SuccessBrush}"
                                               FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding DeviceTimeDisplay}"
                                               Foreground="{StaticResource SuccessBrush}"
                                               FontSize="15" FontWeight="SemiBold"
                                               FontFamily="{StaticResource MonoFontFamily}"/>
                                </StackPanel>
                            </Border>

                            <!-- 时间差 -->
                            <Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}" Visibility="Collapsed"
                                    CornerRadius="{StaticResource MediumCornerRadius}" Padding="12,10" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="时间差" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding TimeDifferenceDisplay}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- 最后同步时间 -->
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="最后同步:" Foreground="{StaticResource TextTertiaryBrush}"
                                       FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LastSyncTime, TargetNullValue=--}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11" FontWeight="Medium" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 3: 操作控制 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="16" Foreground="{StaticResource WarningBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="操作控制" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>

                        <!-- 第一行按钮 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Command="{Binding ScanDeviceCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    IsEnabled="{Binding IsScanning, Converter={StaticResource InverseBoolConverter}}"
                                    Width="130">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="扫描设备" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ConnectDeviceCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding CanConnect}"
                                    Width="130" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FC;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="连接设备" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding DisconnectDeviceCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    IsEnabled="{Binding CanDisconnect}"
                                    Width="130" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FA;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="断开连接" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- 第二行按钮 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Command="{Binding SyncTimeCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="{Binding CanSyncTime}"
                                    Width="170" Height="38">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="同步时间" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ManualSetTimeCommand}"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    IsEnabled="{Binding CanSyncTime}"
                                    Width="140" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE709;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="手动时间戳" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <CheckBox Content="自动同步（每60秒）"
                                      IsChecked="{Binding AutoSyncEnabled}"
                                      VerticalContentAlignment="Center"
                                      Margin="16,0,0,0"
                                      Foreground="{StaticResource TextSecondaryBrush}"
                                      FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 4: 操作日志 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,4">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" Foreground="{StaticResource TextTertiaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="操作日志" Style="{StaticResource SectionTitleStyle}"/>
                        </StackPanel>

                        <TextBox Text="{Binding LogText}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="140"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource SurfaceAltBrush}"
                                 BorderBrush="{StaticResource BorderBrush2}"
                                 BorderThickness="1"
                                 FontFamily="{StaticResource MonoFontFamily}"
                                 FontSize="11"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 Padding="10,8"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ============================================================
             底部状态栏
             ============================================================ -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush2}"
                Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage, TargetNullValue=就绪}"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           VerticalAlignment="Center" FontSize="12"/>

                <Button Grid.Column="1" Style="{StaticResource ToolbarButtonStyle}"
                        Padding="16,6"
                        Click="CloseButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="关闭" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>