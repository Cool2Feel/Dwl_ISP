<Window x:Class="ResBinManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ResBinManager.ViewModels"
        xmlns:converters="clr-namespace:ResBinManager.Converters"
        Title="SDK Resource Manager"
        Height="800" Width="1280"
        MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="CenterTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <converters:PaletteColorToBrushConverter x:Key="PaletteColorToBrushConverter"/>
        <converters:ByteToBitmapConverter x:Key="ByteToBitmapConverter"/>

        <!-- 工具栏内文字图标样式 -->
        <Style x:Key="ToolbarIconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>

        <!-- 资源列表视图源（支持实时搜索过滤） -->
        <CollectionViewSource x:Key="ResourcesViewSource"
                              Source="{Binding Resources}"
                              Filter="ResourcesViewSource_Filter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============================= 顶部导航栏 ============================= -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1"
                Padding="0" Effect="{StaticResource CardShadowEffect}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 应用标题 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="18,10,10,10">
                    <Border Width="34" Height="34" CornerRadius="8"
                            Background="{StaticResource PrimaryGradientBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE7C3;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="18"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SDK Resource Manager"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="DestBin &amp; RES.BIN 资源管理器"
                                   FontSize="11"
                                   Foreground="{StaticResource TextTertiaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 顶部主操作按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,10,16,10">
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding OpenCommand}"
                            ToolTip="打开 RES.BIN 或 DestBin.bin 文件 (Ctrl+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" Style="{StaticResource ToolbarIconStyle}"/>
                            <TextBlock Text="打开" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding SaveCommand}"
                            ToolTip="保存修改的文件 (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource ToolbarIconStyle}"/>
                            <TextBlock Text="保存" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="24" Background="{StaticResource BorderBrush2}" Margin="6,0"/>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding LoadConfigCommand}"
                            ToolTip="从固件加载配置参数">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource ToolbarIconStyle}"/>
                            <TextBlock Text="加载配置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding GenerateFromSourceCommand}"
                            ToolTip="根据项目选中的资源文件生成配置文件">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource ToolbarIconStyle}"/>
                            <TextBlock Text="生成配置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="24" Background="{StaticResource BorderBrush2}" Margin="6,0"/>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ReplaceCommand}"
                            ToolTip="替换选中的资源文件">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" Style="{StaticResource ToolbarIconStyle}"/>
                            <TextBlock Text="替换" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="24" Background="{StaticResource BorderBrush2}" Margin="6,0"/>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ShowTimeSyncCommand}"
                            ToolTip="打开时间同步页面">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE823;" Style="{StaticResource ToolbarIconStyle}"/>
                            <TextBlock Text="时间同步" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="26" Background="{StaticResource BorderBrush2}" Margin="4,0"/>
                    <ToggleButton x:Name="ToggleBuildPanelBtn" Visibility="Collapsed"
                                  Style="{StaticResource ToolbarToggleButtonStyle}"
                                  Checked="ToggleBuildPanel_Checked"
                                  Unchecked="ToggleBuildPanel_Unchecked"
                                  ToolTip="切换固件打包配置面板">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" Style="{StaticResource ToolbarIconStyle}"/>
                            <TextBlock Text="固件打包" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Style="{StaticResource PrimaryButtonStyle}" Visibility="Collapsed"
                            Command="{Binding BuildFirmwareCommand}"
                            ToolTip="使用 MakeSPIBin.exe 构建固件"
                            Margin="4,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7B8;" Style="{StaticResource ToolbarIconStyle}" Foreground="White"/>
                            <TextBlock Text="构建固件" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================= 主内容区 ============================= -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 资源列表面板 -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}"
                    Effect="{StaticResource CardShadowEffect}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 面板标题 -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceAltBrush}"
                            CornerRadius="10,10,0,0" Padding="14,10"
                            BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="14" Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="资源列表" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border x:Name="ModifiedCountBadge" Grid.Column="1" Margin="8,0,0,0"
                                        Background="{StaticResource WarningSoftBrush}" CornerRadius="4"
                                        Padding="6,1" Visibility="Collapsed">
                                    <TextBlock x:Name="ModifiedCountText" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource WarningBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Resources.Count, StringFormat='共 {0} 项'}"
                                       Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 搜索栏 -->
                    <Border Grid.Row="1" Padding="12,2,12,2" Background="Transparent" Visibility="Collapsed">
                        <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6"
                                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                Padding="8,2,8,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" Foreground="{StaticResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="SearchBox" Grid.Column="1"
                                         TextChanged="SearchBox_TextChanged"
                                         Background="Transparent" BorderThickness="0"
                                         Padding="0,4" MinHeight="22" FontSize="12"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         CaretBrush="{StaticResource PrimaryBrush}"
                                         ToolTip="输入名称、ID 或类型进行过滤"/>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- 资源表 -->
                    <DataGrid Grid.Row="2"
                              x:Name="ResourceGrid"
                              ItemsSource="{Binding Source={StaticResource ResourcesViewSource}}"
                              SelectedItem="{Binding SelectedResource}"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              Margin="8,4,8,8">
                        <DataGrid.InputBindings>
                            <MouseBinding Gesture="LeftDoubleClick" Command="{Binding PreviewCommand}"/>
                        </DataGrid.InputBindings>

                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="预览" Command="{Binding PreviewCommand}" ToolTip="预览选中的资源文件"/>
                                <MenuItem Header="替换" Command="{Binding ReplaceCommand}" ToolTip="替换选中的资源文件"/>
                                <MenuItem Header="导出" Command="{Binding ExportCommand}" ToolTip="导出选中的资源文件"/>
                                <Separator/>
                                <MenuItem Header="恢复原始" Command="{Binding RevertCommand}" ToolTip="恢复为原始数据（替换后可用）"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>

                        <DataGrid.Columns>
                            <!-- ID 列 -->
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="48"
                                                FontFamily="{StaticResource MonoFontFamily}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 名称列（带工具提示） -->
                            <DataGridTemplateColumn Header="名称" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextAlignment="Center" HorizontalAlignment="Left"
                                                   FontSize="12.5">
                                            <TextBlock.ToolTip>
                                                <ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Id, StringFormat=ID: {0}}" 
                                                                   FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                                                        <TextBlock Text="{Binding OffsetDisplay, StringFormat=偏移: {0}}"
                                                                   FontSize="11" Foreground="{StaticResource TextTertiaryBrush}"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 类型列（彩色标签） -->
                            <DataGridTemplateColumn Header="类型" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="TypeBadge" CornerRadius="4" Padding="6,2"
                                                Margin="2,0" HorizontalAlignment="Center"
                                                Background="{StaticResource SurfaceAltBrush}">
                                            <TextBlock x:Name="TypeText" Text="{Binding Type}"
                                                       FontSize="11" FontWeight="Medium" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- 图片类 -->
                                            <DataTrigger Binding="{Binding Type}" Value="Jpeg">
                                                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" TargetName="TypeBadge"/>
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" TargetName="TypeText"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Bitmap">
                                                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" TargetName="TypeBadge"/>
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" TargetName="TypeText"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Png">
                                                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}" TargetName="TypeBadge"/>
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" TargetName="TypeText"/>
                                            </DataTrigger>
                                            <!-- 音频类 -->
                                            <DataTrigger Binding="{Binding Type}" Value="Wav">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" TargetName="TypeBadge"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" TargetName="TypeText"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Mp3">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" TargetName="TypeBadge"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" TargetName="TypeText"/>
                                            </DataTrigger>
                                            <!-- 字体 -->
                                            <DataTrigger Binding="{Binding Type}" Value="Font">
                                                <Setter Property="Background" Value="{StaticResource InfoSoftBrush}" TargetName="TypeBadge"/>
                                                <Setter Property="Foreground" Value="{StaticResource InfoBrush}" TargetName="TypeText"/>
                                            </DataTrigger>
                                            <!-- 文本 -->
                                            <DataTrigger Binding="{Binding Type}" Value="Text">
                                                <Setter Property="Background" Value="{StaticResource WarningSoftBrush}" TargetName="TypeBadge"/>
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" TargetName="TypeText"/>
                                            </DataTrigger>
                                            <!-- 显示类 -->
                                            <DataTrigger Binding="{Binding Type}" Value="Palette">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" TargetName="TypeBadge"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" TargetName="TypeText"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="OsdSource">
                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" TargetName="TypeBadge"/>
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" TargetName="TypeText"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- 偏移量列 -->
                            <DataGridTextColumn Header="偏移量" Binding="{Binding OffsetDisplay}" Width="110"
                                                FontFamily="{StaticResource MonoFontFamily}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 大小列 -->
                            <DataGridTextColumn Header="大小" Binding="{Binding SizeDisplay}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- 状态列（带图标指示器） -->
                            <DataGridTemplateColumn Header="状态" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    HorizontalAlignment="Center">
                                            <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                                     Fill="{StaticResource SuccessBrush}" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="StatusText" Text="{Binding StatusDisplay}"
                                                       FontSize="12" Foreground="{StaticResource SuccessBrush}"/>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsModified}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" TargetName="StatusDot"/>
                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" TargetName="StatusText"/>
                                                <Setter Property="FontWeight" Value="SemiBold" TargetName="StatusText"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <!-- 右侧面板 -->
            <TabControl x:Name="RightTabControl" Grid.Column="2" Margin="0,0,0,0">

                <!-- Tab 1: 预览和属性 -->
                <TabItem Header="预览 · 属性">
                    <GroupBox x:Name="PreviewPanel" Header="预览与属性" Style="{StaticResource PlainGroupBoxStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,3,0,0">

                                <!-- 图片预览卡 -->
                                <Border x:Name="ImagePreviewBorder" Style="{StaticResource CardStyle}"
                                        Height="200" Padding="5" Margin="0,0,0,3"
                                        Effect="{StaticResource CardShadowEffect}">
                                    <Grid>
                                        <Border Background="{StaticResource SurfaceAltBrush}"
                                                CornerRadius="8" Margin="3">
                                            <Image x:Name="PreviewImage" Stretch="Uniform"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 属性信息卡 -->
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,3">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                                       Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="属性信息" Style="{StaticResource HeaderTextStyle}"/>
                                        </StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="ID:" Grid.Row="0" Grid.Column="0" Margin="0,4"
                                                       Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="{Binding SelectedResource.Id}" Grid.Row="0"
                                                       Grid.Column="1" Margin="10,3" VerticalAlignment="Center"/>

                                            <TextBlock Text="名称:" Grid.Row="1" Grid.Column="0" Margin="0,4"
                                                       Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="{Binding SelectedResource.Name}" Grid.Row="1"
                                                       Grid.Column="1" Margin="10,3" VerticalAlignment="Center"/>

                                            <TextBlock Text="类型:" Grid.Row="2" Grid.Column="0" Margin="0,4"
                                                       Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="{Binding SelectedResource.Type}" Grid.Row="2"
                                                       Grid.Column="1" Margin="10,3" VerticalAlignment="Center"/>

                                            <TextBlock Text="偏移量:" Grid.Row="3" Grid.Column="0" Margin="0,4"
                                                       Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="{Binding SelectedResource.OffsetDisplay}" Grid.Row="3"
                                                       Grid.Column="1" Margin="10,3" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource MonoFontFamily}"/>

                                            <TextBlock Text="大小:" Grid.Row="4" Grid.Column="0" Margin="0,4"
                                                       Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="{Binding SelectedResource.SizeDisplay}" Grid.Row="4"
                                                       Grid.Column="1" Margin="10,3" VerticalAlignment="Center"/>

                                            <TextBlock Text="分辨率:" Grid.Row="5" Grid.Column="0" Margin="0,4"
                                                       Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="{Binding SelectedResource.ResolutionDisplay}" Grid.Row="5"
                                                       Grid.Column="1" Margin="10,3" VerticalAlignment="Center"/>

                                            <TextBlock Text="状态:" Grid.Row="6" Grid.Column="0" Margin="0,4"
                                                       Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock Text="{Binding SelectedResource.StatusDisplay}" Grid.Row="6"
                                                       Grid.Column="1" Margin="10,3" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 操作按钮 -->
                                <StackPanel x:Name="ActionButtonsPanel" Orientation="Horizontal"
                                            HorizontalAlignment="Center" Margin="0,0,0,3">
                                    <Button Content="导出" Style="{StaticResource BaseButtonStyle}"
                                            Command="{Binding ExportCommand}" Width="90" Margin="0,0,8,0"/>
                                    <Button Content="替换" Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding ReplaceCommand}" Width="90" Margin="0,0,8,0"/>
                                    <Button Content="恢复原始" Style="{StaticResource DangerButtonStyle}"
                                            Command="{Binding RevertCommand}" Width="90"
                                            ToolTip="恢复为原始数据（替换后可用）"/>
                                </StackPanel>

                                <!-- WAV 控制面板 -->
                                <StackPanel x:Name="WavControlPanel" Visibility="Collapsed" Margin="0,0,0,3">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <TextBlock Text="&#xED28;" FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="音频信息" Style="{StaticResource HeaderTextStyle}"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="时长:" Grid.Row="0" Grid.Column="0" Margin="0,4"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="{Binding WavInfo.DurationDisplay}" Grid.Row="0"
                                                           Grid.Column="1" Margin="10,4" FontWeight="SemiBold"/>

                                                <TextBlock Text="采样率:" Grid.Row="1" Grid.Column="0" Margin="0,4"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="{Binding WavInfo.SampleRateDisplay}" Grid.Row="1"
                                                           Grid.Column="1" Margin="10,4"/>

                                                <TextBlock Text="声道数:" Grid.Row="2" Grid.Column="0" Margin="0,4"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="{Binding WavInfo.ChannelsDisplay}" Grid.Row="2"
                                                           Grid.Column="1" Margin="10,4"/>

                                                <TextBlock Text="格式:" Grid.Row="3" Grid.Column="0" Margin="0,4"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="{Binding WavInfo.FormatDisplay}" Grid.Row="3"
                                                           Grid.Column="1" Margin="10,4"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
                                        <Button Content="播放" Style="{StaticResource AccentButtonStyle}"
                                                Command="{Binding PlayWavCommand}" Width="88" Margin="0,0,8,0"/>
                                        <Button Content="停止" Style="{StaticResource BaseButtonStyle}"
                                                Command="{Binding StopWavCommand}" Width="88"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="6,10,6,0">
                                        <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="音量:" Style="{StaticResource SectionTitleStyle}"
                                                   VerticalAlignment="Center" Margin="0,0,6,6"/>
                                        <Slider Width="130" Minimum="0" Maximum="100"
                                                Value="{Binding WavVolume}"
                                                TickFrequency="10" IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding WavVolume, StringFormat={}{0:F0}%}"
                                                   Width="40" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Font 预览面板 -->
                                <StackPanel x:Name="FontControlPanel" Visibility="Collapsed" Margin="0,0,0,3">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#xE943;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="字体预览" Style="{StaticResource HeaderTextStyle}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FontInfo.DisplayName}" FontWeight="SemiBold"
                                                       Margin="0,0,0,4"/>
                                            <TextBlock x:Name="FontStatsText" Visibility="Collapsed"
                                                       Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0"/>
                                            <TextBlock Text="点击字符查看详情" Style="{StaticResource CaptionTextStyle}"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="Collapsed">
                                        <ComboBox x:Name="LanguageComboBox"
                                                  ItemsSource="{Binding FontLanguages}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedIndex="{Binding SelectedFontLanguageIndex}"
                                                  Width="120" Margin="2"/>
                                        <TextBox x:Name="CharSearchBox" Visibility="Visible"
                                                 Width="120" Margin="2"
                                                 KeyUp="CharSearchBox_KeyUp" Tag="搜索字符..."
                                                 ToolTip="输入字符、0x4E00 或序号直接搜索"
                                                 GotFocus="CharSearchBox_GotFocus" LostFocus="CharSearchBox_LostFocus"/>
                                        <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                                            <ComboBox x:Name="CharRangeComboBox" Width="80" Margin="2"
                                                      SelectionChanged="CharRangeComboBox_SelectionChanged"/>
                                            <TextBlock x:Name="CurrentRangeText" Margin="6,2" FontSize="11"
                                                       VerticalAlignment="Center" Foreground="{StaticResource TextTertiaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <GroupBox Header="字符串列表" Style="{StaticResource PlainGroupBoxStyle}"
                                              Visibility="Collapsed">
                                        <ListBox x:Name="StringListBox" ItemsSource="{Binding FontStrings}"
                                                 DisplayMemberPath="DisplayText" Height="120" Margin="0"
                                                 SelectionChanged="StringListBox_SelectionChanged"/>
                                    </GroupBox>

                                    <GroupBox x:Name="CharDetailGroupBox" Header="字符详情"
                                              Style="{StaticResource PlainGroupBoxStyle}" Visibility="Collapsed">
                                        <Grid x:Name="CharDetailsGrid" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="索引:" Grid.Row="0" Grid.Column="0" Margin="3"
                                                       Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock x:Name="CharIndexText" Grid.Row="0" Grid.Column="1" Margin="3"/>
                                            <TextBlock Text="大小:" Grid.Row="1" Grid.Column="0" Margin="3"
                                                       Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock x:Name="CharSizeText" Grid.Row="1" Grid.Column="1" Margin="3"/>
                                            <TextBlock Text="偏移量:" Grid.Row="2" Grid.Column="0" Margin="3"
                                                       Style="{StaticResource SectionTitleStyle}"/>
                                            <TextBlock x:Name="CharOffsetText" Grid.Row="2" Grid.Column="1" Margin="3"
                                                       FontFamily="{StaticResource MonoFontFamily}"/>
                                            <TextBlock Text="字符索引序列:" Grid.Row="3" Grid.Column="0" Margin="3"
                                                       Style="{StaticResource SectionTitleStyle}" Visibility="Collapsed"/>
                                            <TextBlock x:Name="CharIndexSeqText" Grid.Row="3" Grid.Column="1" Margin="3"
                                                       TextWrapping="Wrap" FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11" Visibility="Collapsed"/>
                                            <TextBlock Text="字形尺寸:" Grid.Row="4" Grid.Column="0" Margin="3"
                                                       Style="{StaticResource SectionTitleStyle}" Visibility="Collapsed"/>
                                            <TextBlock x:Name="CharGlyphSizesText" Grid.Row="4" Grid.Column="1" Margin="3"
                                                       TextWrapping="Wrap" FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11" Visibility="Collapsed"/>
                                        </Grid>
                                    </GroupBox>

                                    <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                            CornerRadius="{StaticResource MediumCornerRadius}"
                                            Background="White" MinHeight="100" MaxHeight="240"
                                            Margin="0,6,0,6">
                                        <ContentControl x:Name="FontPreviewContainer"/>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,4">
                                        <Button Content="缩小" Click="ZoomOut_Click" Width="72" Margin="2" FontSize="11"/>
                                        <TextBlock Text="缩放:" VerticalAlignment="Center" Margin="6,0"/>
                                        <TextBlock x:Name="ZoomLevelText" Text="100%" Width="36"
                                                   VerticalAlignment="Center" TextAlignment="Center"/>
                                        <Button Content="放大" Click="ZoomIn_Click" Width="72" Margin="2" FontSize="11"/>
                                    </StackPanel>

                                    <CheckBox x:Name="ShowGridCheckBox" Content="显示网格线"
                                              IsChecked="True" Margin="10,8,0,0"
                                              Checked="ShowGrid_Checked" Unchecked="ShowGrid_Unchecked"/>

                                    <Button Content="替换字体" Command="{Binding ReplaceFontCommand}"
                                            Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Center" Margin="10,14,10,4"
                                            Padding="18,8" FontSize="13"/>
                                </StackPanel>

                                <!-- Palette 预览面板 -->
                                <StackPanel x:Name="PaletteControlPanel" Visibility="Collapsed" Margin="0,0,0,3">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="调色板预览" Style="{StaticResource HeaderTextStyle}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding PaletteInfo.DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding PaletteInfo.StatsDisplay}"
                                                       Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                            CornerRadius="{StaticResource MediumCornerRadius}"
                                            Background="White" Margin="0,0,0,8" Visibility="Collapsed">
                                        <ItemsControl x:Name="PaletteColorGrid" ItemsSource="{Binding PaletteInfo.AllColors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="16"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#EEEEEE" BorderThickness="0.5" Width="20" Height="20"
                                                            ToolTip="{Binding RawDataString}"
                                                            Background="{Binding ., Converter={StaticResource PaletteColorToBrushConverter}}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="统计信息" Style="{StaticResource HeaderTextStyle}"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="背景色:" Grid.Row="0" Grid.Column="0" Margin="0,4"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="1" Margin="10,4">
                                                    <Border Width="20" Height="20" BorderBrush="#000000" BorderThickness="1"
                                                            Margin="0,0,6,0"
                                                            Background="{Binding PaletteInfo.BackgroundColor, Converter={StaticResource PaletteColorToBrushConverter}}"/>
                                                    <TextBlock Text="{Binding PaletteInfo.BackgroundColor.RgbaString}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding PaletteInfo.BackgroundColor.Rgb565String}"
                                                           Grid.Row="1" Grid.Column="1" Margin="30,0,5,0"
                                                           FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>

                                                <TextBlock Text="透明色:" Grid.Row="2" Grid.Column="0" Margin="0,4"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Margin="10,4">
                                                    <Border Width="20" Height="20" BorderBrush="#000000" BorderThickness="1"
                                                            Margin="0,0,6,0"
                                                            Background="{Binding PaletteInfo.TransparentColor, Converter={StaticResource PaletteColorToBrushConverter}}"/>
                                                    <TextBlock Text="{Binding PaletteInfo.TransparentColor.RgbaString}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding PaletteInfo.TransparentColor.Alpha5BitString}"
                                                           Grid.Row="3" Grid.Column="1" Margin="30,0,5,0"
                                                           FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>

                                                <TextBlock Text="非零色:" Grid.Row="4" Grid.Column="0" Margin="0,4"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="{Binding PaletteInfo.NonZeroColors}" Grid.Row="4"
                                                           Grid.Column="1" Margin="10,4" FontWeight="SemiBold"/>

                                                <TextBlock Text="灰度色:" Grid.Row="5" Grid.Column="0" Margin="0,4"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="{Binding PaletteInfo.GrayscaleColors}" Grid.Row="5"
                                                           Grid.Column="1" Margin="10,4" FontWeight="SemiBold"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="自定义颜色 (0xF0-0xFF)" Style="{StaticResource HeaderTextStyle}"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding PaletteInfo.CustomColors}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" Margin="2"
                                                                    ToolTip="{Binding RawDataString}">
                                                            <Border Width="16" Height="16" BorderBrush="#000000" BorderThickness="1"
                                                                    Margin="0,0,3,0"
                                                                    Background="{Binding ., Converter={StaticResource PaletteColorToBrushConverter}}"/>
                                                            <TextBlock Text="{Binding DisplayString}" FontSize="10"
                                                                       VerticalAlignment="Center" Width="80"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- OSD 预览面板 -->
                                <StackPanel x:Name="OsdControlPanel" Visibility="Collapsed" Margin="0,0,0,3">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="OSD 源预览" Style="{StaticResource HeaderTextStyle}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding OsdInfo.DisplayName}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding OsdInfo.StatsDisplay}"
                                                       Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                            CornerRadius="{StaticResource MediumCornerRadius}"
                                            Background="White" MinHeight="100" MaxHeight="200" Margin="0,0,0,8">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding OsdInfo.Icons}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" Margin="5"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Vertical" Margin="3,3" Cursor="Hand" Width="70"
                                                                    ToolTip="{Binding TooltipDisplay}">
                                                            <Border CornerRadius="4" MouseLeftButtonDown="OsdIcon_Click">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
                                                                        <Setter Property="BorderThickness" Value="1"/>
                                                                        <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                                                <Setter Property="BorderThickness" Value="1.5"/>
                                                                                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <Image Width="56" Height="56"
                                                                       Source="{Binding IconData, Converter={StaticResource ByteToBitmapConverter}}"
                                                                       Stretch="Uniform" Margin="2"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontSize="9" Margin="1,2,1,0"
                                                                       TextWrapping="Wrap" HorizontalAlignment="Center"
                                                                       TextAlignment="Center" MaxHeight="24" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ResolutionDisplay}" FontSize="8" Margin="1,0"
                                                                       Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="选中图标详情" Style="{StaticResource HeaderTextStyle}"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="名称:" Grid.Row="0" Grid.Column="0" Margin="0,3"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="{Binding OsdInfo.SelectedIcon.Name}" Grid.Row="0"
                                                           Grid.Column="1" Margin="10,3" FontWeight="SemiBold"/>

                                                <TextBlock Text="索引:" Grid.Row="1" Grid.Column="0" Margin="0,3"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="{Binding OsdInfo.SelectedIcon.Index}" Grid.Row="1"
                                                           Grid.Column="1" Margin="10,3"/>

                                                <TextBlock Text="分辨率:" Grid.Row="2" Grid.Column="0" Margin="0,3"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="{Binding OsdInfo.SelectedIcon.ResolutionDisplay}" Grid.Row="2"
                                                           Grid.Column="1" Margin="10,3"/>

                                                <TextBlock Text="数据偏移:" Grid.Row="3" Grid.Column="0" Margin="0,3"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="{Binding OsdInfo.SelectedIcon.DataOffsetDisplay}" Grid.Row="3"
                                                           Grid.Column="1" Margin="10,3" FontFamily="{StaticResource MonoFontFamily}"/>

                                                <TextBlock Text="像素数:" Grid.Row="4" Grid.Column="0" Margin="0,3"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="{Binding OsdInfo.SelectedIcon.PixelCountDisplay}" Grid.Row="4"
                                                           Grid.Column="1" Margin="10,3" FontFamily="{StaticResource MonoFontFamily}"/>

                                                <Button Content="替换图标" Command="{Binding ReplaceOsdIconCommand}" Visibility="Collapsed"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                                        HorizontalAlignment="Center" Margin="3,8,3,2"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                        <Button Content="导出全部图标" Command="{Binding ExportOsdIconsCommand}"
                                                Style="{StaticResource BaseButtonStyle}" Width="140" Margin="3"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Text 预览面板 -->
                                <StackPanel x:Name="TextControlPanel" Visibility="Collapsed" Margin="0,0,0,3">
                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="文本内容编辑" Style="{StaticResource HeaderTextStyle}"/>
                                            </StackPanel>
                                            <TextBox Text="{Binding TextContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="{StaticResource MonoFontFamily}" FontSize="13" Height="60"
                                                     TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#333333"
                                                     AcceptsReturn="True" AcceptsTab="True" SpellCheck.IsEnabled="False"/>
                                            <Button Content="应用修改" Command="{Binding ApplyTextEditCommand}"
                                                    Style="{StaticResource AccentButtonStyle}" Width="120"
                                                    HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets"
                                                           Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                                                <TextBlock Text="文本统计" Style="{StaticResource HeaderTextStyle}"/>
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="字符数:" Grid.Row="0" Grid.Column="0" Margin="0,4"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="{Binding TextContent.Length}" Grid.Row="0"
                                                           Grid.Column="1" Margin="10,4" FontWeight="SemiBold"/>
                                                <TextBlock Text="编码:" Grid.Row="1" Grid.Column="0" Margin="0,4"
                                                           Style="{StaticResource SectionTitleStyle}"/>
                                                <TextBlock Text="UTF-8" Grid.Row="1" Grid.Column="1" Margin="10,4"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 使用说明 -->
                                <Border Background="{StaticResource InfoSoftBrush}"
                                        BorderBrush="{StaticResource InfoBrush}" BorderThickness="1"
                                        CornerRadius="{StaticResource MediumCornerRadius}"
                                        Padding="14" Margin="3,5,3,3">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"
                                                       Foreground="{StaticResource InfoBrush}" Margin="0,0,8,0"/>
                                            <TextBlock Text="快速指南" FontWeight="SemiBold"
                                                       Foreground="{StaticResource InfoBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="1. 点击「打开」加载固件文件" TextWrapping="Wrap" FontSize="11" Margin="0,2"/>
                                        <TextBlock Text="2. 从列表中选择一个资源" TextWrapping="Wrap" FontSize="11" Margin="0,2"/>
                                        <TextBlock Text="3. 点击「替换」更新资源" TextWrapping="Wrap" FontSize="11" Margin="0,2"/>
                                        <TextBlock Text="4. 点击「保存」保存修改" TextWrapping="Wrap" FontSize="11" Margin="0,2"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </GroupBox>
                </TabItem>

                <!-- Tab 2: 配置编辑 -->
                <TabItem Header="配置编辑">
                    <GroupBox Header="固件配置编辑器" Style="{StaticResource PlainGroupBoxStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Style="{StaticResource CardStyle}" Grid.Row="0" Margin="0,0,0,10">
                                <StackPanel>
                                    <!-- 项目类型选择 -->
                                    <Grid Margin="0,0,0,8" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="项目类型:" Grid.Column="0" Margin="0,2"
                                                   Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" Margin="5,2"
                                                  ItemsSource="{Binding AvailableProjectTypes}"
                                                  SelectedItem="{Binding SelectedProjectType}"
                                                  ToolTip="选择固件对应的项目类型，用于确定配置项映射"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- 方案选择 -->
                                    <Grid Margin="0,0,0,8" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="配置方案:" Grid.Column="0" Margin="0,2"
                                                   Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center"/>
                                        <ComboBox Grid.Column="1" Margin="5,2"
                                                  ItemsSource="{Binding ConfigTemplates}"
                                                  SelectedValue="{Binding SelectedConfigTemplate}"
                                                  SelectedValuePath="Key" DisplayMemberPath="Value.Name"
                                                  ToolTip="选择当前项目的配置方案"
                                                  SelectionChanged="ConfigTemplateComboBox_SelectionChanged"
                                                  VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="配置地址:" Grid.Row="0" Grid.Column="0" Margin="0,4"
                                                   Style="{StaticResource SectionTitleStyle}"/>
                                        <TextBlock Text="{Binding FirmwareConfigData.ConfigAddress, StringFormat=0x{0:X8}}"
                                                   Grid.Row="0" Grid.Column="1" Margin="10,4"
                                                   FontFamily="{StaticResource MonoFontFamily}"/>

                                        <TextBlock Text="配置状态:" Grid.Row="1" Grid.Column="0" Margin="0,4"
                                                   Style="{StaticResource SectionTitleStyle}"/>
                                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                                            <Border CornerRadius="4" Padding="8,3" Margin="10,0,0,0"
                                                    Background="{StaticResource SurfaceAltBrush}">
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="未加载"/>
                                                            <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding FirmwareConfigData.IsValid}" Value="True">
                                                                    <Setter Property="Text" Value="有效"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding FirmwareConfigData.IsValid}" Value="False">
                                                                    <Setter Property="Text" Value="无效"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <CheckBox Content="显示全部配置" FontSize="10" VerticalContentAlignment="Center"
                                                      IsChecked="{Binding ShowDisabledItems}" Margin="16,0,0,0"/>
                                        </StackPanel>

                                        <TextBlock Text="配置刷新:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,4"
                                                   Style="{StaticResource SectionTitleStyle}"/>
                                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="10,4">
                                            <Button Content="刷新" Command="{Binding RefreshConfigCommand}"
                                                    Style="{StaticResource BaseButtonStyle}" Height="32" FontSize="12"
                                                    Margin="0,0,8,0" ToolTip="刷新配置显示，同步界面修改到配置数据"/>
                                            <Button Content="加载 XML" Command="{Binding LoadXmlConfigCommand}"
                                                    Style="{StaticResource BaseButtonStyle}" Height="32" FontSize="12"
                                                    ToolTip="从XML配置文件加载配置数据"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="⚠ 配置已修改" Foreground="{StaticResource WarningBrush}" FontWeight="Bold"
                                               Visibility="{Binding IsConfigModified, Converter={StaticResource BoolToVisibilityConverter}}"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding ConfigItems}"
                                      IsReadOnly="False" Margin="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="名称" Binding="{Binding Name}"
                                                        Width="1.6*" CanUserSort="False" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterTextStyle}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.ShowDisabledItems, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False"/>
                                                            <Condition Binding="{Binding Enabled}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTextColumn Header="当前值" Binding="{Binding ValueDisplay}"
                                                        Width="90" CanUserSort="False" IsReadOnly="True">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterTextStyle}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.ShowDisabledItems, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False"/>
                                                            <Condition Binding="{Binding Enabled}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Foreground" Value="{StaticResource TextTertiaryBrush}"/>
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Header="新值" Width="*" MinWidth="80" CanUserSort="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Options}"
                                                          SelectedValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="Value" DisplayMemberPath="DisplayName"
                                                          SelectionChanged="ConfigComboBox_SelectionChanged"
                                                          MinWidth="70" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox">
                                                            <Setter Property="IsEnabled" Value="True"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding DataContext.ShowDisabledItems, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="False"/>
                                                                        <Condition Binding="{Binding Enabled}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </TabItem>
            </TabControl>

            <!-- 固件打包配置面板 -->
            <GroupBox Header="固件打包配置" Grid.Column="2" FontSize="12" FontWeight="Bold"
                      Visibility="Collapsed" x:Name="BuildConfigPanel" Panel.ZIndex="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,6,0,0">

                        <TextBlock Text="输入文件类型" Style="{StaticResource SectionTitleStyle}"/>
                        <RadioButton GroupName="InputTypeGroup" Content="ELF 文件（推荐用于调试）"
                                     IsChecked="{Binding BuildConfig.InputType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Elf}"
                                     Margin="0,0,0,6"/>
                        <RadioButton GroupName="InputTypeGroup" Content="BIN 文件（构建更快）"
                                     IsChecked="{Binding BuildConfig.InputType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Bin}"
                                     Margin="0,0,0,10"/>

                        <TextBlock Text="ELF 文件:" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BuildConfig.ElfPath}" Style="{StaticResource ReadOnlyTextBoxStyle}"
                                     VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="浏览" Command="{Binding SelectElfCommand}"
                                    Style="{StaticResource BaseButtonStyle}" Width="72"/>
                        </Grid>

                        <TextBlock Text="BIN 文件:" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BuildConfig.BinPath}" Style="{StaticResource ReadOnlyTextBoxStyle}"
                                     VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="浏览" Command="{Binding SelectBinCommand}"
                                    Style="{StaticResource BaseButtonStyle}" Width="72"/>
                        </Grid>

                        <TextBlock Text="RES.BIN 文件:" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBox Text="{Binding BuildConfig.ResBinPath}" Style="{StaticResource ReadOnlyTextBoxStyle}"
                                 VerticalContentAlignment="Center" Margin="0,0,0,3"/>
                        <TextBlock Text="（自动使用当前打开的文件）" FontStyle="Italic" FontSize="10"
                                   Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,8"/>

                        <TextBlock Text="MakeSPIBin.exe:" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BuildConfig.MakeSpiBinPath}" Style="{StaticResource ReadOnlyTextBoxStyle}"
                                     VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="浏览" Command="{Binding SelectMakeSpiBinCommand}"
                                    Style="{StaticResource BaseButtonStyle}" Width="72"/>
                        </Grid>

                        <TextBlock Text="输出目录:" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding BuildConfig.OutputPath}" Style="{StaticResource ReadOnlyTextBoxStyle}"
                                     VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="浏览" Command="{Binding SelectOutputPathCommand}"
                                    Style="{StaticResource BaseButtonStyle}" Width="72"/>
                        </Grid>

                        <CheckBox Content="自动备份原始文件" IsChecked="{Binding BuildConfig.AutoBackup}" Margin="0,8,0,4"/>
                        <CheckBox Content="构建后打开输出文件夹" IsChecked="{Binding BuildConfig.AutoOpenOutputFolder}" Margin="0,4,0,12"/>

                        <TextBlock Text="构建进度" Style="{StaticResource SectionTitleStyle}"/>
                        <ProgressBar Height="8" Minimum="0" Maximum="100"
                                     Value="{Binding BuildProgress}" Margin="0,0,0,12"/>

                        <TextBlock Text="构建日志" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBox Text="{Binding BuildLog}" IsReadOnly="True"
                                VerticalScrollBarVisibility="Auto"
                                Height="150" FontFamily="{StaticResource MonoFontFamily}" FontSize="11"
                                Style="{StaticResource ReadOnlyTextBoxStyle}"
                                Margin="0,0,0,12"/>

                        <Border Background="{StaticResource InfoSoftBrush}" BorderBrush="{StaticResource InfoBrush}"
                                BorderThickness="1" CornerRadius="{StaticResource MediumCornerRadius}" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource InfoBrush}" Margin="0,0,8,0"/>
                                    <TextBlock Text="固件打包信息" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}"/>
                                </StackPanel>
                                <TextBlock Text="此工具将执行以下操作：" TextWrapping="Wrap" FontSize="11" Margin="0,2"/>
                                <TextBlock Text="1. 将修改后的 RES.BIN 复制到输出目录" TextWrapping="Wrap" FontSize="11" Margin="10,2,0,2"/>
                                <TextBlock Text="2. 调用 MakeSPIBin.exe 与 ELF/BIN 合并" TextWrapping="Wrap" FontSize="11" Margin="10,2,0,2"/>
                                <TextBlock Text="3. 生成用于烧录的 DestBin.bin" TextWrapping="Wrap" FontSize="11" Margin="10,2,0,2"/>
                                <TextBlock Text="提示" FontWeight="SemiBold" Foreground="{StaticResource InfoBrush}" Margin="0,8,0,2"/>
                                <TextBlock Text="· 使用 BIN 文件构建更快（推荐）" TextWrapping="Wrap" FontSize="11" Margin="10,2,0,2"/>
                                <TextBlock Text="· 需要调试时使用 ELF 文件" TextWrapping="Wrap" FontSize="11" Margin="10,2,0,2"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <!-- ============================= 状态栏 ============================= -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="0">
            <StatusBar BorderThickness="0" Height="34">
                <StatusBar.Background>
                    <SolidColorBrush Color="{StaticResource SurfaceColor}"/>
                </StatusBar.Background>
                <StatusBar.Resources>
                    <Style TargetType="StatusBarItem">
                        <Setter Property="Padding" Value="8,0"/>
                    </Style>
                </StatusBar.Resources>
                <StatusBarItem>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="4,0,8,0"/>
                        <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StatusBarItem>
                <StatusBarItem HorizontalAlignment="Right">
                    <StackPanel Orientation="Horizontal">
                        <!-- 模式指示 -->
                        <Border Background="{Binding IsDestBinMode, Converter={StaticResource BoolToColorConverter}, ConverterParameter='Green|Blue'}"
                                CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                            <TextBlock Text="{Binding IsDestBinMode, Converter={StaticResource BoolToStringConverter}, ConverterParameter='DestBin|RES.BIN'}"
                                       FontWeight="SemiBold" Foreground="White" FontSize="11"/>
                        </Border>

                        <TextBlock Text="{Binding BuildTime, StringFormat='构建: {0}'}" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Margin="0,0,8,0"
                                   Visibility="{Binding IsDestBinMode, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Text="{Binding Resources.Count, StringFormat='共 {0} 项资源'}"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0"/>
                    </StackPanel>
                </StatusBarItem>
            </StatusBar>
        </Border>
    </Grid>
</Window>