<Window x:Class="FontBuilder.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FontBuilder — 字体构建工具" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 主内容区: 三栏 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- 左栏: 配置 -->
            <GroupBox Header="配置" Grid.Column="0" VerticalAlignment="Stretch">
                <StackPanel Orientation="Vertical">
                    <Label Content="font.ini 路径"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding FontIniPath}" IsReadOnly="True" Grid.Column="0" Margin="2"/>
                        <Button Content="..." Grid.Column="1" Command="{Binding BrowseIniCommand}" Margin="2"/>
                    </Grid>

                    <Label Content="fontSelect.txt"/>
                    <TextBox Text="{Binding FontSelectPath}" IsReadOnly="True" Margin="2"/>

                    <Label Content="输出目录"/>
                    <TextBox Text="{Binding OutputDirectory}" IsReadOnly="True" Margin="2"/>

                    <Separator Margin="0,10"/>

                    <Button Content="加载 font.ini" Command="{Binding LoadCommand}" Margin="2,4"/>

                    <Separator Margin="0,10"/>

                    <Label Content="构建统计"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="语言数:" Grid.Row="0" Grid.Column="0" Margin="2"/>
                        <TextBlock Text="{Binding LanguageCount}" Grid.Row="0" Grid.Column="1" Margin="2"/>
                        <TextBlock Text="字符串数:" Grid.Row="1" Grid.Column="0" Margin="2"/>
                        <TextBlock Text="{Binding StringCount}" Grid.Row="1" Grid.Column="1" Margin="2"/>
                        <TextBlock Text="字符数:" Grid.Row="2" Grid.Column="0" Margin="2"/>
                        <TextBlock Text="{Binding CharCount}" Grid.Row="2" Grid.Column="1" Margin="2"/>
                        <TextBlock Text="耗时:" Grid.Row="3" Grid.Column="0" Margin="2"/>
                        <TextBlock Text="{Binding ElapsedText}" Grid.Row="3" Grid.Column="1" Margin="2"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <!-- 中栏: 源文本编辑 -->
            <GroupBox Header="源文本" Grid.Column="1" VerticalAlignment="Stretch">
                <DataGrid ItemsSource="{Binding StringTable}"
                          AutoGenerateColumns="True"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="All"
                          AlternatingRowBackground="#F0F0F0"
                          FontSize="12"/>
            </GroupBox>

            <!-- 右栏: 预览 + 日志 -->
            <GroupBox Header="预览 / 日志" Grid.Column="2" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Vertical">
                        <Label Content="字符预览"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="索引:" VerticalAlignment="Center" Margin="2"/>
                            <TextBox Width="60" Text="{Binding PreviewCharIndex, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>
                        </StackPanel>
                        <TextBlock Text="{Binding PreviewCharInfo}" TextWrapping="Wrap" Margin="4"/>
                    </StackPanel>

                    <GroupBox Header="构建日志" Grid.Row="1" VerticalAlignment="Stretch">
                        <TextBox Text="{Binding LogText}" IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"
                                 TextWrapping="Wrap" VerticalAlignment="Stretch"/>
                    </GroupBox>
                </Grid>
            </GroupBox>
        </Grid>

        <!-- 底部: 进度条 + 构建按钮 -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="{Binding StatusMessage}" Margin="2"/>
                <ProgressBar Value="{Binding BuildProgress}" Maximum="100" Height="18" Margin="2"/>
                <TextBlock Text="{Binding ProgressStage}" Margin="2" FontSize="11" Foreground="Gray"/>
            </StackPanel>

            <Button Grid.Column="1" Content="取消" Command="{Binding CancelCommand}"
                    Width="80" Height="30" Margin="5"/>
            <Button Grid.Column="2" Content="构建" Command="{Binding BuildCommand}"
                    Width="100" Height="30" Margin="5" Background="#4CAF50" Foreground="White"/>
        </Grid>
    </Grid>
</Window>
